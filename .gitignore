# Private working notes
*.local.md

# Essay drafts: written here so the numbers sit beside the code that produces
# them, but not published from this repo.
docs/essay-*.md

# Agent run bundles are committed. They cannot be regenerated: the agent is
# nondeterministic, so `aedl run` produces different designs, and the numbers
# quoted in the README refer to these specific submissions. Keep the junk out.
runs/**/.DS_Store
runs/**/__pycache__/

# Derived from the bundles by `aedl report`. Left out because it reports each
# run's score as recorded at run time, which for the 2026-08-10 attempts
# predates the sidelobe-metric fix; see runs/README.md.
leaderboard.md

# Slop-linter virtualenv (scripts/slopcheck.sh installs it on demand)
scripts/.slopvenv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
