{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y2FrmqxVhYPbgNqRgwri9H","type":"tool_result","content":"1\t\"\"\"Core datamodels for OpenSatCom.\n2\t\n3\tFrozen dataclasses representing terminals, scenarios, link budget inputs/outputs,\n4\tRF chain parameters, and world simulation state. All fields use SI units internally;\n5\tdB-domain fields are explicitly named (e.g., ``eirp_dbw``, ``cn0_dbhz``).\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\tfrom dataclasses import dataclass\n11\tfrom typing import TYPE_CHECKING, Any\n12\t\n13\timport numpy as np\n14\t\n15\tif TYPE_CHECKING:\n16\t    from opensatcom.core.protocols import (\n17\t        AntennaModel,\n18\t        EnvironmentProvider,\n19\t        PropagationModel,\n20\t        TrajectoryProvider,\n21\t    )\n22\t\n23\t\n24\t@dataclass(frozen=True)\n25\tclass Terminal:\n26\t    \"\"\"Ground or space terminal.\n27\t\n28\t    Parameters\n29\t    ----------\n30\t    name : str\n31\t        Human-readable terminal identifier (e.g., ``\"GEO-Sat\"``).\n32\t    lat_deg : float\n33\t        Geodetic latitude in degrees (positive north).\n34\t    lon_deg : float\n35\t        Geodetic longitude in degrees (positive east).\n36\t    alt_m : float\n37\t        Altitude above mean sea level in metres. For GEO satellites\n38\t        use ``35_786_000.0``.\n39\t    system_noise_temp_k : float or None\n40\t        System noise temperature in Kelvin. Required for receive terminals.\n41\t    misc : dict or None\n42\t        Arbitrary metadata attached to the terminal.\n43\t    \"\"\"\n44\t\n45\t    name: str\n46\t    lat_deg: float\n47\t    lon_deg: float\n48\t    alt_m: float\n49\t    system_noise_temp_k: float | None = None\n50\t    misc: dict[str, Any] | None = None\n51\t\n52\t\n53\t@dataclass(frozen=True)\n54\tclass Scenario:\n55\t    \"\"\"Link scenario definition.\n56\t\n57\t    Parameters\n58\t    ----------\n59\t    name : str\n60\t        Scenario identifier (e.g., ``\"Ku-DL\"``).\n61\t    direction : str\n62\t        ``\"uplink\"`` or ``\"downlink\"``.\n63\t    freq_hz : float\n64\t        Carrier frequency in Hz.\n65\t    bandwidth_hz : float\n66\t        Allocated bandwidth in Hz.\n67\t    polarization : str\n68\t        Polarization type: ``\"RHCP\"``, ``\"LHCP\"``, ``\"H\"``, or ``\"V\"``.\n69\t    required_metric : str\n70\t        Performance metric to evaluate: ``\"ebn0_db\"``, ``\"cn0_dbhz\"``,\n71\t        or ``\"throughput_mbps\"``.\n72\t    required_value : float\n73\t        Minimum required value of the metric.\n74\t    misc : dict or None\n75\t        Arbitrary metadata.\n76\t    \"\"\"\n77\t\n78\t    name: str\n79\t    direction: str  # \"uplink\" or \"downlink\"\n80\t    freq_hz: float\n81\t    bandwidth_hz: float\n82\t    polarization: str  # \"RHCP\", \"LHCP\", \"H\", \"V\"\n83\t    required_metric: str  # \"ebn0_db\", \"cn0_dbhz\", \"throughput_mbps\"\n84\t    required_value: float\n85\t    rx_polarization: str | None = None\n86\t    misc: dict[str, Any] | None = None\n87\t\n88\t\n89\t@dataclass(frozen=True)\n90\tclass PropagationConditions:\n91\t    \"\"\"Environmental conditions affecting propagation.\n92\t\n93\t    Parameters\n94\t    ----------\n95\t    availability_target : float or None\n96\t        Link availability target as a fraction (e.g., ``0.999`` for 99.9 %).\n97\t    rain_rate_mm_per_hr : float or None\n98\t        Point rain rate exceeded at the availability target, in mm/h.\n99\t    climate_region : str or None\n100\t        ITU-R climate region letter (``\"A\"`` through ``\"Q\"``).\n101\t    misc : dict or None\n102\t        Arbitrary metadata.\n103\t    \"\"\"\n104\t\n105\t    availability_target: float | None = None\n106\t    rain_rate_mm_per_hr: float | None = None\n107\t    climate_region: str | None = None\n108\t    misc: dict[str, Any] | None = None\n109\t\n110\t\n111\t@dataclass(frozen=True)\n112\tclass ModCod:\n113\t    \"\"\"Modulation and coding scheme.\n114\t\n115\t    Parameters\n116\t    ----------\n117\t    name : str\n118\t        ModCod identifier (e.g., ``\"QPSK 1/2\"``).\n119\t    bits_per_symbol : float\n120\t        Bits per symbol for the modulation (e.g., 2.0 for QPSK).\n121\t    code_rate : float\n122\t        FEC code rate as a fraction (e.g., 0.5 for rate-1/2).\n123\t    rolloff : float\n124\t        Root-raised-cosine rolloff factor (default 0.2).\n125\t    pilot_overhead : float\n126\t        Pilot symbol overhead as a fraction (default 0.0).\n127\t    impl_margin_db : float\n128\t        Implementation margin in dB (default 0.0).\n129\t    \"\"\"\n130\t\n131\t    name: str\n132\t    bits_per_symbol: float\n133\t    code_rate: float\n134\t    rolloff: float = 0.2\n135\t    pilot_overhead: float = 0.0\n136\t    impl_margin_db: float = 0.0\n137\t\n138\t    def net_spectral_eff_bps_per_hz(self) -> float:\n139\t        \"\"\"Net spectral efficiency accounting for rolloff, pilots, and coding.\n140\t\n141\t        Returns\n142\t        -------\n143\t        float\n144\t            Spectral efficiency in bps/Hz.\n145\t        \"\"\"\n146\t        return (\n147\t            self.bits_per_symbol\n148\t            * self.code_rate\n149\t            * (1.0 - self.pilot_overhead)\n150\t            / (1.0 + self.rolloff)\n151\t        )\n152\t\n153\t\n154\t@dataclass(frozen=True)\n155\tclass StateECEF:\n156\t    \"\"\"Time-tagged satellite state in ECEF coordinates.\n157\t\n158\t    Parameters\n159\t    ----------\n160\t    t_s : float\n161\t        Epoch time in seconds since simulation start.\n162\t    r_m : numpy.ndarray\n163\t        Position vector in ECEF frame, shape ``(3,)``, in metres.\n164\t    v_mps : numpy.ndarray or None\n165\t        Velocity vector in ECEF frame, shape ``(3,)``, in m/s.\n166\t    \"\"\"\n167\t\n168\t    t_s: float\n169\t    r_m: np.ndarray  # shape (3,)\n170\t    v_mps: np.ndarray | None = None\n171\t\n172\t    def __eq__(self, other: object) -> bool:\n173\t        if not isinstance(other, StateECEF):\n174\t            return NotImplemented\n175\t        return (\n176\t            self.t_s == other.t_s\n177\t            and np.array_equal(self.r_m, other.r_m)\n178\t            and (\n179\t                (self.v_mps is None and other.v_mps is None)\n180\t                or (\n181\t                    self.v_mps is not None\n182\t                    and other.v_mps is not None\n183\t                    and np.array_equal(self.v_mps, other.v_mps)\n184\t                )\n185\t            )\n186\t        )\n187\t\n188\t    def __hash__(self) -> int:\n189\t        return hash((self.t_s, self.r_m.tobytes()))\n190\t\n191\t\n192\t@dataclass(frozen=True)\n193\tclass OpsPolicy:\n194\t    \"\"\"Operational policy constraints.\n195\t\n196\t    Parameters\n197\t    ----------\n198\t    min_elevation_deg : float\n199\t        Minimum elevation angle for link viability (default 10.0).\n200\t    max_scan_deg : float\n201\t        Maximum antenna scan angle from boresight (default 60.0).\n202\t    handover_hysteresis_s : float\n203\t        Minimum dwell time before handover in seconds (default 5.0).\n204\t    \"\"\"\n205\t\n206\t    min_elevation_deg: float = 10.0\n207\t    max_scan_deg: float = 60.0\n208\t    handover_hysteresis_s: float = 5.0\n209\t\n210\t\n211\t@dataclass(frozen=True)\n212\tclass LinkInputs:\n213\t    \"\"\"Inputs to a snapshot link budget evaluation.\n214\t\n215\t    Parameters\n216\t    ----------\n217\t    tx_terminal : Terminal\n218\t        Transmitting terminal (satellite for downlink).\n219\t    rx_terminal : Terminal\n220\t        Receiving terminal (ground station for downlink).\n221\t    scenario : Scenario\n222\t        Link scenario definition.\n223\t    tx_antenna : AntennaModel\n224\t        Transmit antenna model.\n225\t    rx_antenna : AntennaModel\n226\t        Receive antenna model.\n227\t    propagation : PropagationModel\n228\t        Propagation loss model (e.g., FSPL or composite).\n229\t    rf_chain : RFChainModel\n230\t        RF chain parameters.\n231\t    modem : ModemModel or None\n232\t        Optional modem model for throughput computation.\n233\t    \"\"\"\n234\t\n235\t    tx_terminal: Terminal\n236\t    rx_terminal: Terminal\n237\t    scenario: Scenario\n238\t    tx_antenna: AntennaModel\n239\t    rx_antenna: AntennaModel\n240\t    propagation: PropagationModel\n241\t    rf_chain: RFChainModel\n242\t    modem: Any | None = None  # ModemModel, optional to avoid circular import\n243\t\n244\t\n245\t@dataclass(frozen=True)\n246\tclass LinkOutputs:\n247\t    \"\"\"Outputs from a snapshot link budget evaluation.\n248\t\n249\t    Parameters\n250\t    ----------\n251\t    eirp_dbw : float\n252\t        Effective isotropic radiated power in dBW.\n253\t    gt_dbk : float\n254\t        Receive figure of merit (G/T) in dB/K.\n255\t    path_loss_db : float\n256\t        Total propagation path loss in dB.\n257\t    cn0_dbhz : float\n258\t        Carrier-to-noise-density ratio in dB-Hz.\n259\t    ebn0_db : float\n260\t        Energy-per-bit to noise-density ratio in dB.\n261\t    margin_db : float\n262\t        Link margin above the required threshold in dB.\n263\t    throughput_mbps : float or None\n264\t        Achievable throughput in Mbps (when modem is enabled).\n265\t    interference_dbw : float or None\n266\t        Total interference power in dBW (multi-beam scenarios).\n267\t    sinr_db : float or None\n268\t        Signal-to-interference-plus-noise ratio in dB.\n269\t    breakdown : dict or None\n270\t        Itemised link budget breakdown (keys are parameter names,\n271\t        values in dB or dBW).\n272\t    \"\"\"\n273\t\n274\t    eirp_dbw: float\n275\t    gt_dbk: float\n276\t    path_loss_db: float\n277\t    cn0_dbhz: float\n278\t    ebn0_db: float\n279\t    margin_db: float\n280\t    throughput_mbps: float | None = None\n281\t    interference_dbw: float | None = None\n282\t    sinr_db: float | None = None\n283\t    breakdown: dict[str, float] | None = None\n284\t\n285\t\n286\t@dataclass(frozen=True)\n287\tclass RFChainModel:\n288\t    \"\"\"RF chain parameters for TX and RX paths.\n289\t\n290\t    Parameters\n291\t    ----------\n292\t    tx_power_w : float\n293\t        Transmitter output power in watts.\n294\t    tx_losses_db : float\n295\t        Total transmit-side losses in dB (cables, filters, radome).\n296\t    rx_noise_temp_k : float\n297\t        Additional receive noise temperature contribution in Kelvin.\n298\t    misc : dict or None\n299\t        Arbitrary metadata.\n300\t    \"\"\"\n301\t\n302\t    tx_power_w: float\n303\t    tx_losses_db: float\n304\t    rx_noise_temp_k: float\n305\t    misc: dict[str, Any] | None = None\n306\t\n307\t    def effective_tx_power_w(self) -> float:\n308\t        \"\"\"TX power after losses, in watts.\n309\t\n310\t        Returns\n311\t        -------\n312\t        float\n313\t            Effective transmit power in watts.\n314\t        \"\"\"\n315\t        from opensatcom.core.units import db10_to_lin\n316\t\n317\t        return self.tx_power_w * db10_to_lin(-self.tx_losses_db)\n318\t\n319\t    def effective_tx_power_dbw(self) -> float:\n320\t        \"\"\"TX power after losses, in dBW.\n321\t\n322\t        Returns\n323\t        -------\n324\t        float\n325\t            Effective transmit power in dBW.\n326\t        \"\"\"\n327\t        from opensatcom.core.units import w_to_dbw\n328\t\n329\t        return w_to_dbw(self.tx_power_w) - self.tx_losses_db\n330\t\n331\t    def system_temp_k(self, base_temp_k: float) -> float:\n332\t        \"\"\"Total system noise temperature.\n333\t\n334\t        Parameters\n335\t        ----------\n336\t        base_temp_k : float\n337\t            Antenna noise temperature in Kelvin.\n338\t\n339\t        Returns\n340\t        -------\n341\t        float\n342\t            Combined system noise temperature in Kelvin.\n343\t        \"\"\"\n344\t        return base_temp_k + self.rx_noise_temp_k\n345\t\n346\t\n347\t@dataclass(frozen=True)\n348\tclass WorldSimInputs:\n349\t    \"\"\"Inputs to a world/mission simulation.\n350\t\n351\t    Parameters\n352\t    ----------\n353\t    link_inputs : LinkInputs\n354\t        Link budget configuration.\n355\t    sat_traj : TrajectoryProvider\n356\t        Satellite trajectory source.\n357\t    ops : OpsPolicy\n358\t        Operational policy constraints.\n359\t    env : EnvironmentProvider\n360\t        Time-varying propagation environment.\n361\t    t0_s : float\n362\t        Simulation start time in seconds.\n363\t    t1_s : float\n364\t        Simulation end time in seconds.\n365\t    dt_s : float\n366\t        Time step in seconds.\n367\t    \"\"\"\n368\t\n369\t    link_inputs: LinkInputs\n370\t    sat_traj: TrajectoryProvider\n371\t    ops: OpsPolicy\n372\t    env: EnvironmentProvider\n373\t    t0_s: float\n374\t    t1_s: float\n375\t    dt_s: float\n376\t\n377\t\n378\t@dataclass(frozen=True)\n379\tclass WorldSimOutputs:\n380\t    \"\"\"Outputs from a world/mission simulation.\n381\t\n382\t    Parameters\n383\t    ----------\n384\t    times_s : numpy.ndarray\n385\t        Time stamps in seconds, shape ``(N,)``.\n386\t    elev_deg : numpy.ndarray\n387\t        Elevation angles in degrees, shape ``(N,)``.\n388\t    range_m : numpy.ndarray\n389\t        Slant ranges in metres, shape ``(N,)``.\n390\t    margin_db : numpy.ndarray\n391\t        Link margin time series in dB, shape ``(N,)``.\n392\t    throughput_mbps : numpy.ndarray or None\n393\t        Throughput time series in Mbps (when modem is enabled).\n394\t    selected_modcod : list of str or None\n395\t        Selected ModCod name at each time step.\n396\t    outages_mask : numpy.ndarray\n397\t        Boolean mask where ``True`` indicates an outage, shape ``(N,)``.\n398\t    summary : dict\n399\t        Scalar summary metrics (e.g., ``availability``, ``margin_db_mean``).\n400\t    breakdown_timeseries : dict or None\n401\t        Per-parameter time series for detailed analysis.\n402\t    \"\"\"\n403\t\n404\t    times_s: np.ndarray\n405\t    elev_deg: np.ndarray\n406\t    range_m: np.ndarray\n407\t    margin_db: np.ndarray\n408\t    throughput_mbps: np.ndarray | None\n409\t    selected_modcod: list[str] | None\n410\t    outages_mask: np.ndarray\n411\t    summary: dict[str, float]\n412\t    breakdown_timeseries: dict[str, np.ndarray] | None = None\n413\t    az_deg: np.ndarray | None = None\n414\t    doppler_hz: np.ndarray | None = None\n415\t\n416\t    def __eq__(self, other: object) -> bool:\n417\t        if not isinstance(other, WorldSimOutputs):\n418\t            return NotImplemented\n419\t        return self.summary == other.summary\n420\t\n421\t    def __hash__(self) -> int:\n422\t        return hash(tuple(sorted(self.summary.items())))\n423\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"f0c5e749-9dad-4b53-ba0c-18a4ef1dce02","timestamp":"2026-08-12T07:16:45.769Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/.pyenv/versions/3.12.11/lib/python3.12/site-packages/opensatcom/core/models.py","content":"\"\"\"Core datamodels for OpenSatCom.\n\nFrozen dataclasses representing terminals, scenarios, link budget inputs/outputs,\nRF chain parameters, and world simulation state. All fields use SI units internally;\ndB-domain fields are explicitly named (e.g., ``eirp_dbw``, ``cn0_dbhz``).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any\n\nimport numpy as np\n\nif TYPE_CHECKING:\n    from opensatcom.core.protocols import (\n        AntennaModel,\n        EnvironmentProvider,\n        PropagationModel,\n        TrajectoryProvider,\n    )\n\n\n@dataclass(frozen=True)\nclass Terminal:\n    \"\"\"Ground or space terminal.\n\n    Parameters\n    ----------\n    name : str\n        Human-readable terminal identifier (e.g., ``\"GEO-Sat\"``).\n    lat_deg : float\n        Geodetic latitude in degrees (positive north).\n    lon_deg : float\n        Geodetic longitude in degrees (positive east).\n    alt_m : float\n        Altitude above mean sea level in metres. For GEO satellites\n        use ``35_786_000.0``.\n    system_noise_temp_k : float or None\n        System noise temperature in Kelvin. Required for receive terminals.\n    misc : dict or None\n        Arbitrary metadata attached to the terminal.\n    \"\"\"\n\n    name: str\n    lat_deg: float\n    lon_deg: float\n    alt_m: float\n    system_noise_temp_k: float | None = None\n    misc: dict[str, Any] | None = None\n\n\n@dataclass(frozen=True)\nclass Scenario:\n    \"\"\"Link scenario definition.\n\n    Parameters\n    ----------\n    name : str\n        Scenario identifier (e.g., ``\"Ku-DL\"``).\n    direction : str\n        ``\"uplink\"`` or ``\"downlink\"``.\n    freq_hz : float\n        Carrier frequency in Hz.\n    bandwidth_hz : float\n        Allocated bandwidth in Hz.\n    polarization : str\n        Polarization type: ``\"RHCP\"``, ``\"LHCP\"``, ``\"H\"``, or ``\"V\"``.\n    required_metric : str\n        Performance metric to evaluate: ``\"ebn0_db\"``, ``\"cn0_dbhz\"``,\n        or ``\"throughput_mbps\"``.\n    required_value : float\n        Minimum required value of the metric.\n    misc : dict or None\n        Arbitrary metadata.\n    \"\"\"\n\n    name: str\n    direction: str  # \"uplink\" or \"downlink\"\n    freq_hz: float\n    bandwidth_hz: float\n    polarization: str  # \"RHCP\", \"LHCP\", \"H\", \"V\"\n    required_metric: str  # \"ebn0_db\", \"cn0_dbhz\", \"throughput_mbps\"\n    required_value: float\n    rx_polarization: str | None = None\n    misc: dict[str, Any] | None = None\n\n\n@dataclass(frozen=True)\nclass PropagationConditions:\n    \"\"\"Environmental conditions affecting propagation.\n\n    Parameters\n    ----------\n    availability_target : float or None\n        Link availability target as a fraction (e.g., ``0.999`` for 99.9 %).\n    rain_rate_mm_per_hr : float or None\n        Point rain rate exceeded at the availability target, in mm/h.\n    climate_region : str or None\n        ITU-R climate region letter (``\"A\"`` through ``\"Q\"``).\n    misc : dict or None\n        Arbitrary metadata.\n    \"\"\"\n\n    availability_target: float | None = None\n    rain_rate_mm_per_hr: float | None = None\n    climate_region: str | None = None\n    misc: dict[str, Any] | None = None\n\n\n@dataclass(frozen=True)\nclass ModCod:\n    \"\"\"Modulation and coding scheme.\n\n    Parameters\n    ----------\n    name : str\n        ModCod identifier (e.g., ``\"QPSK 1/2\"``).\n    bits_per_symbol : float\n        Bits per symbol for the modulation (e.g., 2.0 for QPSK).\n    code_rate : float\n        FEC code rate as a fraction (e.g., 0.5 for rate-1/2).\n    rolloff : float\n        Root-raised-cosine rolloff factor (default 0.2).\n    pilot_overhead : float\n        Pilot symbol overhead as a fraction (default 0.0).\n    impl_margin_db : float\n        Implementation margin in dB (default 0.0).\n    \"\"\"\n\n    name: str\n    bits_per_symbol: float\n    code_rate: float\n    rolloff: float = 0.2\n    pilot_overhead: float = 0.0\n    impl_margin_db: float = 0.0\n\n    def net_spectral_eff_bps_per_hz(self) -> float:\n        \"\"\"Net spectral efficiency accounting for rolloff, pilots, and coding.\n\n        Returns\n        -------\n        float\n            Spectral efficiency in bps/Hz.\n        \"\"\"\n        return (\n            self.bits_per_symbol\n            * self.code_rate\n            * (1.0 - self.pilot_overhead)\n            / (1.0 + self.rolloff)\n        )\n\n\n@dataclass(frozen=True)\nclass StateECEF:\n    \"\"\"Time-tagged satellite state in ECEF coordinates.\n\n    Parameters\n    ----------\n    t_s : float\n        Epoch time in seconds since simulation start.\n    r_m : numpy.ndarray\n        Position vector in ECEF frame, shape ``(3,)``, in metres.\n    v_mps : numpy.ndarray or None\n        Velocity vector in ECEF frame, shape ``(3,)``, in m/s.\n    \"\"\"\n\n    t_s: float\n    r_m: np.ndarray  # shape (3,)\n    v_mps: np.ndarray | None = None\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, StateECEF):\n            return NotImplemented\n        return (\n            self.t_s == other.t_s\n            and np.array_equal(self.r_m, other.r_m)\n            and (\n                (self.v_mps is None and other.v_mps is None)\n                or (\n                    self.v_mps is not None\n                    and other.v_mps is not None\n                    and np.array_equal(self.v_mps, other.v_mps)\n                )\n            )\n        )\n\n    def __hash__(self) -> int:\n        return hash((self.t_s, self.r_m.tobytes()))\n\n\n@dataclass(frozen=True)\nclass OpsPolicy:\n    \"\"\"Operational policy constraints.\n\n    Parameters\n    ----------\n    min_elevation_deg : float\n        Minimum elevation angle for link viability (default 10.0).\n    max_scan_deg : float\n        Maximum antenna scan angle from boresight (default 60.0).\n    handover_hysteresis_s : float\n        Minimum dwell time before handover in seconds (default 5.0).\n    \"\"\"\n\n    min_elevation_deg: float = 10.0\n    max_scan_deg: float = 60.0\n    handover_hysteresis_s: float = 5.0\n\n\n@dataclass(frozen=True)\nclass LinkInputs:\n    \"\"\"Inputs to a snapshot link budget evaluation.\n\n    Parameters\n    ----------\n    tx_terminal : Terminal\n        Transmitting terminal (satellite for downlink).\n    rx_terminal : Terminal\n        Receiving terminal (ground station for downlink).\n    scenario : Scenario\n        Link scenario definition.\n    tx_antenna : AntennaModel\n        Transmit antenna model.\n    rx_antenna : AntennaModel\n        Receive antenna model.\n    propagation : PropagationModel\n        Propagation loss model (e.g., FSPL or composite).\n    rf_chain : RFChainModel\n        RF chain parameters.\n    modem : ModemModel or None\n        Optional modem model for throughput computation.\n    \"\"\"\n\n    tx_terminal: Terminal\n    rx_terminal: Terminal\n    scenario: Scenario\n    tx_antenna: AntennaModel\n    rx_antenna: AntennaModel\n    propagation: PropagationModel\n    rf_chain: RFChainModel\n    modem: Any | None = None  # ModemModel, optional to avoid circular import\n\n\n@dataclass(frozen=True)\nclass LinkOutputs:\n    \"\"\"Outputs from a snapshot link budget evaluation.\n\n    Parameters\n    ----------\n    eirp_dbw : float\n        Effective isotropic radiated power in dBW.\n    gt_dbk : float\n        Receive figure of merit (G/T) in dB/K.\n    path_loss_db : float\n        Total propagation path loss in dB.\n    cn0_dbhz : float\n        Carrier-to-noise-density ratio in dB-Hz.\n    ebn0_db : float\n        Energy-per-bit to noise-density ratio in dB.\n    margin_db : float\n        Link margin above the required threshold in dB.\n    throughput_mbps : float or None\n        Achievable throughput in Mbps (when modem is enabled).\n    interference_dbw : float or None\n        Total interference power in dBW (multi-beam scenarios).\n    sinr_db : float or None\n        Signal-to-interference-plus-noise ratio in dB.\n    breakdown : dict or None\n        Itemised link budget breakdown (keys are parameter names,\n        values in dB or dBW).\n    \"\"\"\n\n    eirp_dbw: float\n    gt_dbk: float\n    path_loss_db: float\n    cn0_dbhz: float\n    ebn0_db: float\n    margin_db: float\n    throughput_mbps: float | None = None\n    interference_dbw: float | None = None\n    sinr_db: float | None = None\n    breakdown: dict[str, float] | None = None\n\n\n@dataclass(frozen=True)\nclass RFChainModel:\n    \"\"\"RF chain parameters for TX and RX paths.\n\n    Parameters\n    ----------\n    tx_power_w : float\n        Transmitter output power in watts.\n    tx_losses_db : float\n        Total transmit-side losses in dB (cables, filters, radome).\n    rx_noise_temp_k : float\n        Additional receive noise temperature contribution in Kelvin.\n    misc : dict or None\n        Arbitrary metadata.\n    \"\"\"\n\n    tx_power_w: float\n    tx_losses_db: float\n    rx_noise_temp_k: float\n    misc: dict[str, Any] | None = None\n\n    def effective_tx_power_w(self) -> float:\n        \"\"\"TX power after losses, in watts.\n\n        Returns\n        -------\n        float\n            Effective transmit power in watts.\n        \"\"\"\n        from opensatcom.core.units import db10_to_lin\n\n        return self.tx_power_w * db10_to_lin(-self.tx_losses_db)\n\n    def effective_tx_power_dbw(self) -> float:\n        \"\"\"TX power after losses, in dBW.\n\n        Returns\n        -------\n        float\n            Effective transmit power in dBW.\n        \"\"\"\n        from opensatcom.core.units import w_to_dbw\n\n        return w_to_dbw(self.tx_power_w) - self.tx_losses_db\n\n    def system_temp_k(self, base_temp_k: float) -> float:\n        \"\"\"Total system noise temperature.\n\n        Parameters\n        ----------\n        base_temp_k : float\n            Antenna noise temperature in Kelvin.\n\n        Returns\n        -------\n        float\n            Combined system noise temperature in Kelvin.\n        \"\"\"\n        return base_temp_k + self.rx_noise_temp_k\n\n\n@dataclass(frozen=True)\nclass WorldSimInputs:\n    \"\"\"Inputs to a world/mission simulation.\n\n    Parameters\n    ----------\n    link_inputs : LinkInputs\n        Link budget configuration.\n    sat_traj : TrajectoryProvider\n        Satellite trajectory source.\n    ops : OpsPolicy\n        Operational policy constraints.\n    env : EnvironmentProvider\n        Time-varying propagation environment.\n    t0_s : float\n        Simulation start time in seconds.\n    t1_s : float\n        Simulation end time in seconds.\n    dt_s : float\n        Time step in seconds.\n    \"\"\"\n\n    link_inputs: LinkInputs\n    sat_traj: TrajectoryProvider\n    ops: OpsPolicy\n    env: EnvironmentProvider\n    t0_s: float\n    t1_s: float\n    dt_s: float\n\n\n@dataclass(frozen=True)\nclass WorldSimOutputs:\n    \"\"\"Outputs from a world/mission simulation.\n\n    Parameters\n    ----------\n    times_s : numpy.ndarray\n        Time stamps in seconds, shape ``(N,)``.\n    elev_deg : numpy.ndarray\n        Elevation angles in degrees, shape ``(N,)``.\n    range_m : numpy.ndarray\n        Slant ranges in metres, shape ``(N,)``.\n    margin_db : numpy.ndarray\n        Link margin time series in dB, shape ``(N,)``.\n    throughput_mbps : numpy.ndarray or None\n        Throughput time series in Mbps (when modem is enabled).\n    selected_modcod : list of str or None\n        Selected ModCod name at each time step.\n    outages_mask : numpy.ndarray\n        Boolean mask where ``True`` indicates an outage, shape ``(N,)``.\n    summary : dict\n        Scalar summary metrics (e.g., ``availability``, ``margin_db_mean``).\n    breakdown_timeseries : dict or None\n        Per-parameter time series for detailed analysis.\n    \"\"\"\n\n    times_s: np.ndarray\n    elev_deg: np.ndarray\n    range_m: np.ndarray\n    margin_db: np.ndarray\n    throughput_mbps: np.ndarray | None\n    selected_modcod: list[str] | None\n    outages_mask: np.ndarray\n    summary: dict[str, float]\n    breakdown_timeseries: dict[str, np.ndarray] | None = None\n    az_deg: np.ndarray | None = None\n    doppler_hz: np.ndarray | None = None\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, WorldSimOutputs):\n            return NotImplemented\n        return self.summary == other.summary\n\n    def __hash__(self) -> int:\n        return hash(tuple(sorted(self.summary.items())))\n","numLines":423,"startLine":1,"totalLines":423}}}
