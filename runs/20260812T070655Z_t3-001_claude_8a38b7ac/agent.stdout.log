{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016JhRUqtnYRDWSfnsEL67Vi","type":"tool_result","content":"1\t\"\"\"YAML config loading with Pydantic v2 validation.\n2\t\n3\tAll configuration sections are Pydantic ``BaseModel`` subclasses loaded\n4\tfrom a YAML file via :func:`load_config`. Fields use SI units where\n5\tapplicable and match the names used in the corresponding core datamodels.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\tfrom pathlib import Path\n11\tfrom typing import Any\n12\t\n13\timport yaml\n14\tfrom pydantic import BaseModel, field_validator\n15\t\n16\t\n17\tclass ProjectSection(BaseModel):\n18\t    \"\"\"Project metadata and output settings.\"\"\"\n19\t\n20\t    name: str\n21\t    seed: int = 42\n22\t    output_dir: str = \"./runs\"\n23\t\n24\t\n25\tclass ScenarioSection(BaseModel):\n26\t    \"\"\"Link scenario configuration (frequency, bandwidth, polarization).\"\"\"\n27\t\n28\t    name: str\n29\t    direction: str\n30\t    freq_hz: float\n31\t    bandwidth_hz: float\n32\t    polarization: str\n33\t    rx_polarization: str | None = None\n34\t    required_metric: str\n35\t    required_value: float\n36\t    misc: dict[str, Any] | None = None\n37\t\n38\t    @field_validator(\"direction\")\n39\t    @classmethod\n40\t    def validate_direction(cls, v: str) -> str:\n41\t        if v not in (\"uplink\", \"downlink\"):\n42\t            raise ValueError(\"direction must be 'uplink' or 'downlink'\")\n43\t        return v\n44\t\n45\t\n46\tclass TerminalSection(BaseModel):\n47\t    \"\"\"Single terminal definition (ground station or satellite).\"\"\"\n48\t\n49\t    name: str\n50\t    lat_deg: float\n51\t    lon_deg: float\n52\t    alt_m: float\n53\t    system_noise_temp_k: float | None = None\n54\t\n55\t\n56\tclass TerminalsSection(BaseModel):\n57\t    \"\"\"TX and RX terminal pair.\"\"\"\n58\t\n59\t    tx: TerminalSection\n60\t    rx: TerminalSection\n61\t\n62\t\n63\tclass ParametricAntennaConfig(BaseModel):\n64\t    \"\"\"Configuration for a fixed-gain parametric antenna.\"\"\"\n65\t\n66\t    gain_dbi: float = 0.0\n67\t    scan_loss_model: str = \"none\"\n68\t\n69\t\n70\tclass PamAntennaConfig(BaseModel):\n71\t    \"\"\"Configuration for a PAM phased-array antenna.\"\"\"\n72\t\n73\t    nx: int = 1\n74\t    ny: int = 1\n75\t    dx_lambda: float = 0.5\n76\t    dy_lambda: float = 0.5\n77\t    taper: dict[str, Any] | None = None\n78\t    steering: dict[str, Any] | None = None\n79\t    impairments: dict[str, Any] | None = None\n80\t\n81\t\n82\tclass CouplingConfig(BaseModel):\n83\t    \"\"\"EdgeFEM mutual-coupling configuration.\"\"\"\n84\t\n85\t    enabled: bool = False\n86\t    source: str = \"edgefem\"\n87\t    artifact_path: str | None = None\n88\t    metadata_path: str | None = None\n89\t    steering_az_deg: float = 0.0\n90\t    steering_el_deg: float = 0.0\n91\t\n92\t\n93\tclass AntennaEndConfig(BaseModel):\n94\t    \"\"\"Antenna configuration for one end of the link (TX or RX).\"\"\"\n95\t\n96\t    model: str = \"parametric\"\n97\t    parametric: ParametricAntennaConfig | None = None\n98\t    pam: PamAntennaConfig | None = None\n99\t    coupling: CouplingConfig | None = None\n100\t\n101\t\n102\tclass AntennaSection(BaseModel):\n103\t    \"\"\"TX and RX antenna configuration pair.\"\"\"\n104\t\n105\t    tx: AntennaEndConfig\n106\t    rx: AntennaEndConfig\n107\t\n108\t\n109\tclass RFStageConfig(BaseModel):\n110\t    \"\"\"Configuration for a single RF stage in a cascaded chain.\"\"\"\n111\t\n112\t    name: str\n113\t    gain_db: float\n114\t    nf_db: float\n115\t    iip3_dbm: float | None = None\n116\t\n117\t\n118\tclass RFChainSection(BaseModel):\n119\t    \"\"\"RF chain configuration (power, losses, noise, optional cascaded stages).\"\"\"\n120\t\n121\t    tx_power_w: float\n122\t    tx_losses_db: float = 0.0\n123\t    rx_noise_temp_k: float = 0.0\n124\t    stages: list[RFStageConfig] | None = None\n125\t\n126\t\n127\tclass PropagationComponentConfig(BaseModel):\n128\t    \"\"\"Configuration for a single propagation loss component.\"\"\"\n129\t\n130\t    type: str\n131\t    availability_target: float | None = None\n132\t    climate_region: str | None = None\n133\t\n134\t\n135\tclass PropagationSection(BaseModel):\n136\t    \"\"\"Propagation model configuration with optional composite components.\"\"\"\n137\t\n138\t    model: str = \"composite\"\n139\t    components: list[PropagationComponentConfig] = []\n140\t\n141\t\n142\tclass ModemSection(BaseModel):\n143\t    \"\"\"Modem configuration (DVB-S2 ModCod table and ACM policy).\"\"\"\n144\t\n145\t    enabled: bool = False\n146\t    target_bler: float = 1e-5\n147\t    modcod_table: str | None = None\n148\t    curves: dict[str, Any] | None = None\n149\t    acm_policy: dict[str, Any] | None = None\n150\t\n151\t\n152\tclass WorldOpsPolicy(BaseModel):\n153\t    \"\"\"Operational policy constraints for world simulation.\"\"\"\n154\t\n155\t    min_elevation_deg: float = 10.0\n156\t    max_scan_deg: float = 60.0\n157\t    handover_hysteresis_s: float = 5.0\n158\t    handover_hysteresis_db: float = 3.0\n159\t    handover_metric: str = \"margin\"\n160\t\n161\t\n162\tclass WorldSection(BaseModel):\n163\t    \"\"\"World/mission simulation configuration (time window, trajectory).\"\"\"\n164\t\n165\t    enabled: bool = False\n166\t    t0_s: float = 0.0\n167\t    t1_s: float = 600.0\n168\t    dt_s: float = 1.0\n169\t    trajectory: dict[str, Any] | None = None\n170\t    trajectories: dict[str, dict[str, Any]] | None = None\n171\t    ops_policy: WorldOpsPolicy = WorldOpsPolicy()\n172\t\n173\t\n174\tclass ReportsSection(BaseModel):\n175\t    \"\"\"Report generation settings.\"\"\"\n176\t\n177\t    format: str = \"html\"\n178\t    include_plots: bool = True\n179\t\n180\t\n181\tclass CosineAntennaConfig(BaseModel):\n182\t    \"\"\"Configuration for a cosine-rolloff antenna pattern.\"\"\"\n183\t\n184\t    peak_gain_dbi: float\n185\t    theta_3db_deg: float\n186\t    sidelobe_floor_dbi: float = -20.0\n187\t\n188\t\n189\tclass BeamConfig(BaseModel):\n190\t    \"\"\"Configuration for a single beam in a multi-beam payload.\"\"\"\n191\t\n192\t    beam_id: str\n193\t    az_deg: float\n194\t    el_deg: float\n195\t    tx_power_w: float\n196\t    antenna: AntennaEndConfig = AntennaEndConfig()\n197\t    cosine: CosineAntennaConfig | None = None\n198\t\n199\t    @field_validator(\"beam_id\")\n200\t    @classmethod\n201\t    def validate_beam_id(cls, v: str) -> str:\n202\t        if not v.strip():\n203\t            raise ValueError(\"beam_id must not be empty\")\n204\t        return v\n205\t\n206\t\n207\tclass PayloadSection(BaseModel):\n208\t    \"\"\"Multi-beam payload configuration (beams, grid, beam selection).\"\"\"\n209\t\n210\t    beams: list[BeamConfig]\n211\t    beam_selection: str = \"max_gain\"\n212\t    grid_az_range: list[float]\n213\t    grid_el_range: list[float]\n214\t    grid_step_deg: float = 1.0\n215\t\n216\t    @field_validator(\"beams\")\n217\t    @classmethod\n218\t    def validate_beams_nonempty(cls, v: list[BeamConfig]) -> list[BeamConfig]:\n219\t        if not v:\n220\t            raise ValueError(\"payload.beams must contain at least one beam\")\n221\t        return v\n222\t\n223\t    @field_validator(\"beam_selection\")\n224\t    @classmethod\n225\t    def validate_beam_selection(cls, v: str) -> str:\n226\t        if v not in (\"max_gain\", \"nearest\"):\n227\t            raise ValueError(\"beam_selection must be 'max_gain' or 'nearest'\")\n228\t        return v\n229\t\n230\t\n231\tclass ProjectConfig(BaseModel):\n232\t    \"\"\"Top-level project configuration combining all sections.\"\"\"\n233\t\n234\t    project: ProjectSection\n235\t    scenario: ScenarioSection\n236\t    terminals: TerminalsSection\n237\t    antenna: AntennaSection\n238\t    rf_chain: RFChainSection\n239\t    propagation: PropagationSection = PropagationSection()\n240\t    modem: ModemSection | None = None\n241\t    world: WorldSection | None = None\n242\t    reports: ReportsSection | None = None\n243\t    payload: PayloadSection | None = None\n244\t\n245\t\n246\tdef load_config(path: str | Path) -> ProjectConfig:\n247\t    \"\"\"Load and validate a YAML config file.\n248\t\n249\t    Parameters\n250\t    ----------\n251\t    path : str or Path\n252\t        Path to the YAML configuration file.\n253\t\n254\t    Returns\n255\t    -------\n256\t    ProjectConfig\n257\t        Validated project configuration.\n258\t\n259\t    Raises\n260\t    ------\n261\t    pydantic.ValidationError\n262\t        If the YAML content fails schema validation.\n263\t    \"\"\"\n264\t    with open(path) as f:\n265\t        raw = yaml.safe_load(f)\n266\t    return ProjectConfig.model_validate(raw)\n267\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"959b8261-ce9a-4641-99de-b387c6e41b4f","timestamp":"2026-08-12T07:16:52.363Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/.pyenv/versions/3.12.11/lib/python3.12/site-packages/opensatcom/io/config_loader.py","content":"\"\"\"YAML config loading with Pydantic v2 validation.\n\nAll configuration sections are Pydantic ``BaseModel`` subclasses loaded\nfrom a YAML file via :func:`load_config`. Fields use SI units where\napplicable and match the names used in the corresponding core datamodels.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\nfrom pydantic import BaseModel, field_validator\n\n\nclass ProjectSection(BaseModel):\n    \"\"\"Project metadata and output settings.\"\"\"\n\n    name: str\n    seed: int = 42\n    output_dir: str = \"./runs\"\n\n\nclass ScenarioSection(BaseModel):\n    \"\"\"Link scenario configuration (frequency, bandwidth, polarization).\"\"\"\n\n    name: str\n    direction: str\n    freq_hz: float\n    bandwidth_hz: float\n    polarization: str\n    rx_polarization: str | None = None\n    required_metric: str\n    required_value: float\n    misc: dict[str, Any] | None = None\n\n    @field_validator(\"direction\")\n    @classmethod\n    def validate_direction(cls, v: str) -> str:\n        if v not in (\"uplink\", \"downlink\"):\n            raise ValueError(\"direction must be 'uplink' or 'downlink'\")\n        return v\n\n\nclass TerminalSection(BaseModel):\n    \"\"\"Single terminal definition (ground station or satellite).\"\"\"\n\n    name: str\n    lat_deg: float\n    lon_deg: float\n    alt_m: float\n    system_noise_temp_k: float | None = None\n\n\nclass TerminalsSection(BaseModel):\n    \"\"\"TX and RX terminal pair.\"\"\"\n\n    tx: TerminalSection\n    rx: TerminalSection\n\n\nclass ParametricAntennaConfig(BaseModel):\n    \"\"\"Configuration for a fixed-gain parametric antenna.\"\"\"\n\n    gain_dbi: float = 0.0\n    scan_loss_model: str = \"none\"\n\n\nclass PamAntennaConfig(BaseModel):\n    \"\"\"Configuration for a PAM phased-array antenna.\"\"\"\n\n    nx: int = 1\n    ny: int = 1\n    dx_lambda: float = 0.5\n    dy_lambda: float = 0.5\n    taper: dict[str, Any] | None = None\n    steering: dict[str, Any] | None = None\n    impairments: dict[str, Any] | None = None\n\n\nclass CouplingConfig(BaseModel):\n    \"\"\"EdgeFEM mutual-coupling configuration.\"\"\"\n\n    enabled: bool = False\n    source: str = \"edgefem\"\n    artifact_path: str | None = None\n    metadata_path: str | None = None\n    steering_az_deg: float = 0.0\n    steering_el_deg: float = 0.0\n\n\nclass AntennaEndConfig(BaseModel):\n    \"\"\"Antenna configuration for one end of the link (TX or RX).\"\"\"\n\n    model: str = \"parametric\"\n    parametric: ParametricAntennaConfig | None = None\n    pam: PamAntennaConfig | None = None\n    coupling: CouplingConfig | None = None\n\n\nclass AntennaSection(BaseModel):\n    \"\"\"TX and RX antenna configuration pair.\"\"\"\n\n    tx: AntennaEndConfig\n    rx: AntennaEndConfig\n\n\nclass RFStageConfig(BaseModel):\n    \"\"\"Configuration for a single RF stage in a cascaded chain.\"\"\"\n\n    name: str\n    gain_db: float\n    nf_db: float\n    iip3_dbm: float | None = None\n\n\nclass RFChainSection(BaseModel):\n    \"\"\"RF chain configuration (power, losses, noise, optional cascaded stages).\"\"\"\n\n    tx_power_w: float\n    tx_losses_db: float = 0.0\n    rx_noise_temp_k: float = 0.0\n    stages: list[RFStageConfig] | None = None\n\n\nclass PropagationComponentConfig(BaseModel):\n    \"\"\"Configuration for a single propagation loss component.\"\"\"\n\n    type: str\n    availability_target: float | None = None\n    climate_region: str | None = None\n\n\nclass PropagationSection(BaseModel):\n    \"\"\"Propagation model configuration with optional composite components.\"\"\"\n\n    model: str = \"composite\"\n    components: list[PropagationComponentConfig] = []\n\n\nclass ModemSection(BaseModel):\n    \"\"\"Modem configuration (DVB-S2 ModCod table and ACM policy).\"\"\"\n\n    enabled: bool = False\n    target_bler: float = 1e-5\n    modcod_table: str | None = None\n    curves: dict[str, Any] | None = None\n    acm_policy: dict[str, Any] | None = None\n\n\nclass WorldOpsPolicy(BaseModel):\n    \"\"\"Operational policy constraints for world simulation.\"\"\"\n\n    min_elevation_deg: float = 10.0\n    max_scan_deg: float = 60.0\n    handover_hysteresis_s: float = 5.0\n    handover_hysteresis_db: float = 3.0\n    handover_metric: str = \"margin\"\n\n\nclass WorldSection(BaseModel):\n    \"\"\"World/mission simulation configuration (time window, trajectory).\"\"\"\n\n    enabled: bool = False\n    t0_s: float = 0.0\n    t1_s: float = 600.0\n    dt_s: float = 1.0\n    trajectory: dict[str, Any] | None = None\n    trajectories: dict[str, dict[str, Any]] | None = None\n    ops_policy: WorldOpsPolicy = WorldOpsPolicy()\n\n\nclass ReportsSection(BaseModel):\n    \"\"\"Report generation settings.\"\"\"\n\n    format: str = \"html\"\n    include_plots: bool = True\n\n\nclass CosineAntennaConfig(BaseModel):\n    \"\"\"Configuration for a cosine-rolloff antenna pattern.\"\"\"\n\n    peak_gain_dbi: float\n    theta_3db_deg: float\n    sidelobe_floor_dbi: float = -20.0\n\n\nclass BeamConfig(BaseModel):\n    \"\"\"Configuration for a single beam in a multi-beam payload.\"\"\"\n\n    beam_id: str\n    az_deg: float\n    el_deg: float\n    tx_power_w: float\n    antenna: AntennaEndConfig = AntennaEndConfig()\n    cosine: CosineAntennaConfig | None = None\n\n    @field_validator(\"beam_id\")\n    @classmethod\n    def validate_beam_id(cls, v: str) -> str:\n        if not v.strip():\n            raise ValueError(\"beam_id must not be empty\")\n        return v\n\n\nclass PayloadSection(BaseModel):\n    \"\"\"Multi-beam payload configuration (beams, grid, beam selection).\"\"\"\n\n    beams: list[BeamConfig]\n    beam_selection: str = \"max_gain\"\n    grid_az_range: list[float]\n    grid_el_range: list[float]\n    grid_step_deg: float = 1.0\n\n    @field_validator(\"beams\")\n    @classmethod\n    def validate_beams_nonempty(cls, v: list[BeamConfig]) -> list[BeamConfig]:\n        if not v:\n            raise ValueError(\"payload.beams must contain at least one beam\")\n        return v\n\n    @field_validator(\"beam_selection\")\n    @classmethod\n    def validate_beam_selection(cls, v: str) -> str:\n        if v not in (\"max_gain\", \"nearest\"):\n            raise ValueError(\"beam_selection must be 'max_gain' or 'nearest'\")\n        return v\n\n\nclass ProjectConfig(BaseModel):\n    \"\"\"Top-level project configuration combining all sections.\"\"\"\n\n    project: ProjectSection\n    scenario: ScenarioSection\n    terminals: TerminalsSection\n    antenna: AntennaSection\n    rf_chain: RFChainSection\n    propagation: PropagationSection = PropagationSection()\n    modem: ModemSection | None = None\n    world: WorldSection | None = None\n    reports: ReportsSection | None = None\n    payload: PayloadSection | None = None\n\n\ndef load_config(path: str | Path) -> ProjectConfig:\n    \"\"\"Load and validate a YAML config file.\n\n    Parameters\n    ----------\n    path : str or Path\n        Path to the YAML configuration file.\n\n    Returns\n    -------\n    ProjectConfig\n        Validated project configuration.\n\n    Raises\n    ------\n    pydantic.ValidationError\n        If the YAML content fails schema validation.\n    \"\"\"\n    with open(path) as f:\n        raw = yaml.safe_load(f)\n    return ProjectConfig.model_validate(raw)\n","numLines":267,"startLine":1,"totalLines":267}}}
