s:\n93\t        - {scan_deg: 0.0,  elevation_deg: 88.0, range_km: 603.0,  rain_mmh: 0.0, sky_temp_k: 152.0}\n94\t        - {scan_deg: 17.0, elevation_deg: 71.0, range_km: 632.0,  rain_mmh: 0.0, sky_temp_k: 160.0}\n95\t        - {scan_deg: 33.5, elevation_deg: 52.0, range_km: 741.0,  rain_mmh: 0.8, sky_temp_k: 205.0}\n96\t        - {scan_deg: 41.0, elevation_deg: 41.0, range_km: 856.0,  rain_mmh: 1.2, sky_temp_k: 228.0}\n97\t        - {scan_deg: 48.5, elevation_deg: 33.0, range_km: 1004.0, rain_mmh: 1.7, sky_temp_k: 244.0}\n98\t        - {scan_deg: 54.0, elevation_deg: 27.5, range_km: 1153.0, rain_mmh: 2.0, sky_temp_k: 259.0}\n99\t        - {scan_deg: 58.0, elevation_deg: 22.5, range_km: 1311.0, rain_mmh: 2.3, sky_temp_k: 269.0}\n100\t        - {scan_deg: 60.0, elevation_deg: 20.0, range_km: 1390.0, rain_mmh: 2.5, sky_temp_k: 275.0}\n101\t        - {scan_deg: 60.0, elevation_deg: 20.0, range_km: 1390.0, rain_mmh: 0.0, sky_temp_k: 190.0}\n102\t      failure_seeds: [101, 211, 307, 401, 503]\n103\t    crosscheck:\n104\t      pam_n_theta: 361\n105\t      pam_n_phi: 721\n106\t    opensatcom:\n107\t      availability_target: 0.995\n108\t\n109\trequirements:\n110\t  - id: link-margin\n111\t    metric: worst_case_link_margin_db\n112\t    min: 0.0\n113\t  - id: sidelobes\n114\t    metric: worst_case_pattern_sll_db\n115\t    max: -16.0\n116\t  - id: independent-link\n117\t    metric: opensatcom_worst_case_margin_db\n118\t    min: 0.0\n119\t  - id: clearsky-agreement\n120\t    metric: crosscheck_clearsky_margin_disagreement_db\n121\t    max: 1.2\n122\t  - id: gain-crosscheck\n123\t    metric: crosscheck_gain_disagreement_db\n124\t    max: 0.5\n125\t  - id: prime-power\n126\t    metric: prime_power_w\n127\t    max: 450.0\n128\t  - id: unit-cost\n129\t    metric: unit_cost_usd\n130\t    max: 45000.0\n131\t  - id: grating\n132\t    metric: grating_margin_lambda\n133\t    min: 0.0\n134\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"4a9a7