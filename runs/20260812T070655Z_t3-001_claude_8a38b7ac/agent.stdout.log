{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014E8FdnnHi1VjrprUVnKEKy","type":"tool_result","content":"1\t\"\"\"Composite propagation model summing multiple loss components.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom collections.abc import Sequence\n6\t\n7\tfrom opensatcom.core.models import PropagationConditions\n8\tfrom opensatcom.core.protocols import PropagationModel\n9\t\n10\t# Map class names to standard breakdown keys\n11\t_COMPONENT_KEY_MAP: dict[str, str] = {\n12\t    \"FreeSpacePropagation\": \"fspl_db\",\n13\t    \"RainAttenuationP618\": \"rain_attenuation_db\",\n14\t    \"GaseousAbsorptionP676\": \"gaseous_absorption_db\",\n15\t    \"ScintillationLoss\": \"scintillation_db\",\n16\t}\n17\t\n18\t\n19\tclass CompositePropagation:\n20\t    \"\"\"Sum losses in dB across multiple propagation components.\n21\t\n22\t    Combines FSPL with atmospheric, rain, and scintillation losses.\n23\t    Each component's ``total_path_loss_db`` is called and the results\n24\t    are summed in dB domain.\n25\t\n26\t    Parameters\n27\t    ----------\n28\t    components : Sequence of PropagationModel\n29\t        Ordered list of propagation models to combine.\n30\t\n31\t    Examples\n32\t    --------\n33\t    >>> from opensatcom.propagation import FreeSpacePropagation\n34\t    >>> comp = CompositePropagation([FreeSpacePropagation()])\n35\t    \"\"\"\n36\t\n37\t    def __init__(self, components: Sequence[PropagationModel]) -> None:\n38\t        self.components = components\n39\t\n40\t    def total_path_loss_db(\n41\t        self,\n42\t        f_hz: float,\n43\t        elev_deg: float,\n44\t        range_m: float,\n45\t        cond: PropagationConditions,\n46\t    ) -> float:\n47\t        \"\"\"Compute total composite path loss.\n48\t\n49\t        Parameters\n50\t        ----------\n51\t        f_hz : float\n52\t            Carrier frequency in Hz.\n53\t        elev_deg : float\n54\t            Elevation angle in degrees.\n55\t        range_m : float\n56\t            Slant range in metres.\n57\t        cond : PropagationConditions\n58\t            Environmental conditions.\n59\t\n60\t        Returns\n61\t        -------\n62\t        float\n63\t            Sum of all component losses in dB.\n64\t        \"\"\"\n65\t        return sum(\n66\t            c.total_path_loss_db(f_hz, elev_deg, range_m, cond)\n67\t            for c in self.components\n68\t        )\n69\t\n70\t    def per_component_losses_db(\n71\t        self,\n72\t        f_hz: float,\n73\t        elev_deg: float,\n74\t        range_m: float,\n75\t        cond: PropagationConditions,\n76\t    ) -> dict[str, float]:\n77\t        \"\"\"Compute per-component path losses.\n78\t\n79\t        Parameters\n80\t        ----------\n81\t        f_hz : float\n82\t            Carrier frequency in Hz.\n83\t        elev_deg : float\n84\t            Elevation angle in degrees.\n85\t        range_m : float\n86\t            Slant range in metres.\n87\t        cond : PropagationConditions\n88\t            Environmental conditions.\n89\t\n90\t        Returns\n91\t        -------\n92\t        dict of str to float\n93\t            Mapping from component key name to its loss in dB.\n94\t            Keys use standard names: ``fspl_db``, ``rain_attenuation_db``,\n95\t            ``gaseous_absorption_db``, ``scintillation_db``.\n96\t        \"\"\"\n97\t        result: dict[str, float] = {}\n98\t        for comp in self.components:\n99\t            class_name = type(comp).__name__\n100\t            key = _COMPONENT_KEY_MAP.get(class_name, f\"{class_name}_db\")\n101\t            result[key] = comp.total_path_loss_db(f_hz, elev_deg, range_m, cond)\n102\t        return result\n103\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"566464f8-e024-473b-885c-da5944ce6b23","timestamp":"2026-08-12T07:17:58.016Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/.pyenv/versions/3.12.11/lib/python3.12/site-packages/opensatcom/propagation/composite.py","content":"\"\"\"Composite propagation model summing multiple loss components.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Sequence\n\nfrom opensatcom.core.models import PropagationConditions\nfrom opensatcom.core.protocols import PropagationModel\n\n# Map class names to standard breakdown keys\n_COMPONENT_KEY_MAP: dict[str, str] = {\n    \"FreeSpacePropagation\": \"fspl_db\",\n    \"RainAttenuationP618\": \"rain_attenuation_db\",\n    \"GaseousAbsorptionP676\": \"gaseous_absorption_db\",\n    \"ScintillationLoss\": \"scintillation_db\",\n}\n\n\nclass CompositePropagation:\n    \"\"\"Sum losses in dB across multiple propagation components.\n\n    Combines FSPL with atmospheric, rain, and scintillation losses.\n    Each component's ``total_path_loss_db`` is called and the results\n    are summed in dB domain.\n\n    Parameters\n    ----------\n    components : Sequence of PropagationModel\n        Ordered list of propagation models to combine.\n\n    Examples\n    --------\n    >>> from opensatcom.propagation import FreeSpacePropagation\n    >>> comp = CompositePropagation([FreeSpacePropagation()])\n    \"\"\"\n\n    def __init__(self, components: Sequence[PropagationModel]) -> None:\n        self.components = components\n\n    def total_path_loss_db(\n        self,\n        f_hz: float,\n        elev_deg: float,\n        range_m: float,\n        cond: PropagationConditions,\n    ) -> float:\n        \"\"\"Compute total composite path loss.\n\n        Parameters\n        ----------\n        f_hz : float\n            Carrier frequency in Hz.\n        elev_deg : float\n            Elevation angle in degrees.\n        range_m : float\n            Slant range in metres.\n        cond : PropagationConditions\n            Environmental conditions.\n\n        Returns\n        -------\n        float\n            Sum of all component losses in dB.\n        \"\"\"\n        return sum(\n            c.total_path_loss_db(f_hz, elev_deg, range_m, cond)\n            for c in self.components\n        )\n\n    def per_component_losses_db(\n        self,\n        f_hz: float,\n        elev_deg: float,\n        range_m: float,\n        cond: PropagationConditions,\n    ) -> dict[str, float]:\n        \"\"\"Compute per-component path losses.\n\n        Parameters\n        ----------\n        f_hz : float\n            Carrier frequency in Hz.\n        elev_deg : float\n            Elevation angle in degrees.\n        range_m : float\n            Slant range in metres.\n        cond : PropagationConditions\n            Environmental conditions.\n\n        Returns\n        -------\n        dict of str to float\n            Mapping from component key name to its loss in dB.\n            Keys use standard names: ``fspl_db``, ``rain_attenuation_db``,\n            ``gaseous_absorption_db``, ``scintillation_db``.\n        \"\"\"\n        result: dict[str, float] = {}\n        for comp in self.components:\n            class_name = type(comp).__name__\n            key = _COMPONENT_KEY_MAP.get(class_name, f\"{class_name}_db\")\n            result[key] = comp.total_path_loss_db(f_hz, elev_deg, range_m, cond)\n        return result\n","numLines":103,"startLine":1,"totalLines":103}}}
