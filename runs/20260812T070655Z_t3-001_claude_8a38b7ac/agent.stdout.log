{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011KmSrxuNZeMm1QpTqcnidx","type":"tool_result","content":"1\t\"\"\"Phased-array antenna backed by phased-array-modeling, with analytic fallback.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport math\n6\timport warnings\n7\tfrom typing import Any\n8\t\n9\timport numpy as np\n10\t\n11\tfrom opensatcom.core.units import lin_to_db10, w_to_dbw\n12\t\n13\t_TAPER_2D = {\n14\t    \"taylor\": \"taylor_taper_2d\",\n15\t    \"chebyshev\": \"chebyshev_taper_2d\",\n16\t    \"hamming\": \"hamming_taper_2d\",\n17\t    \"hanning\": \"hanning_taper_2d\",\n18\t    \"cosine\": \"cosine_taper_2d\",\n19\t}\n20\t\n21\t\n22\tclass PamArrayAntenna:\n23\t    \"\"\"Planar phased-array antenna on an Nx-by-Ny rectangular lattice.\n24\t\n25\t    Two beam modes:\n26\t\n27\t    - ``steering=None`` (default): a *tracking* beam. The array is assumed to\n28\t      steer its beam electronically onto whatever direction is being\n29\t      evaluated, so every direction returns the peak gain. This models a\n30\t      terminal that follows the satellite. Elements are isotropic, so the\n31\t      scan-dependent losses of a real terminal (element rolloff, projected\n32\t      aperture) are not modeled.\n33\t    - ``steering=(theta0_deg, phi0_deg)``: a *fixed* beam. Angles passed to\n34\t      :meth:`gain_dbi` are then directions in the array's own frame, theta\n35\t      measured from the array normal, and the returned gain follows the real\n36\t      array factor of the tapered, steered lattice: peak at the steering\n37\t      direction, real sidelobe structure away from it. Requires\n38\t      `phased-array-modeling <https://pypi.org/project/phased-array-modeling/>`_\n39\t      (the ``pam`` extra).\n40\t\n41\t    Without the package installed a fixed beam degrades to peak gain at all\n42\t    angles, with a warning: link budgets stay usable, pattern shaping is off.\n43\t\n44\t    In all modes the peak gain is the standard aperture estimate\n45\t    ``D = 4 * pi * Nx * dx * Ny * dy`` (spacings in wavelengths), reduced by\n46\t    the taper efficiency when a taper is synthesized.\n47\t\n48\t    Parameters\n49\t    ----------\n50\t    nx : int, optional\n51\t        Number of elements along the x-axis, by default 1.\n52\t    ny : int, optional\n53\t        Number of elements along the y-axis, by default 1.\n54\t    dx_lambda : float, optional\n55\t        Element spacing along x in wavelengths, by default 0.5.\n56\t    dy_lambda : float, optional\n57\t        Element spacing along y in wavelengths, by default 0.5.\n58\t    taper : tuple of (str, float), str, or None, optional\n59\t        Amplitude taper.  A name (``\"uniform\"``, ``\"hamming\"``, ``\"hanning\"``,\n60\t        ``\"cosine\"``) or a ``(name, sll_db)`` tuple for parameterised tapers\n61\t        (``(\"taylor\", -25)``, ``(\"chebyshev\", -30)``).  ``None`` means uniform\n62\t        illumination, by default None.\n63\t    steering : tuple of (float, float) or None, optional\n64\t        Fixed beam direction ``(theta_deg, phi_deg)`` in the array frame,\n65\t        theta measured from the array normal.  ``None`` means the beam tracks\n66\t        the evaluated direction, by default None.\n67\t    impairments : Any or None, optional\n68\t        Reserved for element-level impairment models. Currently unused and\n69\t        ignored with a warning if set, by default None.\n70\t    \"\"\"\n71\t\n72\t    def __init__(\n73\t        self,\n74\t        nx: int = 1,\n75\t        ny: int = 1,\n76\t        dx_lambda: float = 0.5,\n77\t        dy_lambda: float = 0.5,\n78\t        taper: tuple[str, float] | str | None = None,\n79\t        steering: tuple[float, float] | None = None,\n80\t        impairments: Any | None = None,\n81\t    ) -> None:\n82\t        self.nx = nx\n83\t        self.ny = ny\n84\t        self.dx_lambda = dx_lambda\n85\t        self.dy_lambda = dy_lambda\n86\t        self.taper = taper\n87\t        self.steering = steering\n88\t        self.impairments = impairments\n89\t\n90\t        if impairments is not None:\n91\t            warnings.warn(\n92\t                \"PamArrayAntenna does not model element impairments yet; \"\n93\t                \"the impairments argument is ignored.\",\n94\t                stacklevel=2,\n95\t            )\n96\t\n97\t        self._pa: Any | None = None\n98\t        try:\n99\t            import phased_array\n100\t\n101\t            self._pa = phased_array\n102\t        except ImportError:\n103\t            warnings.warn(\n104\t                \"phased-array-modeling not installed; PamArrayAntenna will return \"\n105\t                \"peak gain at all angles (no pattern shaping). Install the 'pam' \"\n106\t                \"extra for real array-factor patterns.\",\n107\t                stacklevel=2,\n108\t            )\n109\t\n110\t        taper_weights = self._taper_weights()\n111\t        # Taper efficiency: |sum(w)|^2 / (N * sum(|w|^2)); 1.0 for uniform.\n112\t        taper_eff = float(\n113\t            np.abs(np.sum(taper_weights)) ** 2\n114\t            / (taper_weights.size * np.sum(np.abs(taper_weights) ** 2))\n115\t        )\n116\t\n117\t        # Peak gain: aperture estimate reduced by taper efficiency.\n118\t        aperture_lambda_sq = nx * dx_lambda * ny * dy_lambda\n119\t        self._peak_gain_lin = 4.0 * math.pi * aperture_lambda_sq * taper_eff\n120\t        self._peak_gain_dbi = lin_to_db10(self._peak_gain_lin)\n121\t\n122\t        if self._pa is not None and steering is not None:\n123\t            # Geometry in units of wavelength: spacings are specified in\n124\t            # wavelengths, so with wavelength=1.0 and k=2*pi the array factor\n125\t            # is frequency-independent, which matches the parameterisation.\n126\t            geom = self._pa.create_rectangular_array(\n127\t                nx, ny, dx=dx_lambda, dy=dy_lambda, wavelength=1.0\n128\t            )\n129\t            self._k = 2.0 * math.pi\n130\t            self._x = geom.x\n131\t            self._y = geom.y\n132\t            self._weights = taper_weights.ravel().astype(complex) * self._pa.steering_vector(\n133\t                self._k, self._x, self._y, steering[0], steering[1]\n134\t            )\n135\t            # The array factor peaks at the steering direction, where every\n136\t            # element adds in phase: |AF_max| = sum of the taper amplitudes.\n137\t            self._af_max = float(np.sum(np.abs(taper_weights)))\n138\t\n139\t    def _taper_weights(self) -> np.ndarray:\n140\t        \"\"\"Amplitude taper as an (nx, ny) array; ones when uniform.\"\"\"\n141\t        if self.taper is None or self.taper == \"uniform\":\n142\t            return np.ones((self.nx, self.ny))\n143\t\n144\t        if isinstance(self.taper, tuple):\n145\t            name, sll_db = self.taper\n146\t        else:\n147\t            name, sll_db = self.taper, None\n148\t\n149\t        if self._pa is None:\n150\t            # Fallback mode has no taper synthesis; peak gain then omits the\n151\t            # taper-efficiency reduction, which the docstring calls out.\n152\t            return np.ones((self.nx, self.ny))\n153\t\n154\t        func_name = _TAPER_2D.get(name)\n155\t        if func_name is None:\n156\t            raise ValueError(\n157\t                f\"unknown taper {name!r}; expected one of {sorted(_TAPER_2D)} or 'uniform'\"\n158\t            )\n159\t        func = getattr(self._pa, func_name)\n160\t        if sll_db is not None:\n161\t            # The library convention is negative dB for sidelobe level.\n162\t            return np.asarray(func(self.nx, self.ny, sidelobe_dB=-abs(sll_db)))\n163\t        return np.asarray(func(self.nx, self.ny))\n164\t\n165\t    def gain_dbi(self, theta_deg: np.ndarray, phi_deg: np.ndarray, f_hz: float) -> np.ndarray:\n166\t        \"\"\"Gain in dBi at the requested directions.\n167\t\n168\t        A tracking beam (``steering=None``) returns the peak gain for every\n169\t        direction.  A fixed beam returns the normalized array factor of the\n170\t        tapered, steered lattice referenced to the peak gain; angles are then\n171\t        directions in the array frame, theta measured from the array normal.\n172\t\n173\t        Parameters\n174\t        ----------\n175\t        theta_deg : numpy.ndarray\n176\t            Angles in degrees (array-frame theta for a fixed beam).  Output\n177\t            shape matches this.\n178\t        phi_deg : numpy.ndarray\n179\t            Azimuth angles in degrees, broadcastable with ``theta_deg``.\n180\t        f_hz : float\n181\t            Operating frequency in hertz.  Unused: spacings are given in\n182\t            wavelengths, so the pattern is frequency-independent.\n183\t\n184\t        Returns\n185\t        -------\n186\t        numpy.ndarray\n187\t            Gain values in dBi, same shape as ``theta_deg``.\n188\t        \"\"\"\n189\t        theta_deg = np.asarray(theta_deg, dtype=float)\n190\t        if self._pa is None or self.steering is None:\n191\t            return np.full_like(theta_deg, self._peak_gain_dbi, dtype=float)\n192\t\n193\t        theta = np.radians(theta_deg)\n194\t        phi = np.radians(np.broadcast_to(np.asarray(phi_deg, dtype=float), theta_deg.shape))\n195\t        af = self._pa.array_factor_vectorized(theta, phi, self._x, self._y, self._weights, self._k)\n196\t        normalized = (np.abs(af) / self._af_max) ** 2\n197\t        with np.errstate(divide=\"ignore\"):\n198\t            return np.asarray(self._peak_gain_dbi + 10.0 * np.log10(normalized))\n199\t\n200\t    def eirp_dbw(self, theta_deg: float, phi_deg: float, f_hz: float, tx_power_w: float) -> float:\n201\t        \"\"\"EIRP = Ptx(dBW) + G(dBi) toward the requested direction.\n202\t\n203\t        Parameters\n204\t        ----------\n205\t        theta_deg : float\n206\t            Angle from boresight in degrees toward the target.\n207\t        phi_deg : float\n208\t            Azimuth angle in degrees toward the target.\n209\t        f_hz : float\n210\t            Operating frequency in hertz.\n211\t        tx_power_w : float\n212\t            Transmitter output power in watts (linear).\n213\t\n214\t        Returns\n215\t        -------\n216\t        float\n217\t            EIRP in dBW.\n218\t        \"\"\"\n219\t        gain = float(self.gain_dbi(np.asarray([theta_deg]), np.asarray([phi_deg]), f_hz)[0])\n220\t        return w_to_dbw(tx_power_w) + gain\n221\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"d7a992ce-768b-44d1-8f04-3e070db4b1c7","timestamp":"2026-08-12T07:17:18.232Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/.pyenv/versions/3.12.11/lib/python3.12/site-packages/opensatcom/antenna/pam.py","content":"\"\"\"Phased-array antenna backed by phased-array-modeling, with analytic fallback.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport warnings\nfrom typing import Any\n\nimport numpy as np\n\nfrom opensatcom.core.units import lin_to_db10, w_to_dbw\n\n_TAPER_2D = {\n    \"taylor\": \"taylor_taper_2d\",\n    \"chebyshev\": \"chebyshev_taper_2d\",\n    \"hamming\": \"hamming_taper_2d\",\n    \"hanning\": \"hanning_taper_2d\",\n    \"cosine\": \"cosine_taper_2d\",\n}\n\n\nclass PamArrayAntenna:\n    \"\"\"Planar phased-array antenna on an Nx-by-Ny rectangular lattice.\n\n    Two beam modes:\n\n    - ``steering=None`` (default): a *tracking* beam. The array is assumed to\n      steer its beam electronically onto whatever direction is being\n      evaluated, so every direction returns the peak gain. This models a\n      terminal that follows the satellite. Elements are isotropic, so the\n      scan-dependent losses of a real terminal (element rolloff, projected\n      aperture) are not modeled.\n    - ``steering=(theta0_deg, phi0_deg)``: a *fixed* beam. Angles passed to\n      :meth:`gain_dbi` are then directions in the array's own frame, theta\n      measured from the array normal, and the returned gain follows the real\n      array factor of the tapered, steered lattice: peak at the steering\n      direction, real sidelobe structure away from it. Requires\n      `phased-array-modeling <https://pypi.org/project/phased-array-modeling/>`_\n      (the ``pam`` extra).\n\n    Without the package installed a fixed beam degrades to peak gain at all\n    angles, with a warning: link budgets stay usable, pattern shaping is off.\n\n    In all modes the peak gain is the standard aperture estimate\n    ``D = 4 * pi * Nx * dx * Ny * dy`` (spacings in wavelengths), reduced by\n    the taper efficiency when a taper is synthesized.\n\n    Parameters\n    ----------\n    nx : int, optional\n        Number of elements along the x-axis, by default 1.\n    ny : int, optional\n        Number of elements along the y-axis, by default 1.\n    dx_lambda : float, optional\n        Element spacing along x in wavelengths, by default 0.5.\n    dy_lambda : float, optional\n        Element spacing along y in wavelengths, by default 0.5.\n    taper : tuple of (str, float), str, or None, optional\n        Amplitude taper.  A name (``\"uniform\"``, ``\"hamming\"``, ``\"hanning\"``,\n        ``\"cosine\"``) or a ``(name, sll_db)`` tuple for parameterised tapers\n        (``(\"taylor\", -25)``, ``(\"chebyshev\", -30)``).  ``None`` means uniform\n        illumination, by default None.\n    steering : tuple of (float, float) or None, optional\n        Fixed beam direction ``(theta_deg, phi_deg)`` in the array frame,\n        theta measured from the array normal.  ``None`` means the beam tracks\n        the evaluated direction, by default None.\n    impairments : Any or None, optional\n        Reserved for element-level impairment models. Currently unused and\n        ignored with a warning if set, by default None.\n    \"\"\"\n\n    def __init__(\n        self,\n        nx: int = 1,\n        ny: int = 1,\n        dx_lambda: float = 0.5,\n        dy_lambda: float = 0.5,\n        taper: tuple[str, float] | str | None = None,\n        steering: tuple[float, float] | None = None,\n        impairments: Any | None = None,\n    ) -> None:\n        self.nx = nx\n        self.ny = ny\n        self.dx_lambda = dx_lambda\n        self.dy_lambda = dy_lambda\n        self.taper = taper\n        self.steering = steering\n        self.impairments = impairments\n\n        if impairments is not None:\n            warnings.warn(\n                \"PamArrayAntenna does not model element impairments yet; \"\n                \"the impairments argument is ignored.\",\n                stacklevel=2,\n            )\n\n        self._pa: Any | None = None\n        try:\n            import phased_array\n\n            self._pa = phased_array\n        except ImportError:\n            warnings.warn(\n                \"phased-array-modeling not installed; PamArrayAntenna will return \"\n                \"peak gain at all angles (no pattern shaping). Install the 'pam' \"\n                \"extra for real array-factor patterns.\",\n                stacklevel=2,\n            )\n\n        taper_weights = self._taper_weights()\n        # Taper efficiency: |sum(w)|^2 / (N * sum(|w|^2)); 1.0 for uniform.\n        taper_eff = float(\n            np.abs(np.sum(taper_weights)) ** 2\n            / (taper_weights.size * np.sum(np.abs(taper_weights) ** 2))\n        )\n\n        # Peak gain: aperture estimate reduced by taper efficiency.\n        aperture_lambda_sq = nx * dx_lambda * ny * dy_lambda\n        self._peak_gain_lin = 4.0 * math.pi * aperture_lambda_sq * taper_eff\n        self._peak_gain_dbi = lin_to_db10(self._peak_gain_lin)\n\n        if self._pa is not None and steering is not None:\n            # Geometry in units of wavelength: spacings are specified in\n            # wavelengths, so with wavelength=1.0 and k=2*pi the array factor\n            # is frequency-independent, which matches the parameterisation.\n            geom = self._pa.create_rectangular_array(\n                nx, ny, dx=dx_lambda, dy=dy_lambda, wavelength=1.0\n            )\n            self._k = 2.0 * math.pi\n            self._x = geom.x\n            self._y = geom.y\n            self._weights = taper_weights.ravel().astype(complex) * self._pa.steering_vector(\n                self._k, self._x, self._y, steering[0], steering[1]\n            )\n            # The array factor peaks at the steering direction, where every\n            # element adds in phase: |AF_max| = sum of the taper amplitudes.\n            self._af_max = float(np.sum(np.abs(taper_weights)))\n\n    def _taper_weights(self) -> np.ndarray:\n        \"\"\"Amplitude taper as an (nx, ny) array; ones when uniform.\"\"\"\n        if self.taper is None or self.taper == \"uniform\":\n            return np.ones((self.nx, self.ny))\n\n        if isinstance(self.taper, tuple):\n            name, sll_db = self.taper\n        else:\n            name, sll_db = self.taper, None\n\n        if self._pa is None:\n            # Fallback mode has no taper synthesis; peak gain then omits the\n            # taper-efficiency reduction, which the docstring calls out.\n            return np.ones((self.nx, self.ny))\n\n        func_name = _TAPER_2D.get(name)\n        if func_name is None:\n            raise ValueError(\n                f\"unknown taper {name!r}; expected one of {sorted(_TAPER_2D)} or 'uniform'\"\n            )\n        func = getattr(self._pa, func_name)\n        if sll_db is not None:\n            # The library convention is negative dB for sidelobe level.\n            return np.asarray(func(self.nx, self.ny, sidelobe_dB=-abs(sll_db)))\n        return np.asarray(func(self.nx, self.ny))\n\n    def gain_dbi(self, theta_deg: np.ndarray, phi_deg: np.ndarray, f_hz: float) -> np.ndarray:\n        \"\"\"Gain in dBi at the requested directions.\n\n        A tracking beam (``steering=None``) returns the peak gain for every\n        direction.  A fixed beam returns the normalized array factor of the\n        tapered, steered lattice referenced to the peak gain; angles are then\n        directions in the array frame, theta measured from the array normal.\n\n        Parameters\n        ----------\n        theta_deg : numpy.ndarray\n            Angles in degrees (array-frame theta for a fixed beam).  Output\n            shape matches this.\n        phi_deg : numpy.ndarray\n            Azimuth angles in degrees, broadcastable with ``theta_deg``.\n        f_hz : float\n            Operating frequency in hertz.  Unused: spacings are given in\n            wavelengths, so the pattern is frequency-independent.\n\n        Returns\n        -------\n        numpy.ndarray\n            Gain values in dBi, same shape as ``theta_deg``.\n        \"\"\"\n        theta_deg = np.asarray(theta_deg, dtype=float)\n        if self._pa is None or self.steering is None:\n            return np.full_like(theta_deg, self._peak_gain_dbi, dtype=float)\n\n        theta = np.radians(theta_deg)\n        phi = np.radians(np.broadcast_to(np.asarray(phi_deg, dtype=float), theta_deg.shape))\n        af = self._pa.array_factor_vectorized(theta, phi, self._x, self._y, self._weights, self._k)\n        normalized = (np.abs(af) / self._af_max) ** 2\n        with np.errstate(divide=\"ignore\"):\n            return np.asarray(self._peak_gain_dbi + 10.0 * np.log10(normalized))\n\n    def eirp_dbw(self, theta_deg: float, phi_deg: float, f_hz: float, tx_power_w: float) -> float:\n        \"\"\"EIRP = Ptx(dBW) + G(dBi) toward the requested direction.\n\n        Parameters\n        ----------\n        theta_deg : float\n            Angle from boresight in degrees toward the target.\n        phi_deg : float\n            Azimuth angle in degrees toward the target.\n        f_hz : float\n            Operating frequency in hertz.\n        tx_power_w : float\n            Transmitter output power in watts (linear).\n\n        Returns\n        -------\n        float\n            EIRP in dBW.\n        \"\"\"\n        gain = float(self.gain_dbi(np.asarray([theta_deg]), np.asarray([phi_deg]), f_hz)[0])\n        return w_to_dbw(tx_power_w) + gain\n","numLines":221,"startLine":1,"totalLines":221}}}
