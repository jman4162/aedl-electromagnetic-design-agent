{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CsZ7tvpoixJWiomKequxEr","type":"tool_result","content":"1\t\"\"\"Default link budget engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport numpy as np\n6\t\n7\tfrom opensatcom.core.constants import BOLTZMANN_DBW_PER_K_HZ\n8\tfrom opensatcom.core.models import LinkInputs, LinkOutputs, PropagationConditions\n9\tfrom opensatcom.core.units import lin_to_db10, w_to_dbw\n10\tfrom opensatcom.link.polarization import polarization_loss_db\n11\t\n12\t\n13\tclass DefaultLinkEngine:\n14\t    \"\"\"Snapshot link budget engine following spec Section 12.\n15\t\n16\t    Computes EIRP, G/T, C/N0, Eb/N0, and margin for a single time instant.\n17\t    Optionally computes throughput when a modem model is attached to\n18\t    ``LinkInputs``.\n19\t\n20\t    Examples\n21\t    --------\n22\t    >>> engine = DefaultLinkEngine()\n23\t    >>> result = engine.evaluate_snapshot(30.0, 0.0, range_m, link_inputs, cond)\n24\t    >>> result.margin_db\n25\t    12.34\n26\t    \"\"\"\n27\t\n28\t    def evaluate_snapshot(\n29\t        self,\n30\t        elev_deg: float,\n31\t        az_deg: float,\n32\t        range_m: float,\n33\t        inputs: LinkInputs,\n34\t        cond: PropagationConditions,\n35\t    ) -> LinkOutputs:\n36\t        \"\"\"Evaluate a snapshot link budget.\n37\t\n38\t        Parameters\n39\t        ----------\n40\t        elev_deg : float\n41\t            Elevation angle from the receive terminal to the transmit\n42\t            terminal, in degrees.\n43\t        az_deg : float\n44\t            Azimuth angle in degrees.\n45\t        range_m : float\n46\t            Slant range between terminals in metres.\n47\t        inputs : LinkInputs\n48\t            Complete link configuration (terminals, antennas, propagation,\n49\t            RF chain, and optional modem).\n50\t        cond : PropagationConditions\n51\t            Environmental / atmospheric conditions.\n52\t\n53\t        Returns\n54\t        -------\n55\t        LinkOutputs\n56\t            Full link budget results including EIRP, G/T, C/N0, Eb/N0,\n57\t            margin, optional throughput, and an itemised breakdown dict.\n58\t        \"\"\"\n59\t        sc = inputs.scenario\n60\t        rf = inputs.rf_chain\n61\t\n62\t        # 1. TX power\n63\t        tx_power_dbw = w_to_dbw(rf.tx_power_w)\n64\t        tx_losses_db = rf.tx_losses_db\n65\t\n66\t        # 2. TX antenna gain\n67\t        theta = np.array([elev_deg])\n68\t        phi = np.array([az_deg])\n69\t        tx_gain_dbi = float(inputs.tx_antenna.gain_dbi(theta, phi, sc.freq_hz)[0])\n70\t\n71\t        # 3. EIRP\n72\t        eirp_dbw = tx_power_dbw - tx_losses_db + tx_gain_dbi\n73\t\n74\t        # 4. Path loss (total from propagation model)\n75\t        path_loss_db = inputs.propagation.total_path_loss_db(\n76\t            sc.freq_hz, elev_deg, range_m, cond\n77\t        )\n78\t\n79\t        # 4a. Per-component losses for breakdown\n80\t        from opensatcom.propagation.composite import CompositePropagation\n81\t\n82\t        component_losses: dict[str, float] = {}\n83\t        if isinstance(inputs.propagation, CompositePropagation):\n84\t            component_losses = inputs.propagation.per_component_losses_db(\n85\t                sc.freq_hz, elev_deg, range_m, cond\n86\t            )\n87\t\n88\t        # 4b. Polarization mismatch loss\n89\t        tx_pol = sc.polarization\n90\t        rx_pol = getattr(sc, \"rx_polarization\", None) or tx_pol\n91\t        pol_loss_db = polarization_loss_db(tx_pol, rx_pol)\n92\t\n93\t        # 5. RX antenna gain\n94\t        rx_gain_dbi = float(inputs.rx_antenna.gain_dbi(theta, phi, sc.freq_hz)[0])\n95\t\n96\t        # 6. System noise temperature\n97\t        # Use terminal system_noise_temp_k if set, else rf.rx_noise_temp_k\n98\t        rx_terminal = inputs.rx_terminal\n99\t        if rx_terminal.system_noise_temp_k is not None:\n100\t            tsys_k = rx_terminal.system_noise_temp_k\n101\t        else:\n102\t            tsys_k = rf.rx_noise_temp_k\n103\t\n104\t        # 7. G/T\n105\t        gt_dbk = rx_gain_dbi - lin_to_db10(tsys_k)\n106\t\n107\t        # 8. C/N0 = EIRP - path_loss - pol_loss + G/T - k_boltzmann\n108\t        cn0_dbhz = eirp_dbw - path_loss_db - pol_loss_db + gt_dbk - BOLTZMANN_DBW_PER_K_HZ\n109\t\n110\t        # 9. Eb/N0 = C/N0 - 10*log10(Rb)\n111\t        data_rate_bps = sc.bandwidth_hz\n112\t        if inputs.modem is not None:\n113\t            modem_result = inputs.modem.throughput_mbps(\n114\t                cn0_dbhz - lin_to_db10(sc.bandwidth_hz),\n115\t                sc.bandwidth_hz,\n116\t                0.0,\n117\t            )\n118\t            data_rate_bps = modem_result[\"spectral_eff_bps_per_hz\"] * sc.bandwidth_hz\n119\t\n120\t        ebn0_db = cn0_dbhz - lin_to_db10(data_rate_bps)\n121\t\n122\t        # 10. Margin calculation\n123\t        if sc.required_metric == \"ebn0_db\":\n124\t            margin_db = ebn0_db - sc.required_value\n125\t        elif sc.required_metric == \"cn0_dbhz\":\n126\t            margin_db = cn0_dbhz - sc.required_value\n127\t        else:\n128\t            margin_db = ebn0_db - sc.required_value\n129\t\n130\t        # 11. Throughput (if modem present)\n131\t        throughput_mbps: float | None = None\n132\t        if inputs.modem is not None:\n133\t            modem_result = inputs.modem.throughput_mbps(\n134\t                ebn0_db, sc.bandwidth_hz, 0.0\n135\t            )\n136\t            throughput_mbps = modem_result[\"throughput_mbps\"]\n137\t\n138\t        # 12. Itemized breakdown dict\n139\t        breakdown: dict[str, float] = {\n140\t            \"tx_power_dbw\": tx_power_dbw,\n141\t            \"tx_losses_db\": tx_losses_db,\n142\t            \"tx_antenna_gain_dbi\": tx_gain_dbi,\n143\t            \"eirp_dbw\": eirp_dbw,\n144\t            \"fspl_db\": component_losses.get(\"fspl_db\", path_loss_db),\n145\t            \"rain_attenuation_db\": component_losses.get(\"rain_attenuation_db\", 0.0),\n146\t            \"gaseous_absorption_db\": component_losses.get(\"gaseous_absorption_db\", 0.0),\n147\t            \"scintillation_db\": component_losses.get(\"scintillation_db\", 0.0),\n148\t            \"total_path_loss_db\": path_loss_db,\n149\t            \"polarization_loss_db\": pol_loss_db,\n150\t            \"rx_antenna_gain_dbi\": rx_gain_dbi,\n151\t            \"rx_system_temp_k\": tsys_k,\n152\t            \"gt_dbk\": gt_dbk,\n153\t            \"cn0_dbhz\": cn0_dbhz,\n154\t            \"ebn0_db\": ebn0_db,\n155\t            \"margin_db\": margin_db,\n156\t        }\n157\t\n158\t        return LinkOutputs(\n159\t            eirp_dbw=eirp_dbw,\n160\t            gt_dbk=gt_dbk,\n161\t            path_loss_db=path_loss_db,\n162\t            cn0_dbhz=cn0_dbhz,\n163\t            ebn0_db=ebn0_db,\n164\t            margin_db=margin_db,\n165\t            throughput_mbps=throughput_mbps,\n166\t            breakdown=breakdown,\n167\t        )\n168\t"}]},"parent_tool_use_id":null,"session_id":"0fddd011-8e49-46a0-8907-9ad948b37ed1","uuid":"6170a750-9340-42b8-a817-1b62ac49df74","timestamp":"2026-08-12T07:17:09.083Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/.pyenv/versions/3.12.11/lib/python3.12/site-packages/opensatcom/link/engine.py","content":"\"\"\"Default link budget engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom opensatcom.core.constants import BOLTZMANN_DBW_PER_K_HZ\nfrom opensatcom.core.models import LinkInputs, LinkOutputs, PropagationConditions\nfrom opensatcom.core.units import lin_to_db10, w_to_dbw\nfrom opensatcom.link.polarization import polarization_loss_db\n\n\nclass DefaultLinkEngine:\n    \"\"\"Snapshot link budget engine following spec Section 12.\n\n    Computes EIRP, G/T, C/N0, Eb/N0, and margin for a single time instant.\n    Optionally computes throughput when a modem model is attached to\n    ``LinkInputs``.\n\n    Examples\n    --------\n    >>> engine = DefaultLinkEngine()\n    >>> result = engine.evaluate_snapshot(30.0, 0.0, range_m, link_inputs, cond)\n    >>> result.margin_db\n    12.34\n    \"\"\"\n\n    def evaluate_snapshot(\n        self,\n        elev_deg: float,\n        az_deg: float,\n        range_m: float,\n        inputs: LinkInputs,\n        cond: PropagationConditions,\n    ) -> LinkOutputs:\n        \"\"\"Evaluate a snapshot link budget.\n\n        Parameters\n        ----------\n        elev_deg : float\n            Elevation angle from the receive terminal to the transmit\n            terminal, in degrees.\n        az_deg : float\n            Azimuth angle in degrees.\n        range_m : float\n            Slant range between terminals in metres.\n        inputs : LinkInputs\n            Complete link configuration (terminals, antennas, propagation,\n            RF chain, and optional modem).\n        cond : PropagationConditions\n            Environmental / atmospheric conditions.\n\n        Returns\n        -------\n        LinkOutputs\n            Full link budget results including EIRP, G/T, C/N0, Eb/N0,\n            margin, optional throughput, and an itemised breakdown dict.\n        \"\"\"\n        sc = inputs.scenario\n        rf = inputs.rf_chain\n\n        # 1. TX power\n        tx_power_dbw = w_to_dbw(rf.tx_power_w)\n        tx_losses_db = rf.tx_losses_db\n\n        # 2. TX antenna gain\n        theta = np.array([elev_deg])\n        phi = np.array([az_deg])\n        tx_gain_dbi = float(inputs.tx_antenna.gain_dbi(theta, phi, sc.freq_hz)[0])\n\n        # 3. EIRP\n        eirp_dbw = tx_power_dbw - tx_losses_db + tx_gain_dbi\n\n        # 4. Path loss (total from propagation model)\n        path_loss_db = inputs.propagation.total_path_loss_db(\n            sc.freq_hz, elev_deg, range_m, cond\n        )\n\n        # 4a. Per-component losses for breakdown\n        from opensatcom.propagation.composite import CompositePropagation\n\n        component_losses: dict[str, float] = {}\n        if isinstance(inputs.propagation, CompositePropagation):\n            component_losses = inputs.propagation.per_component_losses_db(\n                sc.freq_hz, elev_deg, range_m, cond\n            )\n\n        # 4b. Polarization mismatch loss\n        tx_pol = sc.polarization\n        rx_pol = getattr(sc, \"rx_polarization\", None) or tx_pol\n        pol_loss_db = polarization_loss_db(tx_pol, rx_pol)\n\n        # 5. RX antenna gain\n        rx_gain_dbi = float(inputs.rx_antenna.gain_dbi(theta, phi, sc.freq_hz)[0])\n\n        # 6. System noise temperature\n        # Use terminal system_noise_temp_k if set, else rf.rx_noise_temp_k\n        rx_terminal = inputs.rx_terminal\n        if rx_terminal.system_noise_temp_k is not None:\n            tsys_k = rx_terminal.system_noise_temp_k\n        else:\n            tsys_k = rf.rx_noise_temp_k\n\n        # 7. G/T\n        gt_dbk = rx_gain_dbi - lin_to_db10(tsys_k)\n\n        # 8. C/N0 = EIRP - path_loss - pol_loss + G/T - k_boltzmann\n        cn0_dbhz = eirp_dbw - path_loss_db - pol_loss_db + gt_dbk - BOLTZMANN_DBW_PER_K_HZ\n\n        # 9. Eb/N0 = C/N0 - 10*log10(Rb)\n        data_rate_bps = sc.bandwidth_hz\n        if inputs.modem is not None:\n            modem_result = inputs.modem.throughput_mbps(\n                cn0_dbhz - lin_to_db10(sc.bandwidth_hz),\n                sc.bandwidth_hz,\n                0.0,\n            )\n            data_rate_bps = modem_result[\"spectral_eff_bps_per_hz\"] * sc.bandwidth_hz\n\n        ebn0_db = cn0_dbhz - lin_to_db10(data_rate_bps)\n\n        # 10. Margin calculation\n        if sc.required_metric == \"ebn0_db\":\n            margin_db = ebn0_db - sc.required_value\n        elif sc.required_metric == \"cn0_dbhz\":\n            margin_db = cn0_dbhz - sc.required_value\n        else:\n            margin_db = ebn0_db - sc.required_value\n\n        # 11. Throughput (if modem present)\n        throughput_mbps: float | None = None\n        if inputs.modem is not None:\n            modem_result = inputs.modem.throughput_mbps(\n                ebn0_db, sc.bandwidth_hz, 0.0\n            )\n            throughput_mbps = modem_result[\"throughput_mbps\"]\n\n        # 12. Itemized breakdown dict\n        breakdown: dict[str, float] = {\n            \"tx_power_dbw\": tx_power_dbw,\n            \"tx_losses_db\": tx_losses_db,\n            \"tx_antenna_gain_dbi\": tx_gain_dbi,\n            \"eirp_dbw\": eirp_dbw,\n            \"fspl_db\": component_losses.get(\"fspl_db\", path_loss_db),\n            \"rain_attenuation_db\": component_losses.get(\"rain_attenuation_db\", 0.0),\n            \"gaseous_absorption_db\": component_losses.get(\"gaseous_absorption_db\", 0.0),\n            \"scintillation_db\": component_losses.get(\"scintillation_db\", 0.0),\n            \"total_path_loss_db\": path_loss_db,\n            \"polarization_loss_db\": pol_loss_db,\n            \"rx_antenna_gain_dbi\": rx_gain_dbi,\n            \"rx_system_temp_k\": tsys_k,\n            \"gt_dbk\": gt_dbk,\n            \"cn0_dbhz\": cn0_dbhz,\n            \"ebn0_db\": ebn0_db,\n            \"margin_db\": margin_db,\n        }\n\n        return LinkOutputs(\n            eirp_dbw=eirp_dbw,\n            gt_dbk=gt_dbk,\n            path_loss_db=path_loss_db,\n            cn0_dbhz=cn0_dbhz,\n            ebn0_db=ebn0_db,\n            margin_db=margin_db,\n            throughput_mbps=throughput_mbps,\n            breakdown=breakdown,\n        )\n","numLines":168,"startLine":1,"totalLines":168}}}
