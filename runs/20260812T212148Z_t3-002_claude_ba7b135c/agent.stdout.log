{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EMvFjGVnKfM5A2bzCcJKwf","type":"tool_result","content":"1\t\"\"\"Radar detection scenario definition.\"\"\"\n2\t\n3\tfrom typing import Literal\n4\t\n5\tfrom pydantic import Field, computed_field\n6\t\n7\tfrom phased_array_systems.constants import C_LIGHT\n8\tfrom phased_array_systems.scenarios.base import ScenarioBase\n9\t\n10\tClutterType = Literal[\"none\", \"sea\", \"ground\", \"rain\"]\n11\tTerrainType = Literal[\"rural\", \"urban\", \"forest\", \"desert\", \"wetland\"]\n12\tCFARType = Literal[\"none\", \"CA\", \"OS\", \"GO\", \"SO\"]\n13\tPolarizationType = Literal[\"HH\", \"VV\", \"HV\"]\n14\t\n15\t\n16\tclass RadarDetectionScenario(ScenarioBase):\n17\t    \"\"\"Scenario for radar detection analysis.\n18\t\n19\t    Defines the operating conditions for monostatic radar detection,\n20\t    including target characteristics, detection requirements, pulse\n21\t    integration parameters, clutter environment, and propagation effects.\n22\t\n23\t    Attributes:\n24\t        freq_hz: Operating frequency (Hz)\n25\t        bandwidth_hz: Signal bandwidth (Hz)\n26\t        range_m: Target range (meters)\n27\t        target_rcs_dbsm: Target radar cross section (dBsm)\n28\t        rx_noise_temp_k: Receiver noise temperature (K)\n29\t        pfa: Probability of false alarm\n30\t        pd_required: Required probability of detection\n31\t        n_pulses: Number of pulses integrated\n32\t        scan_angle_deg: Beam scan angle from boresight (degrees)\n33\t        integration_type: Coherent or non-coherent integration\n34\t        clutter_type: Type of clutter environment\n35\t        sea_state: Sea state for sea clutter (0-6 Douglas scale)\n36\t        terrain_type: Terrain type for ground clutter\n37\t        rain_rate_mm_hr: Rain rate for rain clutter/attenuation\n38\t        grazing_angle_deg: Grazing angle for clutter calculations\n39\t        antenna_height_m: Antenna height above surface\n40\t        target_height_m: Target height above surface\n41\t        polarization: Antenna polarization\n42\t        cfar_type: CFAR detector type\n43\t        cfar_ref_cells: Number of CFAR reference cells\n44\t        cfar_guard_cells: Number of CFAR guard cells\n45\t        include_atmos_loss: Include atmospheric attenuation\n46\t        temperature_c: Ambient temperature for atmos model\n47\t        humidity_pct: Relative humidity for atmos model\n48\t    \"\"\"\n49\t\n50\t    bandwidth_hz: float = Field(gt=0, description=\"Signal bandwidth (Hz)\")\n51\t    range_m: float = Field(gt=0, description=\"Target range (m)\")\n52\t    target_rcs_dbsm: float = Field(description=\"Target RCS (dBsm)\")\n53\t    rx_noise_temp_k: float = Field(\n54\t        default=290.0, gt=0, description=\"Receiver noise temperature (K)\"\n55\t    )\n56\t    pfa: float = Field(default=1e-6, gt=0, lt=1, description=\"Probability of false alarm\")\n57\t    pd_required: float = Field(\n58\t        default=0.9, gt=0, lt=1, description=\"Required probability of detection\"\n59\t    )\n60\t    n_pulses: int = Field(default=1, ge=1, description=\"Number of pulses integrated\")\n61\t    swerling: Literal[0, 1, 2, 3, 4] = Field(\n62\t        default=0, description=\"Swerling target fluctuation model (0 = non-fluctuating)\"\n63\t    )\n64\t    duty_cycle: float = Field(\n65\t        default=1.0, gt=0, le=1, description=\"Transmit duty cycle (avg/peak power ratio)\"\n66\t    )\n67\t    scan_angle_deg: float = Field(\n68\t        default=0.0, ge=0, le=90, description=\"Scan angle from boresight (deg)\"\n69\t    )\n70\t    integration_type: Literal[\"coherent\", \"noncoherent\"] = Field(\n71\t        default=\"noncoherent\", description=\"Integration type\"\n72\t    )\n73\t\n74\t    # Clutter parameters\n75\t    clutter_type: ClutterType = Field(default=\"none\", description=\"Type of clutter environment\")\n76\t    sea_state: int = Field(default=3, ge=0, le=6, description=\"Sea state (0-6 Douglas scale)\")\n77\t    terrain_type: TerrainType = Field(\n78\t        default=\"rural\", description=\"Terrain type for ground clutter\"\n79\t    )\n80\t    rain_rate_mm_hr: float = Field(default=0.0, ge=0, description=\"Rain rate (mm/hour)\")\n81\t    grazing_angle_deg: float | None = Field(\n82\t        default=None,\n83\t        ge=0.1,\n84\t        le=90,\n85\t        description=\"Grazing angle (deg). If None, computed from geometry.\",\n86\t    )\n87\t    antenna_height_m: float = Field(\n88\t        default=10.0, ge=0, description=\"Antenna height above surface (m)\"\n89\t    )\n90\t    target_height_m: float = Field(default=0.0, ge=0, description=\"Target height above surface (m)\")\n91\t    polarization: PolarizationType = Field(default=\"HH\", description=\"Antenna polarization\")\n92\t\n93\t    # CFAR parameters\n94\t    cfar_type: CFARType = Field(default=\"none\", description=\"CFAR detector type\")\n95\t    cfar_ref_cells: int = Field(default=16, ge=2, description=\"Number of CFAR reference cells\")\n96\t    cfar_guard_cells: int = Field(\n97\t        default=2, ge=0, description=\"Number of CFAR guard cells per side\"\n98\t    )\n99\t\n100\t    # Search timeline parameters (all set -> timeline metrics are computed)\n101\t    prf_hz: float | None = Field(\n102\t        default=None, gt=0, description=\"Pulse repetition frequency (Hz); dwell = n_pulses/PRF\"\n103\t    )\n104\t    search_az_extent_deg: float | None = Field(\n105\t        default=None, gt=0, le=360, description=\"Search volume azimuth extent (deg)\"\n106\t    )\n107\t    search_el_extent_deg: float | None = Field(\n108\t        default=None, gt=0, le=90, description=\"Search volume elevation extent (deg)\"\n109\t    )\n110\t    beam_overhead_us: float = Field(\n111\t        default=0.0, ge=0, description=\"Beam-switching overhead per position (us)\"\n112\t    )\n113\t    search_frame_time_ms: float | None = Field(\n114\t        default=None,\n115\t        gt=0,\n116\t        description=\"Allotted search frame budget (ms); sets timeline_occupancy\",\n117\t    )\n118\t\n119\t    # Propagation parameters\n120\t    include_atmos_loss: bool = Field(default=False, description=\"Include atmospheric attenuation\")\n121\t    temperature_c: float = Field(default=15.0, description=\"Ambient temperature (Celsius)\")\n122\t    humidity_pct: float = Field(default=50.0, ge=0, le=100, description=\"Relative humidity (%)\")\n123\t\n124\t    @computed_field  # type: ignore[prop-decorator]\n125\t    @property\n126\t    def wavelength_m(self) -> float:\n127\t        \"\"\"Wavelength in meters.\"\"\"\n128\t        return C_LIGHT / self.freq_hz\n129\t\n130\t    @computed_field  # type: ignore[prop-decorator]\n131\t    @property\n132\t    def target_rcs_m2(self) -> float:\n133\t        \"\"\"Target RCS in square meters.\"\"\"\n134\t        return 10 ** (self.target_rcs_dbsm / 10)\n135\t\n136\t    @computed_field  # type: ignore[prop-decorator]\n137\t    @property\n138\t    def range_resolution_m(self) -> float:\n139\t        \"\"\"Range resolution in meters (c / 2B).\"\"\"\n140\t        return C_LIGHT / (2 * self.bandwidth_hz)\n141\t"}]},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"b292caf0-2c26-45c4-b33f-c85bec967630","timestamp":"2026-08-12T21:24:33.728Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/scenarios/radar.py","content":"\"\"\"Radar detection scenario definition.\"\"\"\n\nfrom typing import Literal\n\nfrom pydantic import Field, computed_field\n\nfrom phased_array_systems.constants import C_LIGHT\nfrom phased_array_systems.scenarios.base import ScenarioBase\n\nClutterType = Literal[\"none\", \"sea\", \"ground\", \"rain\"]\nTerrainType = Literal[\"rural\", \"urban\", \"forest\", \"desert\", \"wetland\"]\nCFARType = Literal[\"none\", \"CA\", \"OS\", \"GO\", \"SO\"]\nPolarizationType = Literal[\"HH\", \"VV\", \"HV\"]\n\n\nclass RadarDetectionScenario(ScenarioBase):\n    \"\"\"Scenario for radar detection analysis.\n\n    Defines the operating conditions for monostatic radar detection,\n    including target characteristics, detection requirements, pulse\n    integration parameters, clutter environment, and propagation effects.\n\n    Attributes:\n        freq_hz: Operating frequency (Hz)\n        bandwidth_hz: Signal bandwidth (Hz)\n        range_m: Target range (meters)\n        target_rcs_dbsm: Target radar cross section (dBsm)\n        rx_noise_temp_k: Receiver noise temperature (K)\n        pfa: Probability of false alarm\n        pd_required: Required probability of detection\n        n_pulses: Number of pulses integrated\n        scan_angle_deg: Beam scan angle from boresight (degrees)\n        integration_type: Coherent or non-coherent integration\n        clutter_type: Type of clutter environment\n        sea_state: Sea state for sea clutter (0-6 Douglas scale)\n        terrain_type: Terrain type for ground clutter\n        rain_rate_mm_hr: Rain rate for rain clutter/attenuation\n        grazing_angle_deg: Grazing angle for clutter calculations\n        antenna_height_m: Antenna height above surface\n        target_height_m: Target height above surface\n        polarization: Antenna polarization\n        cfar_type: CFAR detector type\n        cfar_ref_cells: Number of CFAR reference cells\n        cfar_guard_cells: Number of CFAR guard cells\n        include_atmos_loss: Include atmospheric attenuation\n        temperature_c: Ambient temperature for atmos model\n        humidity_pct: Relative humidity for atmos model\n    \"\"\"\n\n    bandwidth_hz: float = Field(gt=0, description=\"Signal bandwidth (Hz)\")\n    range_m: float = Field(gt=0, description=\"Target range (m)\")\n    target_rcs_dbsm: float = Field(description=\"Target RCS (dBsm)\")\n    rx_noise_temp_k: float = Field(\n        default=290.0, gt=0, description=\"Receiver noise temperature (K)\"\n    )\n    pfa: float = Field(default=1e-6, gt=0, lt=1, description=\"Probability of false alarm\")\n    pd_required: float = Field(\n        default=0.9, gt=0, lt=1, description=\"Required probability of detection\"\n    )\n    n_pulses: int = Field(default=1, ge=1, description=\"Number of pulses integrated\")\n    swerling: Literal[0, 1, 2, 3, 4] = Field(\n        default=0, description=\"Swerling target fluctuation model (0 = non-fluctuating)\"\n    )\n    duty_cycle: float = Field(\n        default=1.0, gt=0, le=1, description=\"Transmit duty cycle (avg/peak power ratio)\"\n    )\n    scan_angle_deg: float = Field(\n        default=0.0, ge=0, le=90, description=\"Scan angle from boresight (deg)\"\n    )\n    integration_type: Literal[\"coherent\", \"noncoherent\"] = Field(\n        default=\"noncoherent\", description=\"Integration type\"\n    )\n\n    # Clutter parameters\n    clutter_type: ClutterType = Field(default=\"none\", description=\"Type of clutter environment\")\n    sea_state: int = Field(default=3, ge=0, le=6, description=\"Sea state (0-6 Douglas scale)\")\n    terrain_type: TerrainType = Field(\n        default=\"rural\", description=\"Terrain type for ground clutter\"\n    )\n    rain_rate_mm_hr: float = Field(default=0.0, ge=0, description=\"Rain rate (mm/hour)\")\n    grazing_angle_deg: float | None = Field(\n        default=None,\n        ge=0.1,\n        le=90,\n        description=\"Grazing angle (deg). If None, computed from geometry.\",\n    )\n    antenna_height_m: float = Field(\n        default=10.0, ge=0, description=\"Antenna height above surface (m)\"\n    )\n    target_height_m: float = Field(default=0.0, ge=0, description=\"Target height above surface (m)\")\n    polarization: PolarizationType = Field(default=\"HH\", description=\"Antenna polarization\")\n\n    # CFAR parameters\n    cfar_type: CFARType = Field(default=\"none\", description=\"CFAR detector type\")\n    cfar_ref_cells: int = Field(default=16, ge=2, description=\"Number of CFAR reference cells\")\n    cfar_guard_cells: int = Field(\n        default=2, ge=0, description=\"Number of CFAR guard cells per side\"\n    )\n\n    # Search timeline parameters (all set -> timeline metrics are computed)\n    prf_hz: float | None = Field(\n        default=None, gt=0, description=\"Pulse repetition frequency (Hz); dwell = n_pulses/PRF\"\n    )\n    search_az_extent_deg: float | None = Field(\n        default=None, gt=0, le=360, description=\"Search volume azimuth extent (deg)\"\n    )\n    search_el_extent_deg: float | None = Field(\n        default=None, gt=0, le=90, description=\"Search volume elevation extent (deg)\"\n    )\n    beam_overhead_us: float = Field(\n        default=0.0, ge=0, description=\"Beam-switching overhead per position (us)\"\n    )\n    search_frame_time_ms: float | None = Field(\n        default=None,\n        gt=0,\n        description=\"Allotted search frame budget (ms); sets timeline_occupancy\",\n    )\n\n    # Propagation parameters\n    include_atmos_loss: bool = Field(default=False, description=\"Include atmospheric attenuation\")\n    temperature_c: float = Field(default=15.0, description=\"Ambient temperature (Celsius)\")\n    humidity_pct: float = Field(default=50.0, ge=0, le=100, description=\"Relative humidity (%)\")\n\n    @computed_field  # type: ignore[prop-decorator]\n    @property\n    def wavelength_m(self) -> float:\n        \"\"\"Wavelength in meters.\"\"\"\n        return C_LIGHT / self.freq_hz\n\n    @computed_field  # type: ignore[prop-decorator]\n    @property\n    def target_rcs_m2(self) -> float:\n        \"\"\"Target RCS in square meters.\"\"\"\n        return 10 ** (self.target_rcs_dbsm / 10)\n\n    @computed_field  # type: ignore[prop-decorator]\n    @property\n    def range_resolution_m(self) -> float:\n        \"\"\"Range resolution in meters (c / 2B).\"\"\"\n        return C_LIGHT / (2 * self.bandwidth_hz)\n","numLines":141,"startLine":1,"totalLines":141}}}
