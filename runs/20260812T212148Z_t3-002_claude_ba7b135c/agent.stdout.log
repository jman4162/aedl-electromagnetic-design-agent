{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BfQ2imY7V1Nrjwkgo1ySWP","type":"tool_result","content":"1\t\"\"\"Architecture configuration models using Pydantic.\"\"\"\n2\t\n3\timport math\n4\tfrom typing import Literal\n5\t\n6\tfrom pydantic import BaseModel, Field, field_validator, model_validator\n7\t\n8\t# Valid power-of-two values for sub-array dimensions\n9\tVALID_POWERS_OF_TWO = [2**i for i in range(1, 10)]  # 2, 4, 8, 16, 32, 64, 128, 256, 512\n10\t\n11\t\n12\tdef is_power_of_two(n: int) -> bool:\n13\t    \"\"\"Check if n is a power of two (and >= 2).\"\"\"\n14\t    return n >= 2 and (n & (n - 1)) == 0\n15\t\n16\t\n17\tclass ArrayConfig(BaseModel):\n18\t    \"\"\"Configuration for the antenna array geometry.\n19\t\n20\t    Attributes:\n21\t        geometry: Array geometry type\n22\t        nx: Number of elements in x-direction\n23\t        ny: Number of elements in y-direction\n24\t        dx_lambda: Element spacing in x-direction (wavelengths)\n25\t        dy_lambda: Element spacing in y-direction (wavelengths)\n26\t        scan_limit_deg: Maximum scan angle from boresight (degrees)\n27\t        max_subarray_nx: Maximum elements per sub-array in x (must be power of 2)\n28\t        max_subarray_ny: Maximum elements per sub-array in y (must be power of 2)\n29\t        enforce_subarray_constraint: Whether to enforce power-of-two sub-array constraint\n30\t    \"\"\"\n31\t\n32\t    geometry: Literal[\"rectangular\", \"circular\", \"triangular\"] = \"rectangular\"\n33\t    nx: int = Field(ge=1, description=\"Number of elements in x-direction\")\n34\t    ny: int = Field(ge=1, description=\"Number of elements in y-direction\")\n35\t    dx_lambda: float = Field(default=0.5, gt=0, description=\"Element spacing in x (wavelengths)\")\n36\t    dy_lambda: float = Field(default=0.5, gt=0, description=\"Element spacing in y (wavelengths)\")\n37\t    scan_limit_deg: float = Field(\n38\t        default=60.0, ge=0, le=90, description=\"Maximum scan angle (degrees)\"\n39\t    )\n40\t\n41\t    # Sub-array constraints for practical RF component design (power-of-two)\n42\t    max_subarray_nx: int = Field(\n43\t        default=8, ge=2, description=\"Max elements per sub-array in x (must be power of 2)\"\n44\t    )\n45\t    max_subarray_ny: int = Field(\n46\t        default=8, ge=2, description=\"Max elements per sub-array in y (must be power of 2)\"\n47\t    )\n48\t    enforce_subarray_constraint: bool = Field(\n49\t        default=True, description=\"Enforce power-of-two sub-array constraint\"\n50\t    )\n51\t\n52\t    # Taper configuration\n53\t    taper_type: Literal[\"uniform\", \"taylor\", \"chebyshev\", \"hamming\", \"cosine\", \"gaussian\"] = Field(\n54\t        default=\"uniform\", description=\"Amplitude taper type\"\n55\t    )\n56\t    taper_sll_db: float = Field(\n57\t        default=-30.0, le=-10, description=\"Target SLL for taper (dB, negative)\"\n58\t    )\n59\t\n60\t    # Element pattern configuration\n61\t    element_cos_exp: float = Field(\n62\t        default=1.5, ge=0, description=\"Cosine exponent for element pattern (0=isotropic)\"\n63\t    )\n64\t\n65\t    # Impairments\n66\t    phase_bits: int | None = Field(\n67\t        default=None, ge=1, le=16, description=\"Phase shifter quantization bits (None=ideal)\"\n68\t    )\n69\t\n70\t    @field_validator(\"max_subarray_nx\", \"max_subarray_ny\")\n71\t    @classmethod\n72\t    def validate_power_of_two(cls, v: int) -> int:\n73\t        \"\"\"Validate that max sub-array dimensions are powers of two.\"\"\"\n74\t        if not is_power_of_two(v):\n75\t            raise ValueError(\n76\t                f\"max_subarray value {v} must be a power of 2 (valid values: {VALID_POWERS_OF_TWO})\"\n77\t            )\n78\t        return v\n79\t\n80\t    @model_validator(mode=\"after\")\n81\t    def validate_subarray_constraints(self) -> \"ArrayConfig\":\n82\t        \"\"\"Validate that array dimensions result in power-of-two sub-arrays.\"\"\"\n83\t        if not self.enforce_subarray_constraint:\n84\t            return self\n85\t\n86\t        if self.geometry != \"rectangular\":\n87\t            # Sub-array constraints only apply to rectangular arrays for now\n88\t            return self\n89\t\n90\t        # Check x-direction\n91\t        if self.nx > self.max_subarray_nx:\n92\t            # Must be divisible by max_subarray_nx\n93\t            if self.nx % self.max_subarray_nx != 0:\n94\t                raise ValueError(\n95\t                    f\"nx={self.nx} must be divisible by max_subarray_nx={self.max_subarray_nx} \"\n96\t                    f\"for arrays larger than max sub-array size. \"\n97\t                    f\"Set enforce_subarray_constraint=False to disable.\"\n98\t                )\n99\t        else:\n100\t            # Small array: nx itself must be power of two\n101\t            if not is_power_of_two(self.nx):\n102\t                raise ValueError(\n103\t                    f\"nx={self.nx} must be a power of 2 (2, 4, 8, 16, ...) when \"\n104\t                    f\"enforce_subarray_constraint=True. Valid values: {VALID_POWERS_OF_TWO}\"\n105\t                )\n106\t\n107\t        # Check y-direction\n108\t        if self.ny > self.max_subarray_ny:\n109\t            # Must be divisible by max_subarray_ny\n110\t            if self.ny % self.max_subarray_ny != 0:\n111\t                raise ValueError(\n112\t                    f\"ny={self.ny} must be divisible by max_subarray_ny={self.max_subarray_ny} \"\n113\t                    f\"for arrays larger than max sub-array size. \"\n114\t                    f\"Set enforce_subarray_constraint=False to disable.\"\n115\t                )\n116\t        else:\n117\t            # Small array: ny itself must be power of two\n118\t            if not is_power_of_two(self.ny):\n119\t                raise ValueError(\n120\t                    f\"ny={self.ny} must be a power of 2 (2, 4, 8, 16, ...) when \"\n121\t                    f\"enforce_subarray_constraint=True. Valid values: {VALID_POWERS_OF_TWO}\"\n122\t                )\n123\t\n124\t        return self\n125\t\n126\t    @property\n127\t    def n_elements(self) -> int:\n128\t        \"\"\"Total number of elements in the array.\"\"\"\n129\t        return self.nx * self.ny\n130\t\n131\t    @property\n132\t    def subarray_nx(self) -> int:\n133\t        \"\"\"Actual elements per sub-array in x-direction.\"\"\"\n134\t        if self.nx <= self.max_subarray_nx:\n135\t            return self.nx\n136\t        return self.max_subarray_nx\n137\t\n138\t    @property\n139\t    def subarray_ny(self) -> int:\n140\t        \"\"\"Actual elements per sub-array in y-direction.\"\"\"\n141\t        if self.ny <= self.max_subarray_ny:\n142\t            return self.ny\n143\t        return self.max_subarray_ny\n144\t\n145\t    @property\n146\t    def n_subarrays_x(self) -> int:\n147\t        \"\"\"Number of sub-arrays in x-direction.\"\"\"\n148\t        return math.ceil(self.nx / self.max_subarray_nx)\n149\t\n150\t    @property\n151\t    def n_subarrays_y(self) -> int:\n152\t        \"\"\"Number of sub-arrays in y-direction.\"\"\"\n153\t        return math.ceil(self.ny / self.max_subarray_ny)\n154\t\n155\t    @property\n156\t    def n_subarrays(self) -> int:\n157\t        \"\"\"Total number of sub-arrays.\"\"\"\n158\t        return self.n_subarrays_x * self.n_subarrays_y\n159\t\n160\t    @property\n161\t    def elements_per_subarray(self) -> int:\n162\t        \"\"\"Number of elements per sub-array.\"\"\"\n163\t        return self.subarray_nx * self.subarray_ny\n164\t\n165\t\n166\tclass RFChainConfig(BaseModel):\n167\t    \"\"\"Configuration for the RF chain.\n168\t\n169\t    Attributes:\n170\t        tx_power_w_per_elem: Transmit power per element (Watts)\n171\t        pa_efficiency: Power amplifier efficiency (0-1)\n172\t        noise_figure_db: Receiver noise figure (dB)\n173\t        n_tx_beams: Number of simultaneous transmit beams\n174\t        feed_loss_db: Feed network loss (dB)\n175\t        system_loss_db: Additional system losses (dB)\n176\t    \"\"\"\n177\t\n178\t    tx_power_w_per_elem: float = Field(gt=0, description=\"TX power per element (W)\")\n179\t    rx_power_w_per_elem: float = Field(\n180\t        default=0.0, ge=0, description=\"RX chain DC power per element (LNA, phase shifter, W)\"\n181\t    )\n182\t    pa_efficiency: float = Field(default=0.3, gt=0, le=1, description=\"PA efficiency (0-1)\")\n183\t    noise_figure_db: float = Field(default=3.0, ge=0, description=\"Noise figure (dB)\")\n184\t    n_tx_beams: int = Field(default=1, ge=1, description=\"Number of TX beams\")\n185\t    feed_loss_db: float = Field(default=1.0, ge=0, description=\"Feed network loss (dB)\")\n186\t    system_loss_db: float = Field(default=0.0, ge=0, description=\"Additional system losses (dB)\")\n187\t    rx_stages: list[dict[str, float | str]] | None = Field(\n188\t        default=None,\n189\t        description=\"RX chain stages: list of {name, gain_db, nf_db, iip3_dbm, p1db_dbm}\",\n190\t    )\n191\t    tx_stages: list[dict[str, float | str]] | None = Field(\n192\t        default=None,\n193\t        description=\"TX chain stages (driver to antenna): same shape as rx_stages\",\n194\t    )\n195\t    pa_op1db_dbm_per_elem: float | None = Field(\n196\t        default=None,\n197\t        description=(\n198\t            \"Per-element PA output P1dB (dBm). When set, the delivered \"\n199\t            \"per-element power follows a Rapp soft limiter instead of the \"\n200\t            \"commanded tx_power_w_per_elem; None keeps the linear behavior.\"\n201\t        ),\n202\t    )\n203\t    pa_compression_smoothness: float = Field(\n204\t        default=2.0,\n205\t        gt=0,\n206\t        description=\"Rapp smoothness parameter for the PA compression model\",\n207\t    )\n208\t\n209\t    @field_validator(\"pa_efficiency\")\n210\t    @classmethod\n211\t    def validate_efficiency(cls, v: float) -> float:\n212\t        if not 0 < v <= 1:\n213\t            raise ValueError(\"PA efficiency must be between 0 and 1\")\n214\t        return v\n215\t\n216\t\n217\tclass TRComponent(BaseModel):\n218\t    \"\"\"One component inside a T/R module chain.\n219\t\n220\t    Component names should come from the reliability vocabulary (lna, pa,\n221\t    phase_shifter, attenuator, switch, control_asic) so the same module\n222\t    description feeds RF, power, and reliability models. Passive components\n223\t    carry negative gain; their noise figure equals their loss.\n224\t    \"\"\"\n225\t\n226\t    name: str = Field(description=\"Component name (reliability vocabulary)\")\n227\t    gain_db: float = Field(default=0.0, description=\"Gain (dB, negative for loss)\")\n228\t    noise_figure_db: float = Field(default=0.0, ge=0, description=\"Noise figure (dB)\")\n229\t    p1db_dbm: float = Field(default=100.0, description=\"Input P1dB (dBm; 100 = ideal)\")\n230\t    iip3_dbm: float = Field(default=100.0, description=\"Input IP3 (dBm; 100 = ideal)\")\n231\t    dc_power_w: float = Field(default=0.0, ge=0, description=\"DC power draw (W)\")\n232\t\n233\t\n234\tclass TRModuleConfig(BaseModel):\n235\t    \"\"\"A T/R module described as TX and RX component chains.\n236\t\n237\t    When an Architecture carries a TRModuleConfig, RF-chain aggregates the\n238\t    models consume today (rx_stages/tx_stages, composite noise figure, RX DC\n239\t    power, TX output P1dB) are derived from the chains. Any field set\n240\t    explicitly on the RFChainConfig overrides its derived value.\n241\t\n242\t    Attributes:\n243\t        tx_chain: TX components in signal-flow order (driver to antenna)\n244\t        rx_chain: RX components in signal-flow order (antenna to output)\n245\t        technology: Optional semiconductor technology name (catalog key)\n246\t    \"\"\"\n247\t\n248\t    tx_chain: list[TRComponent] = Field(default_factory=list)\n249\t    rx_chain: list[TRComponent] = Field(default_factory=list)\n250\t    technology: str | None = Field(\n251\t        default=None, description=\"Semiconductor technology (e.g. GaN, SiGe)\"\n252\t    )\n253\t\n254\t    @property\n255\t    def component_names(self) -> set[str]:\n256\t        \"\"\"All component names used across both chains.\"\"\"\n257\t        return {c.name for c in self.tx_chain} | {c.name for c in self.rx_chain}\n258\t\n259\t\n260\tclass CostConfig(BaseModel):\n261\t    \"\"\"Configuration for cost modeling.\n262\t\n263\t    Attributes:\n264\t        cost_per_elem_usd: Recurring cost per element (USD)\n265\t        nre_usd: Non-recurring engineering cost (USD)\n266\t        integration_cost_usd: System integration cost (USD)\n267\t    \"\"\"\n268\t\n269\t    cost_per_elem_usd: float = Field(default=100.0, ge=0, description=\"Cost per element (USD)\")\n270\t    nre_usd: float = Field(default=0.0, ge=0, description=\"NRE cost (USD)\")\n271\t    integration_cost_usd: float = Field(default=0.0, ge=0, description=\"Integration cost (USD)\")\n272\t\n273\t\n274\tclass ReliabilityConfig(BaseModel):\n275\t    \"\"\"Configuration for reliability analysis.\n276\t\n277\t    Attributes:\n278\t        component_mtbfs: Component name -> MTBF hours\n279\t        operating_temp_c: Operating junction temperature (Celsius)\n280\t        mttr_hours: Mean time to repair (hours)\n281\t        mission_hours: Mission duration (hours)\n282\t    \"\"\"\n283\t\n284\t    component_mtbfs: dict[str, float] = Field(\n285\t        default_factory=lambda: {\n286\t            \"lna\": 500_000.0,\n287\t            \"pa\": 250_000.0,\n288\t            \"phase_shifter\": 2_000_000.0,\n289\t            \"attenuator\": 3_000_000.0,\n290\t            \"switch\": 1_000_000.0,\n291\t            \"control_asic\": 1_000_000.0,\n292\t        },\n293\t        description=\"Component name -> MTBF hours\",\n294\t    )\n295\t    operating_temp_c: float = Field(default=85.0, description=\"Operating temperature (C)\")\n296\t    thermal_resistance_c_per_w: float | None = Field(\n297\t        default=None,\n298\t        gt=0,\n299\t        description=(\n300\t            \"Junction-to-ambient thermal resistance per TRM (C/W). When set, \"\n301\t            \"the operating temperature is estimated from dissipated power \"\n302\t            \"instead of the static operating_temp_c value.\"\n303\t        ),\n304\t    )\n305\t    ambient_temp_c: float = Field(\n306\t        default=25.0, description=\"Ambient/coldplate temperature (C) for thermal estimate\"\n307\t    )\n308\t    mttr_hours: float = Field(default=8.0, ge=0, description=\"Mean time to repair (hours)\")\n309\t    mission_hours: float = Field(default=8760.0, gt=0, description=\"Mission duration (hours)\")\n310\t\n311\t\n312\tclass DigitalConfig(BaseModel):\n313\t    \"\"\"Configuration for digital beamformer constraints.\n314\t\n315\t    Attributes:\n316\t        digitization_level: Where digitization happens in the receive chain.\n317\t            \"element\" digitizes every element, \"subarray\" digitizes one channel\n318\t            per sub-array (analog combining within the sub-array), \"analog\"\n319\t            digitizes a single combined channel.\n320\t        adc_enob: ADC effective number of bits (quantization-limited)\n321\t        adc_jitter_ps_rms: ADC aperture jitter (ps RMS); None ignores jitter\n322\t        adc_input_freq_hz: Input frequency for jitter SNR; None uses fs/2\n323\t        oversampling_ratio: ADC oversampling ratio\n324\t        n_beams: Number of simultaneous digital beams\n325\t        fpga_throughput_gops: Available FPGA throughput (GOPS); None=skip margin calc\n326\t        adc_fom_fj: ADC Walden figure of merit (fJ per conversion step)\n327\t        dsp_efficiency_gops_per_w: Beamformer compute efficiency (GOPS/W)\n328\t    \"\"\"\n329\t\n330\t    digitization_level: Literal[\"element\", \"subarray\", \"analog\"] = Field(\n331\t        default=\"element\", description=\"Digitization granularity\"\n332\t    )\n333\t    adc_enob: float = Field(default=12.0, ge=4, le=18, description=\"ADC effective number of bits\")\n334\t    adc_jitter_ps_rms: float | None = Field(\n335\t        default=None, gt=0, description=\"ADC aperture jitter (ps RMS); None=ideal\"\n336\t    )\n337\t    adc_input_freq_hz: float | None = Field(\n338\t        default=None, gt=0, description=\"Input frequency for jitter SNR (Hz); None=fs/2\"\n339\t    )\n340\t    oversampling_ratio: float = Field(default=2.5, ge=2.0, description=\"ADC oversampling ratio\")\n341\t    n_beams: int = Field(default=1, ge=1, description=\"Simultaneous digital beams\")\n342\t    fpga_throughput_gops: float | None = Field(\n343\t        default=None, ge=0, description=\"Available FPGA throughput (GOPS); None=skip margin calc\"\n344\t    )\n345\t    adc_fom_fj: float = Field(\n346\t        default=100.0, gt=0, description=\"ADC Walden FOM (fJ/conversion-step)\"\n347\t    )\n348\t    adc_bits: int | None = Field(\n349\t        default=None,\n350\t        ge=4,\n351\t        le=24,\n352\t        description=(\n353\t            \"Physical ADC bit width for data-rate sizing; None derives \"\n354\t            \"ceil(adc_enob) + 2 (physical bits run 1-3 above ENOB)\"\n355\t        ),\n356\t    )\n357\t    dsp_efficiency_gops_per_w: float = Field(\n358\t        default=50.0, gt=0, description=\"Beamformer compute efficiency (GOPS/W)\"\n359\t    )\n360\t\n361\t    # TX digital path (DAC); None leaves the TX path unmodeled\n362\t    dac_enob: float | None = Field(\n363\t        default=None, ge=4, le=18, description=\"DAC effective number of bits; None=no DAC model\"\n364\t    )\n365\t    dac_fom_fj: float = Field(\n366\t        default=100.0,\n367\t        gt=0,\n368\t        description=\"DAC power figure of merit (fJ/conversion-step, Walden-form estimate)\",\n369\t    )\n370\t    dac_full_scale_dbm: float = Field(default=0.0, description=\"DAC full-scale output power (dBm)\")\n371\t    dac_backoff_db: float = Field(\n372\t        default=6.0, ge=0, description=\"DAC operating backoff from full scale (dB)\"\n373\t    )\n374\t\n375\t    @property\n376\t    def adc_bits_physical(self) -> int:\n377\t        \"\"\"Physical ADC bit width: explicit adc_bits, else ceil(ENOB) + 2.\"\"\"\n378\t        if self.adc_bits is not None:\n379\t            return self.adc_bits\n380\t        return math.ceil(self.adc_enob) + 2\n381\t\n382\t    @property\n383\t    def dac_bits_physical(self) -> int | None:\n384\t        \"\"\"Physical DAC bit width (ceil(ENOB) + 2), None without a DAC.\"\"\"\n385\t        if self.dac_enob is None:\n386\t            return None\n387\t        return math.ceil(self.dac_enob) + 2\n388\t\n389\t\n390\tclass Architecture(BaseModel):\n391\t    \"\"\"Complete system architecture configuration.\n392\t\n393\t    This is the top-level configuration object that contains all\n394\t    subsystem configurations.\n395\t\n396\t    Attributes:\n397\t        array: Antenna array configuration\n398\t        rf: RF chain configuration\n399\t        cost: Cost model configuration\n400\t        name: Optional name for this architecture\n401\t    \"\"\"\n402\t\n403\t    array: ArrayConfig\n404\t    rf: RFChainConfig\n405\t    cost: CostConfig = Field(default_factory=CostConfig)\n406\t    reliability: ReliabilityConfig | None = Field(\n407\t        default=None, description=\"Reliability analysis configuration\"\n408\t    )\n409\t    digital: DigitalConfig | None = Field(\n410\t        default=None, description=\"Digital beamformer configuration\"\n411\t    )\n412\t    trm: TRModuleConfig | None = Field(\n413\t        default=None, description=\"T/R module description (derives RF chain aggregates)\"\n414\t    )\n415\t    name: str | None = Field(default=None, description=\"Architecture name\")\n416\t\n417\t    @model_validator(mode=\"after\")\n418\t    def apply_trm_derivation(self) -> \"Architecture\":\n419\t        \"\"\"Fill RF-chain fields implied by the T/R module description.\n420\t\n421\t        Fields the user set explicitly on the RF chain win over derived\n422\t        values. Without a trm section this is a no-op.\n423\t        \"\"\"\n424\t        if self.trm is None:\n425\t            return self\n426\t        from phased_array_systems.models.rf.trm import (\n427\t            apply_technology_defaults,\n428\t            derive_rf_chain_fields,\n429\t        )\n430\t\n431\t        self.trm = apply_technology_defaults(self.trm)\n432\t        derived = derive_rf_chain_fields(self.trm, self.rf)\n433\t        if derived:\n434\t            self.rf = self.rf.model_copy(update=derived)\n435\t        return self\n436\t\n437\t    @property\n438\t    def n_elements(self) -> int:\n439\t        \"\"\"Total number of elements (convenience property).\"\"\"\n440\t        return self.array.n_elements\n441\t\n442\t    @property\n443\t    def n_digital_channels(self) -> int:\n444\t        \"\"\"Number of digitized receive channels, set by digitization level.\n445\t\n446\t        Returns 0 when no digital configuration is present.\n447\t        \"\"\"\n448\t        if self.digital is None:\n449\t            return 0\n450\t        level = self.digital.digitization_level\n451\t        if level == \"element\":\n452\t            return self.array.n_elements\n453\t        if level == \"subarray\":\n454\t            return self.array.n_subarrays\n455\t        return 1  # analog: single combined channel\n456\t\n457\t    def model_dump_flat(self) -> dict:\n458\t        \"\"\"Return a flattened dictionary of all configuration values.\n459\t\n460\t        Useful for DOE case generation where we need flat parameter names.\n461\t        \"\"\"\n462\t        flat = {}\n463\t        configs: list[tuple[str, BaseModel]] = [\n464\t            (\"array\", self.array),\n465\t            (\"rf\", self.rf),\n466\t            (\"cost\", self.cost),\n467\t        ]\n468\t        if self.reliability is not None:\n469\t            configs.append((\"reliability\", self.reliability))\n470\t        if self.digital is not None:\n471\t            configs.append((\"digital\", self.digital))\n472\t        if self.trm is not None:\n473\t            configs.append((\"trm\", self.trm))\n474\t        for prefix, config in configs:\n475\t            for key, value in config.model_dump().items():\n476\t                flat[f\"{prefix}.{key}\"] = value\n477\t        if self.name:\n478\t            flat[\"name\"] = self.name\n479\t        return flat\n480\t\n481\t    @classmethod\n482\t    def from_flat(cls, flat_dict: dict) -> \"Architecture\":\n483\t        \"\"\"Create an Architecture from a flattened dictionary.\n484\t\n485\t        Args:\n486\t            flat_dict: Dictionary with keys like \"array.nx\", \"rf.tx_power_w_per_elem\"\n487\t\n488\t        Returns:\n489\t            Architecture instance\n490\t        \"\"\"\n491\t        array_dict = {}\n492\t        rf_dict = {}\n493\t        cost_dict = {}\n494\t        reliability_dict = {}\n495\t        digital_dict = {}\n496\t        trm_dict = {}\n497\t        name = None\n498\t\n499\t        for key, value in flat_dict.items():\n500\t            if key == \"name\":\n501\t                name = value\n502\t            elif key.startswith(\"array.\"):\n503\t                array_dict[key.replace(\"array.\", \"\")] = value\n504\t            elif key.startswith(\"rf.\"):\n505\t                rf_dict[key.replace(\"rf.\", \"\")] = value\n506\t            elif key.startswith(\"cost.\"):\n507\t                cost_dict[key.replace(\"cost.\", \"\")] = value\n508\t            elif key.startswith(\"reliability.\"):\n509\t                reliability_dict[key.replace(\"reliability.\", \"\")] = value\n510\t            elif key.startswith(\"digital.\"):\n511\t                digital_dict[key.replace(\"digital.\", \"\")] = value\n512\t            elif key.startswith(\"trm.\"):\n513\t                trm_dict[key.replace(\"trm.\", \"\")] = value\n514\t\n515\t        return cls(\n516\t            array=ArrayConfig(**array_dict),\n517\t            rf=RFChainConfig(**rf_dict),\n518\t            cost=CostConfig(**cost_dict) if cost_dict else CostConfig(),\n519\t            reliability=ReliabilityConfig(**reliability_dict) if reliability_dict else None,\n520\t            digital=DigitalConfig(**digital_dict) if digital_dict else None,\n521\t            trm=TRModuleConfig(**trm_dict) if trm_dict else None,\n522\t            name=name,\n523\t        )\n524\t"}]},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"4ba0f155-8f0d-4173-ac88-a10850ba0976","timestamp":"2026-08-12T21:24:30.928Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/architecture/config.py","content":"\"\"\"Architecture configuration models using Pydantic.\"\"\"\n\nimport math\nfrom typing import Literal\n\nfrom pydantic import BaseModel, Field, field_validator, model_validator\n\n# Valid power-of-two values for sub-array dimensions\nVALID_POWERS_OF_TWO = [2**i for i in range(1, 10)]  # 2, 4, 8, 16, 32, 64, 128, 256, 512\n\n\ndef is_power_of_two(n: int) -> bool:\n    \"\"\"Check if n is a power of two (and >= 2).\"\"\"\n    return n >= 2 and (n & (n - 1)) == 0\n\n\nclass ArrayConfig(BaseModel):\n    \"\"\"Configuration for the antenna array geometry.\n\n    Attributes:\n        geometry: Array geometry type\n        nx: Number of elements in x-direction\n        ny: Number of elements in y-direction\n        dx_lambda: Element spacing in x-direction (wavelengths)\n        dy_lambda: Element spacing in y-direction (wavelengths)\n        scan_limit_deg: Maximum scan angle from boresight (degrees)\n        max_subarray_nx: Maximum elements per sub-array in x (must be power of 2)\n        max_subarray_ny: Maximum elements per sub-array in y (must be power of 2)\n        enforce_subarray_constraint: Whether to enforce power-of-two sub-array constraint\n    \"\"\"\n\n    geometry: Literal[\"rectangular\", \"circular\", \"triangular\"] = \"rectangular\"\n    nx: int = Field(ge=1, description=\"Number of elements in x-direction\")\n    ny: int = Field(ge=1, description=\"Number of elements in y-direction\")\n    dx_lambda: float = Field(default=0.5, gt=0, description=\"Element spacing in x (wavelengths)\")\n    dy_lambda: float = Field(default=0.5, gt=0, description=\"Element spacing in y (wavelengths)\")\n    scan_limit_deg: float = Field(\n        default=60.0, ge=0, le=90, description=\"Maximum scan angle (degrees)\"\n    )\n\n    # Sub-array constraints for practical RF component design (power-of-two)\n    max_subarray_nx: int = Field(\n        default=8, ge=2, description=\"Max elements per sub-array in x (must be power of 2)\"\n    )\n    max_subarray_ny: int = Field(\n        default=8, ge=2, description=\"Max elements per sub-array in y (must be power of 2)\"\n    )\n    enforce_subarray_constraint: bool = Field(\n        default=True, description=\"Enforce power-of-two sub-array constraint\"\n    )\n\n    # Taper configuration\n    taper_type: Literal[\"uniform\", \"taylor\", \"chebyshev\", \"hamming\", \"cosine\", \"gaussian\"] = Field(\n        default=\"uniform\", description=\"Amplitude taper type\"\n    )\n    taper_sll_db: float = Field(\n        default=-30.0, le=-10, description=\"Target SLL for taper (dB, negative)\"\n    )\n\n    # Element pattern configuration\n    element_cos_exp: float = Field(\n        default=1.5, ge=0, description=\"Cosine exponent for element pattern (0=isotropic)\"\n    )\n\n    # Impairments\n    phase_bits: int | None = Field(\n        default=None, ge=1, le=16, description=\"Phase shifter quantization bits (None=ideal)\"\n    )\n\n    @field_validator(\"max_subarray_nx\", \"max_subarray_ny\")\n    @classmethod\n    def validate_power_of_two(cls, v: int) -> int:\n        \"\"\"Validate that max sub-array dimensions are powers of two.\"\"\"\n        if not is_power_of_two(v):\n            raise ValueError(\n                f\"max_subarray value {v} must be a power of 2 (valid values: {VALID_POWERS_OF_TWO})\"\n            )\n        return v\n\n    @model_validator(mode=\"after\")\n    def validate_subarray_constraints(self) -> \"ArrayConfig\":\n        \"\"\"Validate that array dimensions result in power-of-two sub-arrays.\"\"\"\n        if not self.enforce_subarray_constraint:\n            return self\n\n        if self.geometry != \"rectangular\":\n            # Sub-array constraints only apply to rectangular arrays for now\n            return self\n\n        # Check x-direction\n        if self.nx > self.max_subarray_nx:\n            # Must be divisible by max_subarray_nx\n            if self.nx % self.max_subarray_nx != 0:\n                raise ValueError(\n                    f\"nx={self.nx} must be divisible by max_subarray_nx={self.max_subarray_nx} \"\n                    f\"for arrays larger than max sub-array size. \"\n                    f\"Set enforce_subarray_constraint=False to disable.\"\n                )\n        else:\n            # Small array: nx itself must be power of two\n            if not is_power_of_two(self.nx):\n                raise ValueError(\n                    f\"nx={self.nx} must be a power of 2 (2, 4, 8, 16, ...) when \"\n                    f\"enforce_subarray_constraint=True. Valid values: {VALID_POWERS_OF_TWO}\"\n                )\n\n        # Check y-direction\n        if self.ny > self.max_subarray_ny:\n            # Must be divisible by max_subarray_ny\n            if self.ny % self.max_subarray_ny != 0:\n                raise ValueError(\n                    f\"ny={self.ny} must be divisible by max_subarray_ny={self.max_subarray_ny} \"\n                    f\"for arrays larger than max sub-array size. \"\n                    f\"Set enforce_subarray_constraint=False to disable.\"\n                )\n        else:\n            # Small array: ny itself must be power of two\n            if not is_power_of_two(self.ny):\n                raise ValueError(\n                    f\"ny={self.ny} must be a power of 2 (2, 4, 8, 16, ...) when \"\n                    f\"enforce_subarray_constraint=True. Valid values: {VALID_POWERS_OF_TWO}\"\n                )\n\n        return self\n\n    @property\n    def n_elements(self) -> int:\n        \"\"\"Total number of elements in the array.\"\"\"\n        return self.nx * self.ny\n\n    @property\n    def subarray_nx(self) -> int:\n        \"\"\"Actual elements per sub-array in x-direction.\"\"\"\n        if self.nx <= self.max_subarray_nx:\n            return self.nx\n        return self.max_subarray_nx\n\n    @property\n    def subarray_ny(self) -> int:\n        \"\"\"Actual elements per sub-array in y-direction.\"\"\"\n        if self.ny <= self.max_subarray_ny:\n            return self.ny\n        return self.max_subarray_ny\n\n    @property\n    def n_subarrays_x(self) -> int:\n        \"\"\"Number of sub-arrays in x-direction.\"\"\"\n        return math.ceil(self.nx / self.max_subarray_nx)\n\n    @property\n    def n_subarrays_y(self) -> int:\n        \"\"\"Number of sub-arrays in y-direction.\"\"\"\n        return math.ceil(self.ny / self.max_subarray_ny)\n\n    @property\n    def n_subarrays(self) -> int:\n        \"\"\"Total number of sub-arrays.\"\"\"\n        return self.n_subarrays_x * self.n_subarrays_y\n\n    @property\n    def elements_per_subarray(self) -> int:\n        \"\"\"Number of elements per sub-array.\"\"\"\n        return self.subarray_nx * self.subarray_ny\n\n\nclass RFChainConfig(BaseModel):\n    \"\"\"Configuration for the RF chain.\n\n    Attributes:\n        tx_power_w_per_elem: Transmit power per element (Watts)\n        pa_efficiency: Power amplifier efficiency (0-1)\n        noise_figure_db: Receiver noise figure (dB)\n        n_tx_beams: Number of simultaneous transmit beams\n        feed_loss_db: Feed network loss (dB)\n        system_loss_db: Additional system losses (dB)\n    \"\"\"\n\n    tx_power_w_per_elem: float = Field(gt=0, description=\"TX power per element (W)\")\n    rx_power_w_per_elem: float = Field(\n        default=0.0, ge=0, description=\"RX chain DC power per element (LNA, phase shifter, W)\"\n    )\n    pa_efficiency: float = Field(default=0.3, gt=0, le=1, description=\"PA efficiency (0-1)\")\n    noise_figure_db: float = Field(default=3.0, ge=0, description=\"Noise figure (dB)\")\n    n_tx_beams: int = Field(default=1, ge=1, description=\"Number of TX beams\")\n    feed_loss_db: float = Field(default=1.0, ge=0, description=\"Feed network loss (dB)\")\n    system_loss_db: float = Field(default=0.0, ge=0, description=\"Additional system losses (dB)\")\n    rx_stages: list[dict[str, float | str]] | None = Field(\n        default=None,\n        description=\"RX chain stages: list of {name, gain_db, nf_db, iip3_dbm, p1db_dbm}\",\n    )\n    tx_stages: list[dict[str, float | str]] | None = Field(\n        default=None,\n        description=\"TX chain stages (driver to antenna): same shape as rx_stages\",\n    )\n    pa_op1db_dbm_per_elem: float | None = Field(\n        default=None,\n        description=(\n            \"Per-element PA output P1dB (dBm). When set, the delivered \"\n            \"per-element power follows a Rapp soft limiter instead of the \"\n            \"commanded tx_power_w_per_elem; None keeps the linear behavior.\"\n        ),\n    )\n    pa_compression_smoothness: float = Field(\n        default=2.0,\n        gt=0,\n        description=\"Rapp smoothness parameter for the PA compression model\",\n    )\n\n    @field_validator(\"pa_efficiency\")\n    @classmethod\n    def validate_efficiency(cls, v: float) -> float:\n        if not 0 < v <= 1:\n            raise ValueError(\"PA efficiency must be between 0 and 1\")\n        return v\n\n\nclass TRComponent(BaseModel):\n    \"\"\"One component inside a T/R module chain.\n\n    Component names should come from the reliability vocabulary (lna, pa,\n    phase_shifter, attenuator, switch, control_asic) so the same module\n    description feeds RF, power, and reliability models. Passive components\n    carry negative gain; their noise figure equals their loss.\n    \"\"\"\n\n    name: str = Field(description=\"Component name (reliability vocabulary)\")\n    gain_db: float = Field(default=0.0, description=\"Gain (dB, negative for loss)\")\n    noise_figure_db: float = Field(default=0.0, ge=0, description=\"Noise figure (dB)\")\n    p1db_dbm: float = Field(default=100.0, description=\"Input P1dB (dBm; 100 = ideal)\")\n    iip3_dbm: float = Field(default=100.0, description=\"Input IP3 (dBm; 100 = ideal)\")\n    dc_power_w: float = Field(default=0.0, ge=0, description=\"DC power draw (W)\")\n\n\nclass TRModuleConfig(BaseModel):\n    \"\"\"A T/R module described as TX and RX component chains.\n\n    When an Architecture carries a TRModuleConfig, RF-chain aggregates the\n    models consume today (rx_stages/tx_stages, composite noise figure, RX DC\n    power, TX output P1dB) are derived from the chains. Any field set\n    explicitly on the RFChainConfig overrides its derived value.\n\n    Attributes:\n        tx_chain: TX components in signal-flow order (driver to antenna)\n        rx_chain: RX components in signal-flow order (antenna to output)\n        technology: Optional semiconductor technology name (catalog key)\n    \"\"\"\n\n    tx_chain: list[TRComponent] = Field(default_factory=list)\n    rx_chain: list[TRComponent] = Field(default_factory=list)\n    technology: str | None = Field(\n        default=None, description=\"Semiconductor technology (e.g. GaN, SiGe)\"\n    )\n\n    @property\n    def component_names(self) -> set[str]:\n        \"\"\"All component names used across both chains.\"\"\"\n        return {c.name for c in self.tx_chain} | {c.name for c in self.rx_chain}\n\n\nclass CostConfig(BaseModel):\n    \"\"\"Configuration for cost modeling.\n\n    Attributes:\n        cost_per_elem_usd: Recurring cost per element (USD)\n        nre_usd: Non-recurring engineering cost (USD)\n        integration_cost_usd: System integration cost (USD)\n    \"\"\"\n\n    cost_per_elem_usd: float = Field(default=100.0, ge=0, description=\"Cost per element (USD)\")\n    nre_usd: float = Field(default=0.0, ge=0, description=\"NRE cost (USD)\")\n    integration_cost_usd: float = Field(default=0.0, ge=0, description=\"Integration cost (USD)\")\n\n\nclass ReliabilityConfig(BaseModel):\n    \"\"\"Configuration for reliability analysis.\n\n    Attributes:\n        component_mtbfs: Component name -> MTBF hours\n        operating_temp_c: Operating junction temperature (Celsius)\n        mttr_hours: Mean time to repair (hours)\n        mission_hours: Mission duration (hours)\n    \"\"\"\n\n    component_mtbfs: dict[str, float] = Field(\n        default_factory=lambda: {\n            \"lna\": 500_000.0,\n            \"pa\": 250_000.0,\n            \"phase_shifter\": 2_000_000.0,\n            \"attenuator\": 3_000_000.0,\n            \"switch\": 1_000_000.0,\n            \"control_asic\": 1_000_000.0,\n        },\n        description=\"Component name -> MTBF hours\",\n    )\n    operating_temp_c: float = Field(default=85.0, description=\"Operating temperature (C)\")\n    thermal_resistance_c_per_w: float | None = Field(\n        default=None,\n        gt=0,\n        description=(\n            \"Junction-to-ambient thermal resistance per TRM (C/W). When set, \"\n            \"the operating temperature is estimated from dissipated power \"\n            \"instead of the static operating_temp_c value.\"\n        ),\n    )\n    ambient_temp_c: float = Field(\n        default=25.0, description=\"Ambient/coldplate temperature (C) for thermal estimate\"\n    )\n    mttr_hours: float = Field(default=8.0, ge=0, description=\"Mean time to repair (hours)\")\n    mission_hours: float = Field(default=8760.0, gt=0, description=\"Mission duration (hours)\")\n\n\nclass DigitalConfig(BaseModel):\n    \"\"\"Configuration for digital beamformer constraints.\n\n    Attributes:\n        digitization_level: Where digitization happens in the receive chain.\n            \"element\" digitizes every element, \"subarray\" digitizes one channel\n            per sub-array (analog combining within the sub-array), \"analog\"\n            digitizes a single combined channel.\n        adc_enob: ADC effective number of bits (quantization-limited)\n        adc_jitter_ps_rms: ADC aperture jitter (ps RMS); None ignores jitter\n        adc_input_freq_hz: Input frequency for jitter SNR; None uses fs/2\n        oversampling_ratio: ADC oversampling ratio\n        n_beams: Number of simultaneous digital beams\n        fpga_throughput_gops: Available FPGA throughput (GOPS); None=skip margin calc\n        adc_fom_fj: ADC Walden figure of merit (fJ per conversion step)\n        dsp_efficiency_gops_per_w: Beamformer compute efficiency (GOPS/W)\n    \"\"\"\n\n    digitization_level: Literal[\"element\", \"subarray\", \"analog\"] = Field(\n        default=\"element\", description=\"Digitization granularity\"\n    )\n    adc_enob: float = Field(default=12.0, ge=4, le=18, description=\"ADC effective number of bits\")\n    adc_jitter_ps_rms: float | None = Field(\n        default=None, gt=0, description=\"ADC aperture jitter (ps RMS); None=ideal\"\n    )\n    adc_input_freq_hz: float | None = Field(\n        default=None, gt=0, description=\"Input frequency for jitter SNR (Hz); None=fs/2\"\n    )\n    oversampling_ratio: float = Field(default=2.5, ge=2.0, description=\"ADC oversampling ratio\")\n    n_beams: int = Field(default=1, ge=1, description=\"Simultaneous digital beams\")\n    fpga_throughput_gops: float | None = Field(\n        default=None, ge=0, description=\"Available FPGA throughput (GOPS); None=skip margin calc\"\n    )\n    adc_fom_fj: float = Field(\n        default=100.0, gt=0, description=\"ADC Walden FOM (fJ/conversion-step)\"\n    )\n    adc_bits: int | None = Field(\n        default=None,\n        ge=4,\n        le=24,\n        description=(\n            \"Physical ADC bit width for data-rate sizing; None derives \"\n            \"ceil(adc_enob) + 2 (physical bits run 1-3 above ENOB)\"\n        ),\n    )\n    dsp_efficiency_gops_per_w: float = Field(\n        default=50.0, gt=0, description=\"Beamformer compute efficiency (GOPS/W)\"\n    )\n\n    # TX digital path (DAC); None leaves the TX path unmodeled\n    dac_enob: float | None = Field(\n        default=None, ge=4, le=18, description=\"DAC effective number of bits; None=no DAC model\"\n    )\n    dac_fom_fj: float = Field(\n        default=100.0,\n        gt=0,\n        description=\"DAC power figure of merit (fJ/conversion-step, Walden-form estimate)\",\n    )\n    dac_full_scale_dbm: float = Field(default=0.0, description=\"DAC full-scale output power (dBm)\")\n    dac_backoff_db: float = Field(\n        default=6.0, ge=0, description=\"DAC operating backoff from full scale (dB)\"\n    )\n\n    @property\n    def adc_bits_physical(self) -> int:\n        \"\"\"Physical ADC bit width: explicit adc_bits, else ceil(ENOB) + 2.\"\"\"\n        if self.adc_bits is not None:\n            return self.adc_bits\n        return math.ceil(self.adc_enob) + 2\n\n    @property\n    def dac_bits_physical(self) -> int | None:\n        \"\"\"Physical DAC bit width (ceil(ENOB) + 2), None without a DAC.\"\"\"\n        if self.dac_enob is None:\n            return None\n        return math.ceil(self.dac_enob) + 2\n\n\nclass Architecture(BaseModel):\n    \"\"\"Complete system architecture configuration.\n\n    This is the top-level configuration object that contains all\n    subsystem configurations.\n\n    Attributes:\n        array: Antenna array configuration\n        rf: RF chain configuration\n        cost: Cost model configuration\n        name: Optional name for this architecture\n    \"\"\"\n\n    array: ArrayConfig\n    rf: RFChainConfig\n    cost: CostConfig = Field(default_factory=CostConfig)\n    reliability: ReliabilityConfig | None = Field(\n        default=None, description=\"Reliability analysis configuration\"\n    )\n    digital: DigitalConfig | None = Field(\n        default=None, description=\"Digital beamformer configuration\"\n    )\n    trm: TRModuleConfig | None = Field(\n        default=None, description=\"T/R module description (derives RF chain aggregates)\"\n    )\n    name: str | None = Field(default=None, description=\"Architecture name\")\n\n    @model_validator(mode=\"after\")\n    def apply_trm_derivation(self) -> \"Architecture\":\n        \"\"\"Fill RF-chain fields implied by the T/R module description.\n\n        Fields the user set explicitly on the RF chain win over derived\n        values. Without a trm section this is a no-op.\n        \"\"\"\n        if self.trm is None:\n            return self\n        from phased_array_systems.models.rf.trm import (\n            apply_technology_defaults,\n            derive_rf_chain_fields,\n        )\n\n        self.trm = apply_technology_defaults(self.trm)\n        derived = derive_rf_chain_fields(self.trm, self.rf)\n        if derived:\n            self.rf = self.rf.model_copy(update=derived)\n        return self\n\n    @property\n    def n_elements(self) -> int:\n        \"\"\"Total number of elements (convenience property).\"\"\"\n        return self.array.n_elements\n\n    @property\n    def n_digital_channels(self) -> int:\n        \"\"\"Number of digitized receive channels, set by digitization level.\n\n        Returns 0 when no digital configuration is present.\n        \"\"\"\n        if self.digital is None:\n            return 0\n        level = self.digital.digitization_level\n        if level == \"element\":\n            return self.array.n_elements\n        if level == \"subarray\":\n            return self.array.n_subarrays\n        return 1  # analog: single combined channel\n\n    def model_dump_flat(self) -> dict:\n        \"\"\"Return a flattened dictionary of all configuration values.\n\n        Useful for DOE case generation where we need flat parameter names.\n        \"\"\"\n        flat = {}\n        configs: list[tuple[str, BaseModel]] = [\n            (\"array\", self.array),\n            (\"rf\", self.rf),\n            (\"cost\", self.cost),\n        ]\n        if self.reliability is not None:\n            configs.append((\"reliability\", self.reliability))\n        if self.digital is not None:\n            configs.append((\"digital\", self.digital))\n        if self.trm is not None:\n            configs.append((\"trm\", self.trm))\n        for prefix, config in configs:\n            for key, value in config.model_dump().items():\n                flat[f\"{prefix}.{key}\"] = value\n        if self.name:\n            flat[\"name\"] = self.name\n        return flat\n\n    @classmethod\n    def from_flat(cls, flat_dict: dict) -> \"Architecture\":\n        \"\"\"Create an Architecture from a flattened dictionary.\n\n        Args:\n            flat_dict: Dictionary with keys like \"array.nx\", \"rf.tx_power_w_per_elem\"\n\n        Returns:\n            Architecture instance\n        \"\"\"\n        array_dict = {}\n        rf_dict = {}\n        cost_dict = {}\n        reliability_dict = {}\n        digital_dict = {}\n        trm_dict = {}\n        name = None\n\n        for key, value in flat_dict.items():\n            if key == \"name\":\n                name = value\n            elif key.startswith(\"array.\"):\n                array_dict[key.replace(\"array.\", \"\")] = value\n            elif key.startswith(\"rf.\"):\n                rf_dict[key.replace(\"rf.\", \"\")] = value\n            elif key.startswith(\"cost.\"):\n                cost_dict[key.replace(\"cost.\", \"\")] = value\n            elif key.startswith(\"reliability.\"):\n                reliability_dict[key.replace(\"reliability.\", \"\")] = value\n            elif key.startswith(\"digital.\"):\n                digital_dict[key.replace(\"digital.\", \"\")] = value\n            elif key.startswith(\"trm.\"):\n                trm_dict[key.replace(\"trm.\", \"\")] = value\n\n        return cls(\n            array=ArrayConfig(**array_dict),\n            rf=RFChainConfig(**rf_dict),\n            cost=CostConfig(**cost_dict) if cost_dict else CostConfig(),\n            reliability=ReliabilityConfig(**reliability_dict) if reliability_dict else None,\n            digital=DigitalConfig(**digital_dict) if digital_dict else None,\n            trm=TRModuleConfig(**trm_dict) if trm_dict else None,\n            name=name,\n        )\n","numLines":524,"startLine":1,"totalLines":524}}}
