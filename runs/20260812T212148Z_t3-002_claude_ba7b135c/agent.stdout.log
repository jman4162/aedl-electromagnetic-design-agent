{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CdyZUxsuEyimD3mASQoMQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016RJ7VXpKF5GKduYmUHSvGE","name":"Read","input":{"file_path":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/models/antenna/adapter.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1343,"cache_read_input_tokens":75104,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1343},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"aeb138bf-6629-4440-9292-83695a725fbb","timestamp":"2026-08-12T21:25:49.423Z","request_id":"req_011CdyZUx4YCNMGGsx68Ar8F"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016RJ7VXpKF5GKduYmUHSvGE","type":"tool_result","content":"1\t\"\"\"Adapter wrapping phased-array-modeling for consistent metric extraction.\"\"\"\n2\t\n3\timport logging\n4\tfrom typing import Any, cast\n5\t\n6\timport numpy as np\n7\t\n8\tfrom phased_array_systems.architecture import Architecture\n9\tfrom phased_array_systems.models.antenna.errors import (\n10\t    phase_quantization_loss_db,\n11\t    phase_quantization_rms_rad,\n12\t    rms_sidelobe_floor_db,\n13\t)\n14\tfrom phased_array_systems.models.antenna.metrics import (\n15\t    compute_beamwidth,\n16\t    compute_directivity_rectangular,\n17\t    compute_scan_loss,\n18\t    compute_sidelobe_level,\n19\t)\n20\tfrom phased_array_systems.models.antenna.taper import (\n21\t    TaperType,\n22\t    generate_taper_weights,\n23\t)\n24\tfrom phased_array_systems.models.antenna.taper import (\n25\t    compute_taper_efficiency as _local_taper_efficiency,\n26\t)\n27\tfrom phased_array_systems.types import MetricsDict, Scenario\n28\t\n29\tlogger = logging.getLogger(__name__)\n30\t\n31\t# Try to import phased-array-modeling (actual package name: phased_array)\n32\ttry:\n33\t    from phased_array import (\n34\t        chebyshev_taper_2d,\n35\t        compute_taper_efficiency,\n36\t        cosine_taper_2d,\n37\t        create_rectangular_array,\n38\t        element_pattern,\n39\t        gaussian_taper_2d,\n40\t        hamming_taper_2d,\n41\t        quantize_phase,\n42\t        simulate_element_failures,\n43\t        steering_vector,\n44\t        taylor_taper_2d,\n45\t        total_pattern,\n46\t    )\n47\t\n48\t    HAS_PAM = True\n49\texcept ImportError:\n50\t    HAS_PAM = False\n51\t\n52\t\n53\tdef _build_taper_weights(taper_type: str, nx: int, ny: int, sll_db: float) -> np.ndarray:\n54\t    \"\"\"Build 2D taper weights array.\n55\t\n56\t    Args:\n57\t        taper_type: Taper type name\n58\t        nx: Number of elements in x\n59\t        ny: Number of elements in y\n60\t        sll_db: Target sidelobe level (dB, negative) for taylor/chebyshev\n61\t\n62\t    Returns:\n63\t        1D array of taper weights (length nx*ny)\n64\t    \"\"\"\n65\t    if taper_type == \"uniform\":\n66\t        return np.ones(nx * ny)\n67\t    elif taper_type == \"taylor\":\n68\t        return np.asarray(taylor_taper_2d(nx, ny, sidelobe_dB=sll_db)).ravel()\n69\t    elif taper_type == \"chebyshev\":\n70\t        return np.asarray(chebyshev_taper_2d(nx, ny, sidelobe_dB=sll_db)).ravel()\n71\t    elif taper_type == \"hamming\":\n72\t        return np.asarray(hamming_taper_2d(nx, ny)).ravel()\n73\t    elif taper_type == \"cosine\":\n74\t        return np.asarray(cosine_taper_2d(nx, ny)).ravel()\n75\t    elif taper_type == \"gaussian\":\n76\t        return np.asarray(gaussian_taper_2d(nx, ny)).ravel()\n77\t    else:\n78\t        logger.warning(\"Unknown taper type '%s', using uniform\", taper_type)\n79\t        return np.ones(nx * ny)\n80\t\n81\t\n82\tclass PhasedArrayAdapter:\n83\t    \"\"\"Adapter for phased-array-modeling library.\n84\t\n85\t    Provides a consistent interface for computing antenna pattern metrics\n86\t    using the phased-array-modeling library, with fallback to analytical\n87\t    approximations when the library is not available.\n88\t\n89\t    Attributes:\n90\t        name: Model block name for identification\n91\t        use_analytical_fallback: If True, use analytical approximations\n92\t            when phased-array-modeling is not available\n93\t    \"\"\"\n94\t\n95\t    name: str = \"antenna\"\n96\t\n97\t    def __init__(self, use_analytical_fallback: bool = True):\n98\t        \"\"\"Initialize the adapter.\n99\t\n100\t        Args:\n101\t            use_analytical_fallback: Use analytical methods if PAM unavailable\n102\t        \"\"\"\n103\t        self.use_analytical_fallback = use_analytical_fallback\n104\t\n105\t        if not HAS_PAM and not use_analytical_fallback:\n106\t            raise ImportError(\n107\t                \"phased-array-modeling not installed. Install with: \"\n108\t                \"pip install phased-array-modeling\"\n109\t            )\n110\t\n111\t    def evaluate(\n112\t        self, arch: Architecture, scenario: Scenario, context: dict[str, Any]\n113\t    ) -> MetricsDict:\n114\t        \"\"\"Evaluate antenna performance metrics.\n115\t\n116\t        Args:\n117\t            arch: Architecture configuration\n118\t            scenario: Scenario with frequency and scan angle info\n119\t            context: Additional context (may contain failure_rate for degradation)\n120\t\n121\t        Returns:\n122\t            Dictionary with antenna metrics\n123\t        \"\"\"\n124\t        scan_angle_deg = getattr(scenario, \"scan_angle_deg\", 0.0)\n125\t\n126\t        if HAS_PAM:\n127\t            return self._evaluate_with_pam(arch, scenario, scan_angle_deg, context)\n128\t        else:\n129\t            return self._evaluate_analytical(arch, scenario, scan_angle_deg)\n130\t\n131\t    def _evaluate_with_pam(\n132\t        self,\n133\t        arch: Architecture,\n134\t        scenario: Scenario,\n135\t        scan_angle_deg: float,\n136\t        context: dict[str, Any],\n137\t    ) -> MetricsDict:\n138\t        \"\"\"Evaluate using phased-array-modeling library.\"\"\"\n139\t        wavelength_m = scenario.wavelength_m if hasattr(scenario, \"wavelength_m\") else None\n140\t\n141\t        if wavelength_m is None:\n142\t            from phased_array_systems.constants import C\n143\t\n144\t            wavelength_m = C / scenario.freq_hz\n145\t\n146\t        nx = arch.array.nx\n147\t        ny = arch.array.ny\n148\t\n149\t        # 1. Create array geometry (dx/dy are in wavelengths, library converts to meters)\n150\t        geom = create_rectangular_array(\n151\t            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda, wavelength=wavelength_m\n152\t        )\n153\t        k = 2 * np.pi / wavelength_m\n154\t\n155\t        # 2. Build taper weights\n156\t        taper_type = getattr(arch.array, \"taper_type\", \"uniform\")\n157\t        taper_sll_db = getattr(arch.array, \"taper_sll_db\", -30.0)\n158\t        taper_weights = _build_taper_weights(taper_type, nx, ny, taper_sll_db)\n159\t\n160\t        # Compute taper efficiency\n161\t        taper_eff = compute_taper_efficiency(taper_weights)\n162\t        taper_loss_db = -10 * np.log10(taper_eff) if taper_eff > 0 else 0.0\n163\t\n164\t        # 3. Apply steering vector\n165\t        scan_phi_deg = 0.0  # Azimuth plane scan\n166\t        sv = steering_vector(k, geom.x, geom.y, scan_angle_deg, scan_phi_deg)\n167\t        weights = taper_weights * sv\n168\t\n169\t        # 4. Apply impairments pipeline\n170\t        phase_bits = getattr(arch.array, \"phase_bits\", None)\n171\t        quantization_applied = False\n172\t        if phase_bits is not None:\n173\t            weights = quantize_phase(weights, n_bits=phase_bits)\n174\t            quantization_applied = True\n175\t\n176\t        failure_rate = context.get(\"failure_rate\", 0.0)\n177\t        n_failed = 0\n178\t        if failure_rate > 0:\n179\t            seed = context.get(\"meta.seed\")\n180\t            weights, fail_mask = simulate_element_failures(weights, failure_rate, seed=seed)\n181\t            # The library's mask is True for FAILED elements; counting the\n182\t            # zeros counted the survivors (251 \"failures\" out of 256 at a 2%\n183\t            # rate).\n184\t            n_failed = int(np.sum(fail_mask))\n185\t\n186\t        # 5. Compute patterns using total_pattern (includes element pattern)\n187\t        theta_deg = np.linspace(-90, 90, 721)\n188\t        theta_rad = np.radians(theta_deg)\n189\t\n190\t        element_cos_exp = getattr(arch.array, \"element_cos_exp\", 1.5)\n191\t\n192\t        # Azimuth cut (phi=0)\n193\t        phi_az = np.zeros_like(theta_rad)\n194\t        tp_az = total_pattern(\n195\t            theta_rad,\n196\t            phi_az,\n197\t            geom.x,\n198\t            geom.y,\n199\t            weights,\n200\t            k,\n201\t            element_pattern_func=element_pattern,\n202\t            cos_exp_theta=element_cos_exp,\n203\t        )\n204\t        tp_az_db = 20 * np.log10(np.abs(tp_az) + 1e-12)\n205\t        tp_az_db = tp_az_db - np.max(tp_az_db)  # Normalize to peak\n206\t\n207\t        # Elevation cut (phi=90)\n208\t        phi_el = np.full_like(theta_rad, np.pi / 2)\n209\t        tp_el = total_pattern(\n210\t            theta_rad,\n211\t            phi_el,\n212\t            geom.x,\n213\t            geom.y,\n214\t            weights,\n215\t            k,\n216\t            element_pattern_func=element_pattern,\n217\t            cos_exp_theta=element_cos_exp,\n218\t        )\n219\t        tp_el_db = 20 * np.log10(np.abs(tp_el) + 1e-12)\n220\t        tp_el_db = tp_el_db - np.max(tp_el_db)\n221\t\n222\t        # 6. Extract metrics from computed patterns\n223\t        beamwidth_az = compute_beamwidth(tp_az_db, theta_deg)\n224\t        beamwidth_el = compute_beamwidth(tp_el_db, theta_deg)\n225\t        sll = compute_sidelobe_level(tp_az_db, theta_deg)\n226\t        scan_loss = compute_scan_loss(scan_angle_deg)\n227\t        directivity = compute_directivity_rectangular(\n228\t            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda\n229\t        )\n230\t        # Quantization is simulated in the pattern, but g_peak is assembled\n231\t        # analytically, so the quantization gain loss must be subtracted here\n232\t        quant_loss_db = phase_quantization_loss_db(phase_bits) if phase_bits else 0.0\n233\t        g_peak = directivity - scan_loss - taper_loss_db - quant_loss_db\n234\t\n235\t        # 7. Grating lobe check\n236\t        from phased_array_systems.models.antenna.grating import check_grating_lobes\n237\t\n238\t        grating_info = check_grating_lobes(\n239\t            arch.array.dx_lambda, arch.array.dy_lambda, arch.array.scan_limit_deg\n240\t        )\n241\t        if grating_info[\"grating_lobe_risk\"]:\n242\t            logger.warning(\n243\t                \"Grating lobe risk detected: dx=%.2f, dy=%.2f lambda, \"\n244\t                \"max safe spacing=%.3f lambda at scan_limit=%.1f deg\",\n245\t                arch.array.dx_lambda,\n246\t                arch.array.dy_lambda,\n247\t                grating_info[\"max_safe_spacing_lambda\"],\n248\t                arch.array.scan_limit_deg,\n249\t            )\n250\t\n251\t        metrics: MetricsDict = {\n252\t            \"g_peak_db\": g_peak,\n253\t            \"beamwidth_az_deg\": beamwidth_az,\n254\t            \"beamwidth_el_deg\": beamwidth_el,\n255\t            \"sll_db\": sll,\n256\t            \"scan_loss_db\": scan_loss,\n257\t            \"directivity_db\": directivity,\n258\t            \"n_elements\": arch.array.n_elements,\n259\t            \"taper_type\": taper_type,\n260\t            \"taper_efficiency\": taper_eff,\n261\t            \"taper_loss_db\": taper_loss_db,\n262\t            \"element_pattern_applied\": True,\n263\t            \"element_cos_exp\": element_cos_exp,\n264\t            \"grating_lobe_risk\": grating_info[\"grating_lobe_risk\"],\n265\t            \"max_safe_spacing_lambda\": grating_info[\"max_safe_spacing_lambda\"],\n266\t        }\n267\t\n268\t        if quantization_applied and phase_bits is not None:\n269\t            metrics[\"phase_quantization_bits\"] = phase_bits\n270\t            metrics[\"phase_quantization_loss_db\"] = quant_loss_db\n271\t            metrics[\"rms_sidelobe_floor_db\"] = rms_sidelobe_floor_db(\n272\t                phase_quantization_rms_rad(phase_bits) ** 2,\n273\t                arch.array.n_elements,\n274\t                taper_eff,\n275\t            )\n276\t\n277\t        if failure_rate > 0:\n278\t            metrics[\"n_failed_elements\"] = n_failed\n279\t            metrics[\"failure_rate\"] = failure_rate\n280\t\n281\t        return metrics\n282\t\n283\t    # Approximate first-sidelobe design levels for fixed-shape windows\n284\t    # (uniform: sinc theory; hamming/cosine/gaussian: window first SLL)\n285\t    _DESIGN_SLL_DB = {\n286\t        \"uniform\": -13.2,\n287\t        \"hamming\": -42.7,\n288\t        \"cosine\": -23.0,\n289\t        \"gaussian\": -55.0,\n290\t    }\n291\t\n292\t    def _evaluate_analytical(\n293\t        self, arch: Architecture, scenario: Scenario, scan_angle_deg: float\n294\t    ) -> MetricsDict:\n295\t        \"\"\"Evaluate using analytical approximations.\n296\t\n297\t        Uses standard phased array formulas when the full simulation\n298\t        library is not available. Emits the same metric key set as the\n299\t        pattern-based path so downstream models and requirements behave\n300\t        identically in both modes.\n301\t        \"\"\"\n302\t        nx, ny = arch.array.nx, arch.array.ny\n303\t\n304\t        # Taper from real window functions (separable 2-D outer product)\n305\t        taper_type = cast(TaperType, getattr(arch.array, \"taper_type\", \"uniform\"))\n306\t        taper_sll_db = getattr(arch.array, \"taper_sll_db\", -30.0)\n307\t        wx = generate_taper_weights(taper_type, nx, taper_sll_db)\n308\t        wy = generate_taper_weights(taper_type, ny, taper_sll_db)\n309\t        weights_2d = np.outer(wx, wy).ravel()\n310\t        taper_eff = _local_taper_efficiency(weights_2d)\n311\t        taper_loss_db = -10 * np.log10(taper_eff) if taper_eff > 0 else 0.0\n312\t\n313\t        # Directivity from aperture size\n314\t        directivity_db = compute_directivity_rectangular(\n315\t            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda\n316\t        )\n317\t\n318\t        # Scan loss\n319\t        scan_loss = compute_scan_loss(scan_angle_deg)\n320\t\n321\t        # Phase-shifter quantization loss (analytic Ruze form)\n322\t        phase_bits = getattr(arch.array, \"phase_bits\", None)\n323\t        quant_loss_db = phase_quantization_loss_db(phase_bits) if phase_bits else 0.0\n324\t\n325\t        # Peak gain\n326\t        g_peak = directivity_db - scan_loss - taper_loss_db - quant_loss_db\n327\t\n328\t        # Beamwidth approximations for a rectangular array\n329\t        # BW ≈ 0.886 / (N * d_lambda) radians (uniform-taper form; tapers\n330\t        # broaden this slightly, not modeled here)\n331\t        beamwidth_az_deg = np.degrees(0.886 / (nx * arch.array.dx_lambda))\n332\t        beamwidth_el_deg = np.degrees(0.886 / (ny * arch.array.dy_lambda))\n333\t\n334\t        # Sidelobe level: taper design SLL, floored by the RMS error\n335\t        # sidelobe floor when quantization is present\n336\t        if taper_type in (\"taylor\", \"chebyshev\"):\n337\t            design_sll = taper_sll_db\n338\t        else:\n339\t            design_sll = self._DESIGN_SLL_DB.get(taper_type, -13.2)\n340\t        if phase_bits:\n341\t            error_floor = rms_sidelobe_floor_db(\n342\t                phase_quantization_rms_rad(phase_bits) ** 2,\n343\t                arch.array.n_elements,\n344\t                taper_eff,\n345\t            )\n346\t            sll_db = max(design_sll, error_floor)\n347\t        else:\n348\t            sll_db = design_sll\n349\t\n350\t        # Grating lobe check (same as the pattern-based path)\n351\t        from phased_array_systems.models.antenna.grating import check_grating_lobes\n352\t\n353\t        grating_info = check_grating_lobes(\n354\t            arch.array.dx_lambda, arch.array.dy_lambda, arch.array.scan_limit_deg\n355\t        )\n356\t\n357\t        metrics: MetricsDict = {\n358\t            \"g_peak_db\": g_peak,\n359\t            \"beamwidth_az_deg\": beamwidth_az_deg,\n360\t            \"beamwidth_el_deg\": beamwidth_el_deg,\n361\t            \"sll_db\": sll_db,\n362\t            \"scan_loss_db\": scan_loss,\n363\t            \"directivity_db\": directivity_db,\n364\t            \"n_elements\": arch.array.n_elements,\n365\t            \"taper_type\": taper_type,\n366\t            \"taper_efficiency\": taper_eff,\n367\t            \"taper_loss_db\": taper_loss_db,\n368\t            \"element_pattern_applied\": False,\n369\t            \"element_cos_exp\": getattr(arch.array, \"element_cos_exp\", 1.5),\n370\t            \"grating_lobe_risk\": grating_info[\"grating_lobe_risk\"],\n371\t            \"max_safe_spacing_lambda\": grating_info[\"max_safe_spacing_lambda\"],\n372\t        }\n373\t\n374\t        if phase_bits:\n375\t            metrics[\"phase_quantization_bits\"] = phase_bits\n376\t            metrics[\"phase_quantization_loss_db\"] = quant_loss_db\n377\t            metrics[\"rms_sidelobe_floor_db\"] = rms_sidelobe_floor_db(\n378\t                phase_quantization_rms_rad(phase_bits) ** 2,\n379\t                arch.array.n_elements,\n380\t                taper_eff,\n381\t            )\n382\t\n383\t        return metrics\n384\t"}]},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"f56f44a0-4f0a-44e8-9ecf-9513a3cf56a2","timestamp":"2026-08-12T21:25:49.428Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/models/antenna/adapter.py","content":"\"\"\"Adapter wrapping phased-array-modeling for consistent metric extraction.\"\"\"\n\nimport logging\nfrom typing import Any, cast\n\nimport numpy as np\n\nfrom phased_array_systems.architecture import Architecture\nfrom phased_array_systems.models.antenna.errors import (\n    phase_quantization_loss_db,\n    phase_quantization_rms_rad,\n    rms_sidelobe_floor_db,\n)\nfrom phased_array_systems.models.antenna.metrics import (\n    compute_beamwidth,\n    compute_directivity_rectangular,\n    compute_scan_loss,\n    compute_sidelobe_level,\n)\nfrom phased_array_systems.models.antenna.taper import (\n    TaperType,\n    generate_taper_weights,\n)\nfrom phased_array_systems.models.antenna.taper import (\n    compute_taper_efficiency as _local_taper_efficiency,\n)\nfrom phased_array_systems.types import MetricsDict, Scenario\n\nlogger = logging.getLogger(__name__)\n\n# Try to import phased-array-modeling (actual package name: phased_array)\ntry:\n    from phased_array import (\n        chebyshev_taper_2d,\n        compute_taper_efficiency,\n        cosine_taper_2d,\n        create_rectangular_array,\n        element_pattern,\n        gaussian_taper_2d,\n        hamming_taper_2d,\n        quantize_phase,\n        simulate_element_failures,\n        steering_vector,\n        taylor_taper_2d,\n        total_pattern,\n    )\n\n    HAS_PAM = True\nexcept ImportError:\n    HAS_PAM = False\n\n\ndef _build_taper_weights(taper_type: str, nx: int, ny: int, sll_db: float) -> np.ndarray:\n    \"\"\"Build 2D taper weights array.\n\n    Args:\n        taper_type: Taper type name\n        nx: Number of elements in x\n        ny: Number of elements in y\n        sll_db: Target sidelobe level (dB, negative) for taylor/chebyshev\n\n    Returns:\n        1D array of taper weights (length nx*ny)\n    \"\"\"\n    if taper_type == \"uniform\":\n        return np.ones(nx * ny)\n    elif taper_type == \"taylor\":\n        return np.asarray(taylor_taper_2d(nx, ny, sidelobe_dB=sll_db)).ravel()\n    elif taper_type == \"chebyshev\":\n        return np.asarray(chebyshev_taper_2d(nx, ny, sidelobe_dB=sll_db)).ravel()\n    elif taper_type == \"hamming\":\n        return np.asarray(hamming_taper_2d(nx, ny)).ravel()\n    elif taper_type == \"cosine\":\n        return np.asarray(cosine_taper_2d(nx, ny)).ravel()\n    elif taper_type == \"gaussian\":\n        return np.asarray(gaussian_taper_2d(nx, ny)).ravel()\n    else:\n        logger.warning(\"Unknown taper type '%s', using uniform\", taper_type)\n        return np.ones(nx * ny)\n\n\nclass PhasedArrayAdapter:\n    \"\"\"Adapter for phased-array-modeling library.\n\n    Provides a consistent interface for computing antenna pattern metrics\n    using the phased-array-modeling library, with fallback to analytical\n    approximations when the library is not available.\n\n    Attributes:\n        name: Model block name for identification\n        use_analytical_fallback: If True, use analytical approximations\n            when phased-array-modeling is not available\n    \"\"\"\n\n    name: str = \"antenna\"\n\n    def __init__(self, use_analytical_fallback: bool = True):\n        \"\"\"Initialize the adapter.\n\n        Args:\n            use_analytical_fallback: Use analytical methods if PAM unavailable\n        \"\"\"\n        self.use_analytical_fallback = use_analytical_fallback\n\n        if not HAS_PAM and not use_analytical_fallback:\n            raise ImportError(\n                \"phased-array-modeling not installed. Install with: \"\n                \"pip install phased-array-modeling\"\n            )\n\n    def evaluate(\n        self, arch: Architecture, scenario: Scenario, context: dict[str, Any]\n    ) -> MetricsDict:\n        \"\"\"Evaluate antenna performance metrics.\n\n        Args:\n            arch: Architecture configuration\n            scenario: Scenario with frequency and scan angle info\n            context: Additional context (may contain failure_rate for degradation)\n\n        Returns:\n            Dictionary with antenna metrics\n        \"\"\"\n        scan_angle_deg = getattr(scenario, \"scan_angle_deg\", 0.0)\n\n        if HAS_PAM:\n            return self._evaluate_with_pam(arch, scenario, scan_angle_deg, context)\n        else:\n            return self._evaluate_analytical(arch, scenario, scan_angle_deg)\n\n    def _evaluate_with_pam(\n        self,\n        arch: Architecture,\n        scenario: Scenario,\n        scan_angle_deg: float,\n        context: dict[str, Any],\n    ) -> MetricsDict:\n        \"\"\"Evaluate using phased-array-modeling library.\"\"\"\n        wavelength_m = scenario.wavelength_m if hasattr(scenario, \"wavelength_m\") else None\n\n        if wavelength_m is None:\n            from phased_array_systems.constants import C\n\n            wavelength_m = C / scenario.freq_hz\n\n        nx = arch.array.nx\n        ny = arch.array.ny\n\n        # 1. Create array geometry (dx/dy are in wavelengths, library converts to meters)\n        geom = create_rectangular_array(\n            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda, wavelength=wavelength_m\n        )\n        k = 2 * np.pi / wavelength_m\n\n        # 2. Build taper weights\n        taper_type = getattr(arch.array, \"taper_type\", \"uniform\")\n        taper_sll_db = getattr(arch.array, \"taper_sll_db\", -30.0)\n        taper_weights = _build_taper_weights(taper_type, nx, ny, taper_sll_db)\n\n        # Compute taper efficiency\n        taper_eff = compute_taper_efficiency(taper_weights)\n        taper_loss_db = -10 * np.log10(taper_eff) if taper_eff > 0 else 0.0\n\n        # 3. Apply steering vector\n        scan_phi_deg = 0.0  # Azimuth plane scan\n        sv = steering_vector(k, geom.x, geom.y, scan_angle_deg, scan_phi_deg)\n        weights = taper_weights * sv\n\n        # 4. Apply impairments pipeline\n        phase_bits = getattr(arch.array, \"phase_bits\", None)\n        quantization_applied = False\n        if phase_bits is not None:\n            weights = quantize_phase(weights, n_bits=phase_bits)\n            quantization_applied = True\n\n        failure_rate = context.get(\"failure_rate\", 0.0)\n        n_failed = 0\n        if failure_rate > 0:\n            seed = context.get(\"meta.seed\")\n            weights, fail_mask = simulate_element_failures(weights, failure_rate, seed=seed)\n            # The library's mask is True for FAILED elements; counting the\n            # zeros counted the survivors (251 \"failures\" out of 256 at a 2%\n            # rate).\n            n_failed = int(np.sum(fail_mask))\n\n        # 5. Compute patterns using total_pattern (includes element pattern)\n        theta_deg = np.linspace(-90, 90, 721)\n        theta_rad = np.radians(theta_deg)\n\n        element_cos_exp = getattr(arch.array, \"element_cos_exp\", 1.5)\n\n        # Azimuth cut (phi=0)\n        phi_az = np.zeros_like(theta_rad)\n        tp_az = total_pattern(\n            theta_rad,\n            phi_az,\n            geom.x,\n            geom.y,\n            weights,\n            k,\n            element_pattern_func=element_pattern,\n            cos_exp_theta=element_cos_exp,\n        )\n        tp_az_db = 20 * np.log10(np.abs(tp_az) + 1e-12)\n        tp_az_db = tp_az_db - np.max(tp_az_db)  # Normalize to peak\n\n        # Elevation cut (phi=90)\n        phi_el = np.full_like(theta_rad, np.pi / 2)\n        tp_el = total_pattern(\n            theta_rad,\n            phi_el,\n            geom.x,\n            geom.y,\n            weights,\n            k,\n            element_pattern_func=element_pattern,\n            cos_exp_theta=element_cos_exp,\n        )\n        tp_el_db = 20 * np.log10(np.abs(tp_el) + 1e-12)\n        tp_el_db = tp_el_db - np.max(tp_el_db)\n\n        # 6. Extract metrics from computed patterns\n        beamwidth_az = compute_beamwidth(tp_az_db, theta_deg)\n        beamwidth_el = compute_beamwidth(tp_el_db, theta_deg)\n        sll = compute_sidelobe_level(tp_az_db, theta_deg)\n        scan_loss = compute_scan_loss(scan_angle_deg)\n        directivity = compute_directivity_rectangular(\n            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda\n        )\n        # Quantization is simulated in the pattern, but g_peak is assembled\n        # analytically, so the quantization gain loss must be subtracted here\n        quant_loss_db = phase_quantization_loss_db(phase_bits) if phase_bits else 0.0\n        g_peak = directivity - scan_loss - taper_loss_db - quant_loss_db\n\n        # 7. Grating lobe check\n        from phased_array_systems.models.antenna.grating import check_grating_lobes\n\n        grating_info = check_grating_lobes(\n            arch.array.dx_lambda, arch.array.dy_lambda, arch.array.scan_limit_deg\n        )\n        if grating_info[\"grating_lobe_risk\"]:\n            logger.warning(\n                \"Grating lobe risk detected: dx=%.2f, dy=%.2f lambda, \"\n                \"max safe spacing=%.3f lambda at scan_limit=%.1f deg\",\n                arch.array.dx_lambda,\n                arch.array.dy_lambda,\n                grating_info[\"max_safe_spacing_lambda\"],\n                arch.array.scan_limit_deg,\n            )\n\n        metrics: MetricsDict = {\n            \"g_peak_db\": g_peak,\n            \"beamwidth_az_deg\": beamwidth_az,\n            \"beamwidth_el_deg\": beamwidth_el,\n            \"sll_db\": sll,\n            \"scan_loss_db\": scan_loss,\n            \"directivity_db\": directivity,\n            \"n_elements\": arch.array.n_elements,\n            \"taper_type\": taper_type,\n            \"taper_efficiency\": taper_eff,\n            \"taper_loss_db\": taper_loss_db,\n            \"element_pattern_applied\": True,\n            \"element_cos_exp\": element_cos_exp,\n            \"grating_lobe_risk\": grating_info[\"grating_lobe_risk\"],\n            \"max_safe_spacing_lambda\": grating_info[\"max_safe_spacing_lambda\"],\n        }\n\n        if quantization_applied and phase_bits is not None:\n            metrics[\"phase_quantization_bits\"] = phase_bits\n            metrics[\"phase_quantization_loss_db\"] = quant_loss_db\n            metrics[\"rms_sidelobe_floor_db\"] = rms_sidelobe_floor_db(\n                phase_quantization_rms_rad(phase_bits) ** 2,\n                arch.array.n_elements,\n                taper_eff,\n            )\n\n        if failure_rate > 0:\n            metrics[\"n_failed_elements\"] = n_failed\n            metrics[\"failure_rate\"] = failure_rate\n\n        return metrics\n\n    # Approximate first-sidelobe design levels for fixed-shape windows\n    # (uniform: sinc theory; hamming/cosine/gaussian: window first SLL)\n    _DESIGN_SLL_DB = {\n        \"uniform\": -13.2,\n        \"hamming\": -42.7,\n        \"cosine\": -23.0,\n        \"gaussian\": -55.0,\n    }\n\n    def _evaluate_analytical(\n        self, arch: Architecture, scenario: Scenario, scan_angle_deg: float\n    ) -> MetricsDict:\n        \"\"\"Evaluate using analytical approximations.\n\n        Uses standard phased array formulas when the full simulation\n        library is not available. Emits the same metric key set as the\n        pattern-based path so downstream models and requirements behave\n        identically in both modes.\n        \"\"\"\n        nx, ny = arch.array.nx, arch.array.ny\n\n        # Taper from real window functions (separable 2-D outer product)\n        taper_type = cast(TaperType, getattr(arch.array, \"taper_type\", \"uniform\"))\n        taper_sll_db = getattr(arch.array, \"taper_sll_db\", -30.0)\n        wx = generate_taper_weights(taper_type, nx, taper_sll_db)\n        wy = generate_taper_weights(taper_type, ny, taper_sll_db)\n        weights_2d = np.outer(wx, wy).ravel()\n        taper_eff = _local_taper_efficiency(weights_2d)\n        taper_loss_db = -10 * np.log10(taper_eff) if taper_eff > 0 else 0.0\n\n        # Directivity from aperture size\n        directivity_db = compute_directivity_rectangular(\n            nx, ny, arch.array.dx_lambda, arch.array.dy_lambda\n        )\n\n        # Scan loss\n        scan_loss = compute_scan_loss(scan_angle_deg)\n\n        # Phase-shifter quantization loss (analytic Ruze form)\n        phase_bits = getattr(arch.array, \"phase_bits\", None)\n        quant_loss_db = phase_quantization_loss_db(phase_bits) if phase_bits else 0.0\n\n        # Peak gain\n        g_peak = directivity_db - scan_loss - taper_loss_db - quant_loss_db\n\n        # Beamwidth approximations for a rectangular array\n        # BW ≈ 0.886 / (N * d_lambda) radians (uniform-taper form; tapers\n        # broaden this slightly, not modeled here)\n        beamwidth_az_deg = np.degrees(0.886 / (nx * arch.array.dx_lambda))\n        beamwidth_el_deg = np.degrees(0.886 / (ny * arch.array.dy_lambda))\n\n        # Sidelobe level: taper design SLL, floored by the RMS error\n        # sidelobe floor when quantization is present\n        if taper_type in (\"taylor\", \"chebyshev\"):\n            design_sll = taper_sll_db\n        else:\n            design_sll = self._DESIGN_SLL_DB.get(taper_type, -13.2)\n        if phase_bits:\n            error_floor = rms_sidelobe_floor_db(\n                phase_quantization_rms_rad(phase_bits) ** 2,\n                arch.array.n_elements,\n                taper_eff,\n            )\n            sll_db = max(design_sll, error_floor)\n        else:\n            sll_db = design_sll\n\n        # Grating lobe check (same as the pattern-based path)\n        from phased_array_systems.models.antenna.grating import check_grating_lobes\n\n        grating_info = check_grating_lobes(\n            arch.array.dx_lambda, arch.array.dy_lambda, arch.array.scan_limit_deg\n        )\n\n        metrics: MetricsDict = {\n            \"g_peak_db\": g_peak,\n            \"beamwidth_az_deg\": beamwidth_az_deg,\n            \"beamwidth_el_deg\": beamwidth_el_deg,\n            \"sll_db\": sll_db,\n            \"scan_loss_db\": scan_loss,\n            \"directivity_db\": directivity_db,\n            \"n_elements\": arch.array.n_elements,\n            \"taper_type\": taper_type,\n            \"taper_efficiency\": taper_eff,\n            \"taper_loss_db\": taper_loss_db,\n            \"element_pattern_applied\": False,\n            \"element_cos_exp\": getattr(arch.array, \"element_cos_exp\", 1.5),\n            \"grating_lobe_risk\": grating_info[\"grating_lobe_risk\"],\n            \"max_safe_spacing_lambda\": grating_info[\"max_safe_spacing_lambda\"],\n        }\n\n        if phase_bits:\n            metrics[\"phase_quantization_bits\"] = phase_bits\n            metrics[\"phase_quantization_loss_db\"] = quant_loss_db\n            metrics[\"rms_sidelobe_floor_db\"] = rms_sidelobe_floor_db(\n                phase_quantization_rms_rad(phase_bits) ** 2,\n                arch.array.n_elements,\n                taper_eff,\n            )\n\n        return metrics\n","numLines":384,"startLine":1,"totalLines":384}}}
