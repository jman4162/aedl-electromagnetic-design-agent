{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FFczTte9xL9JniGof9vvxb","type":"tool_result","content":"1\t\"\"\"Radar range equation model.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport math\n6\tfrom functools import lru_cache\n7\tfrom typing import Any\n8\t\n9\tfrom phased_array_systems.architecture import Architecture\n10\tfrom phased_array_systems.constants import C_LIGHT, K_B, W_TO_DBW\n11\tfrom phased_array_systems.models.radar.cfar import cfar_loss_db\n12\tfrom phased_array_systems.models.radar.clutter import (\n13\t    compute_resolution_cell_area,\n14\t    compute_resolution_volume,\n15\t    compute_scnr,\n16\t    compute_scr,\n17\t    ground_clutter_rcs,\n18\t    rain_clutter_rcs,\n19\t    sea_clutter_rcs,\n20\t)\n21\tfrom phased_array_systems.models.radar.detection import compute_pd_from_snr, compute_snr_for_pd\n22\tfrom phased_array_systems.models.radar.integration import coherent_integration_gain\n23\tfrom phased_array_systems.models.radar.propagation import (\n24\t    atmospheric_loss_db,\n25\t    rain_attenuation_db,\n26\t)\n27\tfrom phased_array_systems.models.radar.propagation import (\n28\t    grazing_angle_deg as compute_grazing_angle,\n29\t)\n30\tfrom phased_array_systems.scenarios import RadarDetectionScenario\n31\tfrom phased_array_systems.types import MetricsDict\n32\t\n33\t\n34\t@lru_cache(maxsize=256)\n35\tdef _required_snr(pd: float, pfa: float, swerling: int, n_pulses: int) -> float:\n36\t    \"\"\"Cached exact required per-pulse SNR (noncoherent statistics).\n37\t\n38\t    The (pd, pfa, swerling, n_pulses) tuple is constant across the cases\n39\t    of a DOE study, so the brentq/quad inversion runs once per study\n40\t    rather than once per case.\n41\t    \"\"\"\n42\t    return compute_snr_for_pd(\n43\t        pd=pd,\n44\t        pfa=pfa,\n45\t        swerling=swerling,  # type: ignore[arg-type]\n46\t        n_pulses=n_pulses,\n47\t        integration=\"noncoherent\",\n48\t    )\n49\t\n50\t\n51\tclass RadarModel:\n52\t    \"\"\"Radar range equation calculator.\n53\t\n54\t    Implements the monostatic radar range equation:\n55\t\n56\t        P_r = (P_t * G^2 * λ^2 * σ) / ((4π)^3 * R^4 * L_sys)\n57\t\n58\t    Or in dB form:\n59\t        SNR = P_t + 2*G + 2*λ_dB + σ_dBsm - 4*R_dB - L_sys - (4π)^3_dB - N_dB\n60\t\n61\t    Where:\n62\t        P_t = Peak transmit power (W)\n63\t        G = Antenna gain (same for Tx/Rx in monostatic)\n64\t        λ = Wavelength (m)\n65\t        σ = Target radar cross section (m^2)\n66\t        R = Range to target (m)\n67\t        L_sys = System losses\n68\t        N = Noise power = kTB\n69\t\n70\t    Attributes:\n71\t        name: Model block name for identification\n72\t    \"\"\"\n73\t\n74\t    name: str = \"radar\"\n75\t\n76\t    def evaluate(\n77\t        self,\n78\t        arch: Architecture,\n79\t        scenario: RadarDetectionScenario,\n80\t        context: dict[str, Any],\n81\t    ) -> MetricsDict:\n82\t        \"\"\"Evaluate radar detection performance.\n83\t\n84\t        Args:\n85\t            arch: Architecture configuration\n86\t            scenario: Radar detection scenario\n87\t            context: Additional context (may include antenna metrics):\n88\t                - g_peak_db: Antenna gain (uses this if provided)\n89\t                - scan_loss_db: Scan loss (uses this if provided)\n90\t                - beamwidth_az_deg: Azimuth beamwidth (for clutter cell)\n91\t                - beamwidth_el_deg: Elevation beamwidth (for clutter cell)\n92\t\n93\t        Returns:\n94\t            Dictionary with radar metrics:\n95\t                - peak_power_w: Peak transmit power (W)\n96\t                - peak_power_dbw: Peak transmit power (dBW)\n97\t                - g_ant_db: Antenna gain (dB)\n98\t                - wavelength_m: Wavelength (m)\n99\t                - target_rcs_dbsm: Target RCS (dBsm)\n100\t                - target_rcs_m2: Target RCS (m^2)\n101\t                - range_m: Target range (m)\n102\t                - noise_power_dbw: Noise power (dBW)\n103\t                - snr_single_pulse_db: Single-pulse SNR (dB)\n104\t                - integration_gain_db: Integration gain (dB)\n105\t                - snr_integrated_db: Integrated SNR (dB)\n106\t                - snr_required_db: Required SNR for Pd/Pfa (dB)\n107\t                - snr_margin_db: SNR margin (dB)\n108\t                - pd_achieved: Achieved probability of detection\n109\t                - detection_range_m: Max detection range for required Pd (m)\n110\t                - clutter_rcs_dbsm: Clutter RCS if applicable (dBsm)\n111\t                - scr_db: Signal-to-clutter ratio if applicable (dB)\n112\t                - scnr_db: Signal-to-clutter-plus-noise ratio (dB)\n113\t                - atmos_loss_db: Two-way atmospheric loss (dB)\n114\t                - rain_loss_db: Two-way rain attenuation (dB)\n115\t                - cfar_loss_db: CFAR processing loss (dB)\n116\t        \"\"\"\n117\t        # Get antenna gain from context or compute approximate\n118\t        if \"g_peak_db\" in context:\n119\t            g_ant_db = context[\"g_peak_db\"]\n120\t            # Apply scan loss if provided\n121\t            if \"scan_loss_db\" in context:\n122\t                g_ant_db -= context[\"scan_loss_db\"]\n123\t        else:\n124\t            # Approximate gain for uniform rectangular array\n125\t            # G ≈ 4*pi*A/λ^2 = 4*pi * (nx*dx) * (ny*dy) when spacing in wavelengths\n126\t            aperture_lambda_sq = (\n127\t                arch.array.nx * arch.array.dx_lambda * arch.array.ny * arch.array.dy_lambda\n128\t            )\n129\t            g_ant_linear = 4 * math.pi * aperture_lambda_sq\n130\t            g_ant_db = 10 * math.log10(g_ant_linear)\n131\t\n132\t        # Get beamwidths from context or approximate\n133\t        beamwidth_az_deg = context.get(\"beamwidth_az_deg\", 5.0)\n134\t        beamwidth_el_deg = context.get(\"beamwidth_el_deg\", 5.0)\n135\t\n136\t        # Transmit power (peak)\n137\t        n_elements = arch.array.n_elements\n138\t        peak_power_w = arch.rf.tx_power_w_per_elem * n_elements\n139\t        peak_power_dbw = W_TO_DBW(peak_power_w)\n140\t\n141\t        # Wavelength\n142\t        wavelength_m = C_LIGHT / scenario.freq_hz\n143\t        wavelength_db = 10 * math.log10(wavelength_m)\n144\t\n145\t        # Range resolution\n146\t        range_resolution_m = scenario.range_resolution_m\n147\t\n148\t        # System losses (feed network + additional system losses)\n149\t        system_loss_db = arch.rf.feed_loss_db + arch.rf.system_loss_db\n150\t\n151\t        # Target RCS\n152\t        rcs_dbsm = scenario.target_rcs_dbsm\n153\t        rcs_m2 = 10 ** (rcs_dbsm / 10)\n154\t\n155\t        # Range\n156\t        range_m = scenario.range_m\n157\t        range_db = 10 * math.log10(range_m)\n158\t\n159\t        # Compute grazing angle if not specified\n160\t        if scenario.grazing_angle_deg is not None:\n161\t            grazing_angle = scenario.grazing_angle_deg\n162\t        else:\n163\t            grazing_angle = compute_grazing_angle(\n164\t                range_m,\n165\t                scenario.antenna_height_m,\n166\t                scenario.target_height_m,\n167\t            )\n168\t            grazing_angle = max(0.5, min(90.0, grazing_angle))\n169\t\n170\t        # Propagation losses\n171\t        atmos_loss = 0.0\n172\t        rain_loss = 0.0\n173\t\n174\t        if scenario.include_atmos_loss:\n175\t            atmos_loss = atmospheric_loss_db(\n176\t                scenario.freq_hz,\n177\t                range_m,\n178\t                elevation_deg=grazing_angle,\n179\t                temperature_c=scenario.temperature_c,\n180\t                humidity_pct=scenario.humidity_pct,\n181\t            )\n182\t\n183\t        if scenario.rain_rate_mm_hr > 0:\n184\t            rain_loss = rain_attenuation_db(\n185\t                scenario.freq_hz,\n186\t                range_m,\n187\t                scenario.rain_rate_mm_hr,\n188\t            )\n189\t\n190\t        # Total propagation loss\n191\t        propagation_loss_db = atmos_loss + rain_loss\n192\t\n193\t        # Noise convention: rx_noise_temp_k is the ANTENNA temperature.\n194\t        # T_sys = T_ant + T0*(F-1), N = k*T_sys*B. Cascaded NF from context\n195\t        # (RF cascade model) wins over the flat arch.rf value, matching the\n196\t        # comms link budget.\n197\t        nf_raw = context.get(\"cascade_nf_db\", arch.rf.noise_figure_db)\n198\t        nf_db = float(nf_raw) if isinstance(nf_raw, (int, float)) else arch.rf.noise_figure_db\n199\t        noise_factor = 10.0 ** (nf_db / 10.0)\n200\t        t_sys_k = scenario.rx_noise_temp_k + 290.0 * (noise_factor - 1.0)\n201\t        noise_power_dbw = W_TO_DBW(K_B * t_sys_k * scenario.bandwidth_hz)\n202\t\n203\t        # Radar equation constant: (4π)^3 in dB\n204\t        radar_constant_db = 30 * math.log10(4 * math.pi)  # ≈ 32.98 dB\n205\t\n206\t        # Single-pulse SNR (monostatic radar equation in dB)\n207\t        # SNR = Pt + 2*G + 2*λ_dB + σ - 4*R_dB - L - (4π)^3_dB - N - L_prop\n208\t        snr_single_db = (\n209\t            peak_power_dbw\n210\t            + 2 * g_ant_db\n211\t            + 2 * wavelength_db\n212\t            + rcs_dbsm\n213\t            - 4 * range_db\n214\t            - system_loss_db\n215\t            - radar_constant_db\n216\t            - noise_power_dbw\n217\t            - propagation_loss_db\n218\t        )\n219\t\n220\t        # Clutter calculations\n221\t        clutter_rcs_dbsm = -100.0  # Default: no clutter\n222\t        scr_db = 100.0  # Default: no clutter (infinite SCR)\n223\t\n224\t        if scenario.clutter_type != \"none\":\n225\t            # Compute resolution cell area/volume\n226\t            cell_area = compute_resolution_cell_area(range_m, range_resolution_m, beamwidth_az_deg)\n227\t            cell_volume = compute_resolution_volume(\n228\t                range_m, range_resolution_m, beamwidth_az_deg, beamwidth_el_deg\n229\t            )\n230\t\n231\t            if scenario.clutter_type == \"sea\":\n232\t                clutter_rcs_dbsm = sea_clutter_rcs(\n233\t                    scenario.sea_state,\n234\t                    grazing_angle,\n235\t                    scenario.freq_hz,\n236\t                    cell_area,\n237\t                    scenario.polarization,\n238\t                )\n239\t            elif scenario.clutter_type == \"ground\":\n240\t                clutter_rcs_dbsm = ground_clutter_rcs(\n241\t                    scenario.terrain_type,\n242\t                    grazing_angle,\n243\t                    scenario.freq_hz,\n244\t                    cell_area,\n245\t                )\n246\t            elif scenario.clutter_type == \"rain\":\n247\t                clutter_rcs_dbsm = rain_clutter_rcs(\n248\t                    scenario.rain_rate_mm_hr,\n249\t                    scenario.freq_hz,\n250\t                    cell_volume,\n251\t                )\n252\t\n253\t            scr_db = compute_scr(rcs_dbsm, clutter_rcs_dbsm)\n254\t\n255\t        # Compute SCNR (signal-to-clutter-plus-noise ratio)\n256\t        scnr_db = compute_scnr(snr_single_db, scr_db)\n257\t\n258\t        # CFAR loss\n259\t        cfar_loss = 0.0\n260\t        if scenario.cfar_type != \"none\":\n261\t            cfar_loss = cfar_loss_db(\n262\t                scenario.cfar_type,\n263\t                scenario.cfar_ref_cells,\n264\t                scenario.pfa,\n265\t            )\n266\t\n267\t        # Integration gain and required SNR must come from the same law to\n268\t        # avoid double-counting. Both use the exact detection statistics\n269\t        # (noncentral chi-square / gamma mixtures), so target fluctuation\n270\t        # affects the margin consistently; the implied noncoherent gain is\n271\t        # the drop in required single-pulse SNR vs n=1.\n272\t        n_pulses = scenario.n_pulses\n273\t        swerling = scenario.swerling\n274\t        snr_required_db = _required_snr(\n275\t            pd=scenario.pd_required,\n276\t            pfa=scenario.pfa,\n277\t            swerling=swerling,\n278\t            n_pulses=1,\n279\t        )\n280\t        if scenario.integration_type == \"coherent\":\n281\t            integration_gain_db = coherent_integration_gain(n_pulses)\n282\t        else:\n283\t            snr_required_single_db = _required_snr(\n284\t                pd=scenario.pd_required,\n285\t                pfa=scenario.pfa,\n286\t                swerling=swerling,\n287\t                n_pulses=n_pulses,\n288\t            )\n289\t            integration_gain_db = snr_required_db - snr_required_single_db\n290\t\n291\t        # Integrated SCNR (use SCNR when clutter is present, SNR otherwise)\n292\t        effective_snr_single = scnr_db if scenario.clutter_type != \"none\" else snr_single_db\n293\t\n294\t        snr_integrated_db = effective_snr_single + integration_gain_db - cfar_loss\n295\t\n296\t        # SNR margin (snr_required_db is referenced to the integrated SNR)\n297\t        snr_margin_db = snr_integrated_db - snr_required_db\n298\t\n299\t        # Achieved Pd from per-pulse SNR using exact n-pulse statistics\n300\t        pd_achieved = compute_pd_from_snr(\n301\t            effective_snr_single - cfar_loss,\n302\t            scenario.pfa,\n303\t            swerling=swerling,\n304\t            n_pulses=n_pulses,\n305\t            integration=scenario.integration_type,\n306\t        )\n307\t\n308\t        # Detection range (range where margin = 0)\n309\t        # From radar equation: R^4 proportional to SNR\n310\t        # R_det / R = (SNR_integrated / SNR_required)^(1/4)\n311\t        # In dB: R_det = R * 10^(margin_dB / 40)\n312\t        detection_range_m = range_m * 10 ** (snr_margin_db / 40) if snr_margin_db > -40 else 0.0\n313\t\n314\t        return {\n315\t            # Power\n316\t            \"peak_power_w\": peak_power_w,\n317\t            \"peak_power_dbw\": peak_power_dbw,\n318\t            # Antenna\n319\t            \"g_ant_db\": g_ant_db,\n320\t            # Target/Environment\n321\t            \"wavelength_m\": wavelength_m,\n322\t            \"target_rcs_dbsm\": rcs_dbsm,\n323\t            \"target_rcs_m2\": rcs_m2,\n324\t            \"range_m\": range_m,\n325\t            \"grazing_angle_deg\": grazing_angle,\n326\t            # Noise\n327\t            \"noise_power_dbw\": noise_power_dbw,\n328\t            \"noise_temp_system_k\": t_sys_k,\n329\t            \"noise_figure_used_db\": nf_db,\n330\t            \"system_loss_db\": system_loss_db,\n331\t            # Propagation losses\n332\t            \"atmos_loss_db\": atmos_loss,\n333\t            \"rain_loss_db\": rain_loss,\n334\t            \"propagation_loss_db\": propagation_loss_db,\n335\t            # Clutter\n336\t            \"clutter_type\": scenario.clutter_type,\n337\t            \"clutter_rcs_dbsm\": clutter_rcs_dbsm,\n338\t            \"scr_db\": scr_db,\n339\t            \"scnr_db\": scnr_db,\n340\t            # CFAR\n341\t            \"cfar_type\": scenario.cfar_type,\n342\t            \"cfar_loss_db\": cfar_loss,\n343\t            # SNR\n344\t            \"snr_single_pulse_db\": snr_single_db,\n345\t            \"integration_gain_db\": integration_gain_db,\n346\t            \"snr_integrated_db\": snr_integrated_db,\n347\t            \"snr_required_db\": snr_required_db,\n348\t            \"snr_margin_db\": snr_margin_db,\n349\t            # Detection\n350\t            \"pd_achieved\": pd_achieved,\n351\t            \"pd_required\": scenario.pd_required,\n352\t            \"pfa\": scenario.pfa,\n353\t            \"swerling\": swerling,\n354\t            \"n_pulses\": n_pulses,\n355\t            \"integration_type\": scenario.integration_type,\n356\t            \"detection_range_m\": detection_range_m,\n357\t        }\n358\t\n359\t\n360\tdef compute_detection_range(\n361\t    peak_power_w: float,\n362\t    g_ant_db: float,\n363\t    freq_hz: float,\n364\t    rcs_dbsm: float,\n365\t    noise_temp_k: float,\n366\t    bandwidth_hz: float,\n367\t    noise_figure_db: float,\n368\t    system_loss_db: float,\n369\t    snr_required_db: float,\n370\t) -> float:\n371\t    \"\"\"Compute maximum detection range from radar parameters.\n372\t\n373\t    Standalone function for quick range calculations without\n374\t    full Architecture/Scenario objects.\n375\t\n376\t    Args:\n377\t        peak_power_w: Peak transmit power (W)\n378\t        g_ant_db: Antenna gain (dB)\n379\t        freq_hz: Operating frequency (Hz)\n380\t        rcs_dbsm: Target RCS (dBsm)\n381\t        noise_temp_k: System noise temperature (K)\n382\t        bandwidth_hz: Receiver bandwidth (Hz)\n383\t        noise_figure_db: Receiver noise figure (dB)\n384\t        system_loss_db: Total system losses (dB)\n385\t        snr_required_db: Required SNR for detection (dB)\n386\t\n387\t    Returns:\n388\t        Maximum detection range in meters\n389\t    \"\"\"\n390\t    # Convert to dB\n391\t    pt_dbw = W_TO_DBW(peak_power_w)\n392\t    wavelength_m = C_LIGHT / freq_hz\n393\t    wavelength_db = 10 * math.log10(wavelength_m)\n394\t    noise_power_w = K_B * noise_temp_k * bandwidth_hz\n395\t    noise_power_dbw = W_TO_DBW(noise_power_w) + noise_figure_db\n396\t    radar_constant_db = 30 * math.log10(4 * math.pi)\n397\t\n398\t    # Solve for range: 4*R_dB = Pt + 2*G + 2*λ_dB + σ - L - const - N - SNR_req\n399\t    four_r_db = (\n400\t        pt_dbw\n401\t        + 2 * g_ant_db\n402\t        + 2 * wavelength_db\n403\t        + rcs_dbsm\n404\t        - system_loss_db\n405\t        - radar_constant_db\n406\t        - noise_power_dbw\n407\t        - snr_required_db\n408\t    )\n409\t\n410\t    r_db = four_r_db / 4\n411\t    range_m = 10 ** (r_db / 10)\n412\t\n413\t    return range_m\n414\t"}]},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"049f049e-b962-4c5c-bc30-aef134bbe392","timestamp":"2026-08-12T21:26:09.749Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/models/radar/equation.py","content":"\"\"\"Radar range equation model.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom functools import lru_cache\nfrom typing import Any\n\nfrom phased_array_systems.architecture import Architecture\nfrom phased_array_systems.constants import C_LIGHT, K_B, W_TO_DBW\nfrom phased_array_systems.models.radar.cfar import cfar_loss_db\nfrom phased_array_systems.models.radar.clutter import (\n    compute_resolution_cell_area,\n    compute_resolution_volume,\n    compute_scnr,\n    compute_scr,\n    ground_clutter_rcs,\n    rain_clutter_rcs,\n    sea_clutter_rcs,\n)\nfrom phased_array_systems.models.radar.detection import compute_pd_from_snr, compute_snr_for_pd\nfrom phased_array_systems.models.radar.integration import coherent_integration_gain\nfrom phased_array_systems.models.radar.propagation import (\n    atmospheric_loss_db,\n    rain_attenuation_db,\n)\nfrom phased_array_systems.models.radar.propagation import (\n    grazing_angle_deg as compute_grazing_angle,\n)\nfrom phased_array_systems.scenarios import RadarDetectionScenario\nfrom phased_array_systems.types import MetricsDict\n\n\n@lru_cache(maxsize=256)\ndef _required_snr(pd: float, pfa: float, swerling: int, n_pulses: int) -> float:\n    \"\"\"Cached exact required per-pulse SNR (noncoherent statistics).\n\n    The (pd, pfa, swerling, n_pulses) tuple is constant across the cases\n    of a DOE study, so the brentq/quad inversion runs once per study\n    rather than once per case.\n    \"\"\"\n    return compute_snr_for_pd(\n        pd=pd,\n        pfa=pfa,\n        swerling=swerling,  # type: ignore[arg-type]\n        n_pulses=n_pulses,\n        integration=\"noncoherent\",\n    )\n\n\nclass RadarModel:\n    \"\"\"Radar range equation calculator.\n\n    Implements the monostatic radar range equation:\n\n        P_r = (P_t * G^2 * λ^2 * σ) / ((4π)^3 * R^4 * L_sys)\n\n    Or in dB form:\n        SNR = P_t + 2*G + 2*λ_dB + σ_dBsm - 4*R_dB - L_sys - (4π)^3_dB - N_dB\n\n    Where:\n        P_t = Peak transmit power (W)\n        G = Antenna gain (same for Tx/Rx in monostatic)\n        λ = Wavelength (m)\n        σ = Target radar cross section (m^2)\n        R = Range to target (m)\n        L_sys = System losses\n        N = Noise power = kTB\n\n    Attributes:\n        name: Model block name for identification\n    \"\"\"\n\n    name: str = \"radar\"\n\n    def evaluate(\n        self,\n        arch: Architecture,\n        scenario: RadarDetectionScenario,\n        context: dict[str, Any],\n    ) -> MetricsDict:\n        \"\"\"Evaluate radar detection performance.\n\n        Args:\n            arch: Architecture configuration\n            scenario: Radar detection scenario\n            context: Additional context (may include antenna metrics):\n                - g_peak_db: Antenna gain (uses this if provided)\n                - scan_loss_db: Scan loss (uses this if provided)\n                - beamwidth_az_deg: Azimuth beamwidth (for clutter cell)\n                - beamwidth_el_deg: Elevation beamwidth (for clutter cell)\n\n        Returns:\n            Dictionary with radar metrics:\n                - peak_power_w: Peak transmit power (W)\n                - peak_power_dbw: Peak transmit power (dBW)\n                - g_ant_db: Antenna gain (dB)\n                - wavelength_m: Wavelength (m)\n                - target_rcs_dbsm: Target RCS (dBsm)\n                - target_rcs_m2: Target RCS (m^2)\n                - range_m: Target range (m)\n                - noise_power_dbw: Noise power (dBW)\n                - snr_single_pulse_db: Single-pulse SNR (dB)\n                - integration_gain_db: Integration gain (dB)\n                - snr_integrated_db: Integrated SNR (dB)\n                - snr_required_db: Required SNR for Pd/Pfa (dB)\n                - snr_margin_db: SNR margin (dB)\n                - pd_achieved: Achieved probability of detection\n                - detection_range_m: Max detection range for required Pd (m)\n                - clutter_rcs_dbsm: Clutter RCS if applicable (dBsm)\n                - scr_db: Signal-to-clutter ratio if applicable (dB)\n                - scnr_db: Signal-to-clutter-plus-noise ratio (dB)\n                - atmos_loss_db: Two-way atmospheric loss (dB)\n                - rain_loss_db: Two-way rain attenuation (dB)\n                - cfar_loss_db: CFAR processing loss (dB)\n        \"\"\"\n        # Get antenna gain from context or compute approximate\n        if \"g_peak_db\" in context:\n            g_ant_db = context[\"g_peak_db\"]\n            # Apply scan loss if provided\n            if \"scan_loss_db\" in context:\n                g_ant_db -= context[\"scan_loss_db\"]\n        else:\n            # Approximate gain for uniform rectangular array\n            # G ≈ 4*pi*A/λ^2 = 4*pi * (nx*dx) * (ny*dy) when spacing in wavelengths\n            aperture_lambda_sq = (\n                arch.array.nx * arch.array.dx_lambda * arch.array.ny * arch.array.dy_lambda\n            )\n            g_ant_linear = 4 * math.pi * aperture_lambda_sq\n            g_ant_db = 10 * math.log10(g_ant_linear)\n\n        # Get beamwidths from context or approximate\n        beamwidth_az_deg = context.get(\"beamwidth_az_deg\", 5.0)\n        beamwidth_el_deg = context.get(\"beamwidth_el_deg\", 5.0)\n\n        # Transmit power (peak)\n        n_elements = arch.array.n_elements\n        peak_power_w = arch.rf.tx_power_w_per_elem * n_elements\n        peak_power_dbw = W_TO_DBW(peak_power_w)\n\n        # Wavelength\n        wavelength_m = C_LIGHT / scenario.freq_hz\n        wavelength_db = 10 * math.log10(wavelength_m)\n\n        # Range resolution\n        range_resolution_m = scenario.range_resolution_m\n\n        # System losses (feed network + additional system losses)\n        system_loss_db = arch.rf.feed_loss_db + arch.rf.system_loss_db\n\n        # Target RCS\n        rcs_dbsm = scenario.target_rcs_dbsm\n        rcs_m2 = 10 ** (rcs_dbsm / 10)\n\n        # Range\n        range_m = scenario.range_m\n        range_db = 10 * math.log10(range_m)\n\n        # Compute grazing angle if not specified\n        if scenario.grazing_angle_deg is not None:\n            grazing_angle = scenario.grazing_angle_deg\n        else:\n            grazing_angle = compute_grazing_angle(\n                range_m,\n                scenario.antenna_height_m,\n                scenario.target_height_m,\n            )\n            grazing_angle = max(0.5, min(90.0, grazing_angle))\n\n        # Propagation losses\n        atmos_loss = 0.0\n        rain_loss = 0.0\n\n        if scenario.include_atmos_loss:\n            atmos_loss = atmospheric_loss_db(\n                scenario.freq_hz,\n                range_m,\n                elevation_deg=grazing_angle,\n                temperature_c=scenario.temperature_c,\n                humidity_pct=scenario.humidity_pct,\n            )\n\n        if scenario.rain_rate_mm_hr > 0:\n            rain_loss = rain_attenuation_db(\n                scenario.freq_hz,\n                range_m,\n                scenario.rain_rate_mm_hr,\n            )\n\n        # Total propagation loss\n        propagation_loss_db = atmos_loss + rain_loss\n\n        # Noise convention: rx_noise_temp_k is the ANTENNA temperature.\n        # T_sys = T_ant + T0*(F-1), N = k*T_sys*B. Cascaded NF from context\n        # (RF cascade model) wins over the flat arch.rf value, matching the\n        # comms link budget.\n        nf_raw = context.get(\"cascade_nf_db\", arch.rf.noise_figure_db)\n        nf_db = float(nf_raw) if isinstance(nf_raw, (int, float)) else arch.rf.noise_figure_db\n        noise_factor = 10.0 ** (nf_db / 10.0)\n        t_sys_k = scenario.rx_noise_temp_k + 290.0 * (noise_factor - 1.0)\n        noise_power_dbw = W_TO_DBW(K_B * t_sys_k * scenario.bandwidth_hz)\n\n        # Radar equation constant: (4π)^3 in dB\n        radar_constant_db = 30 * math.log10(4 * math.pi)  # ≈ 32.98 dB\n\n        # Single-pulse SNR (monostatic radar equation in dB)\n        # SNR = Pt + 2*G + 2*λ_dB + σ - 4*R_dB - L - (4π)^3_dB - N - L_prop\n        snr_single_db = (\n            peak_power_dbw\n            + 2 * g_ant_db\n            + 2 * wavelength_db\n            + rcs_dbsm\n            - 4 * range_db\n            - system_loss_db\n            - radar_constant_db\n            - noise_power_dbw\n            - propagation_loss_db\n        )\n\n        # Clutter calculations\n        clutter_rcs_dbsm = -100.0  # Default: no clutter\n        scr_db = 100.0  # Default: no clutter (infinite SCR)\n\n        if scenario.clutter_type != \"none\":\n            # Compute resolution cell area/volume\n            cell_area = compute_resolution_cell_area(range_m, range_resolution_m, beamwidth_az_deg)\n            cell_volume = compute_resolution_volume(\n                range_m, range_resolution_m, beamwidth_az_deg, beamwidth_el_deg\n            )\n\n            if scenario.clutter_type == \"sea\":\n                clutter_rcs_dbsm = sea_clutter_rcs(\n                    scenario.sea_state,\n                    grazing_angle,\n                    scenario.freq_hz,\n                    cell_area,\n                    scenario.polarization,\n                )\n            elif scenario.clutter_type == \"ground\":\n                clutter_rcs_dbsm = ground_clutter_rcs(\n                    scenario.terrain_type,\n                    grazing_angle,\n                    scenario.freq_hz,\n                    cell_area,\n                )\n            elif scenario.clutter_type == \"rain\":\n                clutter_rcs_dbsm = rain_clutter_rcs(\n                    scenario.rain_rate_mm_hr,\n                    scenario.freq_hz,\n                    cell_volume,\n                )\n\n            scr_db = compute_scr(rcs_dbsm, clutter_rcs_dbsm)\n\n        # Compute SCNR (signal-to-clutter-plus-noise ratio)\n        scnr_db = compute_scnr(snr_single_db, scr_db)\n\n        # CFAR loss\n        cfar_loss = 0.0\n        if scenario.cfar_type != \"none\":\n            cfar_loss = cfar_loss_db(\n                scenario.cfar_type,\n                scenario.cfar_ref_cells,\n                scenario.pfa,\n            )\n\n        # Integration gain and required SNR must come from the same law to\n        # avoid double-counting. Both use the exact detection statistics\n        # (noncentral chi-square / gamma mixtures), so target fluctuation\n        # affects the margin consistently; the implied noncoherent gain is\n        # the drop in required single-pulse SNR vs n=1.\n        n_pulses = scenario.n_pulses\n        swerling = scenario.swerling\n        snr_required_db = _required_snr(\n            pd=scenario.pd_required,\n            pfa=scenario.pfa,\n            swerling=swerling,\n            n_pulses=1,\n        )\n        if scenario.integration_type == \"coherent\":\n            integration_gain_db = coherent_integration_gain(n_pulses)\n        else:\n            snr_required_single_db = _required_snr(\n                pd=scenario.pd_required,\n                pfa=scenario.pfa,\n                swerling=swerling,\n                n_pulses=n_pulses,\n            )\n            integration_gain_db = snr_required_db - snr_required_single_db\n\n        # Integrated SCNR (use SCNR when clutter is present, SNR otherwise)\n        effective_snr_single = scnr_db if scenario.clutter_type != \"none\" else snr_single_db\n\n        snr_integrated_db = effective_snr_single + integration_gain_db - cfar_loss\n\n        # SNR margin (snr_required_db is referenced to the integrated SNR)\n        snr_margin_db = snr_integrated_db - snr_required_db\n\n        # Achieved Pd from per-pulse SNR using exact n-pulse statistics\n        pd_achieved = compute_pd_from_snr(\n            effective_snr_single - cfar_loss,\n            scenario.pfa,\n            swerling=swerling,\n            n_pulses=n_pulses,\n            integration=scenario.integration_type,\n        )\n\n        # Detection range (range where margin = 0)\n        # From radar equation: R^4 proportional to SNR\n        # R_det / R = (SNR_integrated / SNR_required)^(1/4)\n        # In dB: R_det = R * 10^(margin_dB / 40)\n        detection_range_m = range_m * 10 ** (snr_margin_db / 40) if snr_margin_db > -40 else 0.0\n\n        return {\n            # Power\n            \"peak_power_w\": peak_power_w,\n            \"peak_power_dbw\": peak_power_dbw,\n            # Antenna\n            \"g_ant_db\": g_ant_db,\n            # Target/Environment\n            \"wavelength_m\": wavelength_m,\n            \"target_rcs_dbsm\": rcs_dbsm,\n            \"target_rcs_m2\": rcs_m2,\n            \"range_m\": range_m,\n            \"grazing_angle_deg\": grazing_angle,\n            # Noise\n            \"noise_power_dbw\": noise_power_dbw,\n            \"noise_temp_system_k\": t_sys_k,\n            \"noise_figure_used_db\": nf_db,\n            \"system_loss_db\": system_loss_db,\n            # Propagation losses\n            \"atmos_loss_db\": atmos_loss,\n            \"rain_loss_db\": rain_loss,\n            \"propagation_loss_db\": propagation_loss_db,\n            # Clutter\n            \"clutter_type\": scenario.clutter_type,\n            \"clutter_rcs_dbsm\": clutter_rcs_dbsm,\n            \"scr_db\": scr_db,\n            \"scnr_db\": scnr_db,\n            # CFAR\n            \"cfar_type\": scenario.cfar_type,\n            \"cfar_loss_db\": cfar_loss,\n            # SNR\n            \"snr_single_pulse_db\": snr_single_db,\n            \"integration_gain_db\": integration_gain_db,\n            \"snr_integrated_db\": snr_integrated_db,\n            \"snr_required_db\": snr_required_db,\n            \"snr_margin_db\": snr_margin_db,\n            # Detection\n            \"pd_achieved\": pd_achieved,\n            \"pd_required\": scenario.pd_required,\n            \"pfa\": scenario.pfa,\n            \"swerling\": swerling,\n            \"n_pulses\": n_pulses,\n            \"integration_type\": scenario.integration_type,\n            \"detection_range_m\": detection_range_m,\n        }\n\n\ndef compute_detection_range(\n    peak_power_w: float,\n    g_ant_db: float,\n    freq_hz: float,\n    rcs_dbsm: float,\n    noise_temp_k: float,\n    bandwidth_hz: float,\n    noise_figure_db: float,\n    system_loss_db: float,\n    snr_required_db: float,\n) -> float:\n    \"\"\"Compute maximum detection range from radar parameters.\n\n    Standalone function for quick range calculations without\n    full Architecture/Scenario objects.\n\n    Args:\n        peak_power_w: Peak transmit power (W)\n        g_ant_db: Antenna gain (dB)\n        freq_hz: Operating frequency (Hz)\n        rcs_dbsm: Target RCS (dBsm)\n        noise_temp_k: System noise temperature (K)\n        bandwidth_hz: Receiver bandwidth (Hz)\n        noise_figure_db: Receiver noise figure (dB)\n        system_loss_db: Total system losses (dB)\n        snr_required_db: Required SNR for detection (dB)\n\n    Returns:\n        Maximum detection range in meters\n    \"\"\"\n    # Convert to dB\n    pt_dbw = W_TO_DBW(peak_power_w)\n    wavelength_m = C_LIGHT / freq_hz\n    wavelength_db = 10 * math.log10(wavelength_m)\n    noise_power_w = K_B * noise_temp_k * bandwidth_hz\n    noise_power_dbw = W_TO_DBW(noise_power_w) + noise_figure_db\n    radar_constant_db = 30 * math.log10(4 * math.pi)\n\n    # Solve for range: 4*R_dB = Pt + 2*G + 2*λ_dB + σ - L - const - N - SNR_req\n    four_r_db = (\n        pt_dbw\n        + 2 * g_ant_db\n        + 2 * wavelength_db\n        + rcs_dbsm\n        - system_loss_db\n        - radar_constant_db\n        - noise_power_dbw\n        - snr_required_db\n    )\n\n    r_db = four_r_db / 4\n    range_m = 10 ** (r_db / 10)\n\n    return range_m\n","numLines":414,"startLine":1,"totalLines":414}}}
