{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015zKUcKxpTtw3MbGvJXvbPB","type":"tool_result","content":"1\t\"\"\"Single-case evaluation orchestrator.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport math\n6\timport time\n7\tfrom typing import TYPE_CHECKING, Any\n8\t\n9\tfrom phased_array_systems.__about__ import __version__\n10\tfrom phased_array_systems.architecture import Architecture\n11\tfrom phased_array_systems.models.antenna import PhasedArrayAdapter\n12\tfrom phased_array_systems.models.comms import CommsLinkModel\n13\tfrom phased_array_systems.models.radar import RadarModel\n14\tfrom phased_array_systems.models.swapc import CostModel, PowerModel\n15\tfrom phased_array_systems.requirements import RequirementSet, VerificationReport\n16\tfrom phased_array_systems.scenarios import CommsLinkScenario, RadarDetectionScenario\n17\tfrom phased_array_systems.types import MetricsDict, Scenario\n18\t\n19\tif TYPE_CHECKING:\n20\t    from phased_array_systems.io.schema import StudyConfig\n21\t\n22\t\n23\tdef evaluate_case(\n24\t    arch: Architecture,\n25\t    scenario: Scenario,\n26\t    requirements: RequirementSet | None = None,\n27\t    case_id: str | None = None,\n28\t    seed: int | None = None,\n29\t) -> MetricsDict:\n30\t    \"\"\"Evaluate a single architecture/scenario case.\n31\t\n32\t    Runs all applicable models and returns merged metrics dictionary.\n33\t    Optionally verifies against requirements and includes verification results.\n34\t\n35\t    Args:\n36\t        arch: Architecture configuration\n37\t        scenario: Scenario configuration (CommsLinkScenario or RadarDetectionScenario)\n38\t        requirements: Optional requirement set for verification\n39\t        case_id: Optional case identifier for tracking\n40\t        seed: Optional RNG seed threaded to stochastic sub-models (element\n41\t            failure simulation); recorded as meta.seed\n42\t\n43\t    Returns:\n44\t        Dictionary containing all computed metrics plus metadata:\n45\t            - All antenna metrics (g_peak_db, beamwidth_*, sll_db, etc.)\n46\t            - All link/radar metrics (eirp_dbw, snr_*, margin_*, etc.)\n47\t            - All SWaP-C metrics (power_*, cost_*)\n48\t            - Verification results if requirements provided\n49\t            - Metadata (case_id, runtime_s, seed, versions)\n50\t    \"\"\"\n51\t    start_time = time.perf_counter()\n52\t    metrics: MetricsDict = {}\n53\t\n54\t    # Add case ID if provided\n55\t    if case_id is not None:\n56\t        metrics[\"meta.case_id\"] = case_id\n57\t\n58\t    # Initialize models\n59\t    antenna_model = PhasedArrayAdapter(use_analytical_fallback=True)\n60\t    power_model = PowerModel()\n61\t    cost_model = CostModel()\n62\t\n63\t    # Evaluate antenna model first (provides gain for link budget)\n64\t    antenna_context: dict[str, Any] = {}\n65\t    if seed is not None:\n66\t        antenna_context[\"meta.seed\"] = seed\n67\t    antenna_metrics = antenna_model.evaluate(arch, scenario, antenna_context)\n68\t    metrics.update(antenna_metrics)\n69\t\n70\t    # Create context with antenna results for downstream models\n71\t    context: dict[str, Any] = dict(antenna_metrics)\n72\t\n73\t    # Evaluate SWaP-C models\n74\t    power_metrics = power_model.evaluate(arch, scenario, context)\n75\t    metrics.update(power_metrics)\n76\t\n77\t    cost_metrics = cost_model.evaluate(arch, scenario, context)\n78\t    metrics.update(cost_metrics)\n79\t\n80\t    # RF cascade analysis (if rx_stages configured)\n81\t    if arch.rf.rx_stages:\n82\t        from phased_array_systems.models.rf.cascade import RFStage, cascade_analysis\n83\t\n84\t        stages = [\n85\t            RFStage(\n86\t                name=str(s.get(\"name\", f\"stage_{i}\")),\n87\t                gain_db=float(s[\"gain_db\"]),\n88\t                noise_figure_db=float(s[\"nf_db\"]),\n89\t                iip3_dbm=float(s.get(\"iip3_dbm\", 100.0)),\n90\t                p1db_dbm=float(s.get(\"p1db_dbm\", 100.0)),\n91\t            )\n92\t            for i, s in enumerate(arch.rf.rx_stages)\n93\t        ]\n94\t        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n95\t        cascade_metrics: dict[str, Any] = cascade_analysis(stages, bandwidth_hz=bw)\n96\t        metrics.update(\n97\t            {\n98\t                \"cascade_nf_db\": float(cascade_metrics[\"total_nf_db\"]),\n99\t                \"cascade_gain_db\": float(cascade_metrics[\"total_gain_db\"]),\n100\t                \"cascade_iip3_dbm\": float(cascade_metrics[\"iip3_dbm\"]),\n101\t                \"cascade_oip3_dbm\": float(cascade_metrics[\"oip3_dbm\"]),\n102\t                \"cascade_mds_dbm\": float(cascade_metrics[\"mds_dbm\"]),\n103\t                \"cascade_sfdr_db\": float(cascade_metrics[\"sfdr_db\"]),\n104\t            }\n105\t        )\n106\t        # Override NF in context so link budget uses cascaded value\n107\t        context[\"cascade_nf_db\"] = cascade_metrics[\"total_nf_db\"]\n108\t        # Expose IIP3 so the link budget can fold IM3 into an SNDR when the\n109\t        # scenario enables nonlinear impairments\n110\t        context[\"cascade_iip3_dbm\"] = float(cascade_metrics[\"iip3_dbm\"])\n111\t\n112\t    # TX cascade analysis (if tx_stages configured): gain, composite P1dB, and\n113\t    # a per-stage compression check at the commanded per-element drive level\n114\t    if arch.rf.tx_stages:\n115\t        from phased_array_systems.models.rf.cascade import (\n116\t            RFStage,\n117\t            cascade_analysis,\n118\t            compression_check,\n119\t        )\n120\t\n121\t        tx_rf_stages = [\n122\t            RFStage(\n123\t                name=str(s.get(\"name\", f\"tx_stage_{i}\")),\n124\t                gain_db=float(s[\"gain_db\"]),\n125\t                noise_figure_db=float(s[\"nf_db\"]),\n126\t                iip3_dbm=float(s.get(\"iip3_dbm\", 100.0)),\n127\t                p1db_dbm=float(s.get(\"p1db_dbm\", 100.0)),\n128\t            )\n129\t            for i, s in enumerate(arch.rf.tx_stages)\n130\t        ]\n131\t        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n132\t        tx_cascade: dict[str, Any] = cascade_analysis(tx_rf_stages, bandwidth_hz=bw)\n133\t        # Drive level into the TX chain: the commanded per-element power\n134\t        # referred to the chain input (subtract the cascade gain), minus any\n135\t        # scenario backoff\n136\t        tx_out_dbm = 10.0 * math.log10(arch.rf.tx_power_w_per_elem * 1e3)\n137\t        tx_out_dbm -= getattr(scenario, \"tx_backoff_db\", 0.0)\n138\t        tx_in_dbm = tx_out_dbm - float(tx_cascade[\"total_gain_db\"])\n139\t        tx_comp = compression_check(tx_rf_stages, tx_in_dbm)\n140\t        tx_min_headroom = tx_comp[\"min_headroom_db\"]\n141\t        assert isinstance(tx_min_headroom, float)\n142\t        metrics.update(\n143\t            {\n144\t                \"tx_cascade_gain_db\": float(tx_cascade[\"total_gain_db\"]),\n145\t                \"tx_cascade_op1db_dbm\": float(tx_cascade[\"op1db_dbm\"]),\n146\t                \"tx_cascade_ip1db_dbm\": float(tx_cascade[\"ip1db_dbm\"]),\n147\t                \"tx_min_p1db_headroom_db\": tx_min_headroom,\n148\t                \"tx_p1db_binding_stage\": str(tx_comp[\"binding_stage\"]),\n149\t                \"tx_compressed\": bool(tx_comp[\"compressed\"]),\n150\t            }\n151\t        )\n152\t\n153\t    # Reliability analysis (if configured)\n154\t    if arch.reliability is not None:\n155\t        from phased_array_systems.models.rf.reliability import (\n156\t            TRMReliabilitySpec,\n157\t            analyze_array_reliability,\n158\t        )\n159\t\n160\t        # Feed-forward thermal coupling: when a thermal resistance is\n161\t        # given, estimate the TRM junction temperature from the dissipated\n162\t        # heat the power model already computed (heat = DC in - RF out),\n163\t        # so array size, TX power, and duty cycle drive Arrhenius derating\n164\t        operating_temp_c = arch.reliability.operating_temp_c\n165\t        if arch.reliability.thermal_resistance_c_per_w is not None:\n166\t            dc_w = metrics.get(\"dc_power_w\", 0.0)\n167\t            rf_avg_w = metrics.get(\"rf_avg_power_w\", 0.0)\n168\t            dc_w = float(dc_w) if isinstance(dc_w, (int, float)) else 0.0\n169\t            rf_avg_w = float(rf_avg_w) if isinstance(rf_avg_w, (int, float)) else 0.0\n170\t            heat_per_elem_w = max(0.0, dc_w - rf_avg_w) / arch.array.n_elements\n171\t            operating_temp_c = (\n172\t                arch.reliability.ambient_temp_c\n173\t                + arch.reliability.thermal_resistance_c_per_w * heat_per_elem_w\n174\t            )\n175\t            metrics[\"junction_temp_c\"] = operating_temp_c\n176\t\n177\t        spec = TRMReliabilitySpec(\n178\t            component_mtbfs=arch.reliability.component_mtbfs,\n179\t            operating_temp_c=operating_temp_c,\n180\t            mttr_hours=arch.reliability.mttr_hours,\n181\t            mission_hours=arch.reliability.mission_hours,\n182\t        )\n183\t        sll_val = metrics.get(\"sll_db\", -30.0)\n184\t        original_sll = float(sll_val) if isinstance(sll_val, (int, float)) else -30.0\n185\t        result = analyze_array_reliability(\n186\t            arch.array.n_elements,\n187\t            spec,\n188\t            original_sll_db=original_sll,\n189\t        )\n190\t        metrics.update(\n191\t            {\n192\t                \"trm_mtbf_hours\": result.trm_mtbf_hours,\n193\t                \"array_mtbf_hours\": result.array_mtbf_hours,\n194\t                \"expected_failed_elements\": result.expected_failures,\n195\t                \"array_availability\": result.availability,\n196\t                \"max_failures_for_spec\": float(result.max_failures_for_spec),\n197\t                \"prob_meeting_spec\": result.prob_meeting_spec,\n198\t            }\n199\t        )\n200\t\n201\t    # Digital beamformer analysis (if configured)\n202\t    if arch.digital is not None:\n203\t        from phased_array_systems.models.digital.bandwidth import (\n204\t            beamformer_operations,\n205\t            digital_beamformer_data_rate,\n206\t            processing_margin,\n207\t        )\n208\t        from phased_array_systems.models.digital.converters import adc_effective_snr\n209\t\n210\t        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n211\t        sample_rate = bw * arch.digital.oversampling_ratio\n212\t        # Physical bit width sizes the data stream, not ENOB (a 12-bit\n213\t        # converter with 10.5 effective bits still moves 12-bit words)\n214\t        bits_per_sample = arch.digital.adc_bits_physical * 2  # I + Q\n215\t\n216\t        # Digitized channel count follows the digitization level\n217\t        # (element / subarray / analog), not the raw element count\n218\t        n_channels = arch.n_digital_channels\n219\t\n220\t        # ADC metrics (quantization + aperture jitter)\n221\t        jitter_s = (\n222\t            arch.digital.adc_jitter_ps_rms * 1e-12\n223\t            if arch.digital.adc_jitter_ps_rms is not None\n224\t            else None\n225\t        )\n226\t        adc = adc_effective_snr(\n227\t            arch.digital.adc_enob,\n228\t            sample_rate,\n229\t            input_freq_hz=arch.digital.adc_input_freq_hz,\n230\t            jitter_s_rms=jitter_s,\n231\t        )\n232\t        metrics[\"adc_enob\"] = arch.digital.adc_enob\n233\t        metrics[\"adc_enob_effective\"] = adc[\"enob_effective\"]\n234\t        metrics[\"adc_snr_db\"] = adc[\"snr_total_db\"]\n235\t        metrics[\"adc_sample_rate_hz\"] = sample_rate\n236\t        metrics[\"n_digital_channels\"] = float(n_channels)\n237\t\n238\t        # Combining N digitized channels adds 10*log10(N) processing gain\n239\t        # to the system dynamic range\n240\t        metrics[\"dynamic_range_system_db\"] = adc[\"snr_total_db\"] + 10 * math.log10(n_channels)\n241\t\n242\t        # Beamformer data rate\n243\t        bf_rate = digital_beamformer_data_rate(\n244\t            n_channels,\n245\t            sample_rate,\n246\t            bits_per_sample,\n247\t        )\n248\t        metrics[\"bf_data_rate_gbps\"] = bf_rate[\"with_overhead_gbps\"]\n249\t\n250\t        # Beamformer compute\n251\t        bf_ops = beamformer_operations(\n252\t            n_channels,\n253\t            arch.digital.n_beams,\n254\t            sample_rate,\n255\t        )\n256\t        metrics[\"bf_compute_gops\"] = bf_ops[\"total_gops\"]\n257\t\n258\t        # Processing margin (if FPGA throughput specified)\n259\t        if arch.digital.fpga_throughput_gops is not None:\n260\t            pm = processing_margin(arch.digital.fpga_throughput_gops, bf_ops[\"total_gops\"])\n261\t            metrics[\"processing_margin_db\"] = pm[\"margin_db\"]\n262\t            metrics[\"fpga_utilization_pct\"] = pm[\"utilization_percent\"]\n263\t\n264\t        # TX digital path (if a DAC is configured)\n265\t        if arch.digital.dac_enob is not None:\n266\t            from phased_array_systems.models.digital.converters import dac_output_power\n267\t\n268\t            dac = dac_output_power(\n269\t                arch.digital.dac_enob,\n270\t                arch.digital.dac_full_scale_dbm,\n271\t                backoff_db=arch.digital.dac_backoff_db,\n272\t            )\n273\t            metrics[\"dac_operating_power_dbm\"] = dac[\"operating_power_dbm\"]\n274\t            metrics[\"dac_snr_db\"] = dac[\"snr_db\"]\n275\t            metrics[\"dac_sfdr_db\"] = dac[\"sfdr_db\"]\n276\t            # TX stream mirrors the RX one at the same digitization level\n277\t            dac_bits = arch.digital.dac_bits_physical\n278\t            assert dac_bits is not None\n279\t            tx_rate = digital_beamformer_data_rate(\n280\t                n_channels,\n281\t                sample_rate,\n282\t                dac_bits * 2,  # I + Q\n283\t            )\n284\t            metrics[\"tx_bf_data_rate_gbps\"] = tx_rate[\"with_overhead_gbps\"]\n285\t\n286\t    # Evaluate scenario-specific models\n287\t    if isinstance(scenario, CommsLinkScenario):\n288\t        comms_model = CommsLinkModel()\n289\t        comms_metrics = comms_model.evaluate(arch, scenario, context)\n290\t        metrics.update(comms_metrics)\n291\t    elif isinstance(scenario, RadarDetectionScenario):\n292\t        radar_model = RadarModel()\n293\t        radar_metrics = radar_model.evaluate(arch, scenario, context)\n294\t        metrics.update(radar_metrics)\n295\t\n296\t        # Search timeline (if PRF and search extents configured): connects\n297\t        # the antenna beamwidths and dwell time to volume revisit rate\n298\t        if (\n299\t            scenario.prf_hz is not None\n300\t            and scenario.search_az_extent_deg is not None\n301\t            and scenario.search_el_extent_deg is not None\n302\t        ):\n303\t            from phased_array_systems.models.digital.scheduling import max_update_rate\n304\t\n305\t            dwell_time_s = scenario.n_pulses / scenario.prf_hz\n306\t\n307\t            bw_az = metrics.get(\"beamwidth_az_deg\", 5.0)\n308\t            bw_el = metrics.get(\"beamwidth_el_deg\", 5.0)\n309\t            bw_az = float(bw_az) if isinstance(bw_az, (int, float)) else 5.0\n310\t            bw_el = float(bw_el) if isinstance(bw_el, (int, float)) else 5.0\n311\t            beam_solid_angle_sr = math.radians(bw_az) * math.radians(bw_el)\n312\t            scan_volume_sr = math.radians(scenario.search_az_extent_deg) * math.radians(\n313\t                scenario.search_el_extent_deg\n314\t            )\n315\t\n316\t            timeline = max_update_rate(\n317\t                scan_volume_sr=scan_volume_sr,\n318\t                beam_solid_angle_sr=beam_solid_angle_sr,\n319\t                dwell_time_us=dwell_time_s * 1e6,\n320\t                overhead_us=scenario.beam_overhead_us,\n321\t            )\n322\t            metrics[\"dwell_time_ms\"] = dwell_time_s * 1e3\n323\t            metrics[\"n_beam_positions\"] = timeline[\"n_beam_positions\"]\n324\t            metrics[\"search_frame_time_s\"] = timeline[\"scan_time_s\"]\n325\t            metrics[\"search_update_rate_hz\"] = timeline[\"update_rate_hz\"]\n326\t            # Occupancy vs an allotted frame budget: > 1 means the search\n327\t            # task is oversubscribed (natural must-requirement metric)\n328\t            if scenario.search_frame_time_ms is not None:\n329\t                metrics[\"timeline_occupancy\"] = timeline[\"frame_time_ms\"] / (\n330\t                    scenario.search_frame_time_ms\n331\t                )\n332\t\n333\t    # Verify requirements if provided\n334\t    if requirements is not None and len(requirements) > 0:\n335\t        report = requirements.verify(metrics)\n336\t        metrics[\"verification.passes\"] = 1.0 if report.passes else 0.0\n337\t        metrics[\"verification.must_pass_count\"] = float(report.must_pass_count)\n338\t        metrics[\"verification.must_total_count\"] = float(report.must_total_count)\n339\t        metrics[\"verification.failed_ids\"] = (\n340\t            \",\".join(report.failed_ids) if report.failed_ids else \"\"\n341\t        )\n342\t\n343\t    # Add timing and provenance metadata\n344\t    elapsed = time.perf_counter() - start_time\n345\t    metrics[\"meta.runtime_s\"] = elapsed\n346\t    if seed is not None:\n347\t        metrics[\"meta.seed\"] = seed\n348\t    metrics[\"meta.package_version\"] = __version__\n349\t    metrics[\"meta.pam_version\"] = _pam_version()\n350\t\n351\t    return metrics\n352\t\n353\t\n354\tdef _pam_version() -> str:\n355\t    \"\"\"Version of the phased_array backend, or 'analytical' if absent.\"\"\"\n356\t    from phased_array_systems.models.antenna.adapter import HAS_PAM\n357\t\n358\t    if not HAS_PAM:\n359\t        return \"analytical\"\n360\t    try:\n361\t        import phased_array\n362\t\n363\t        return str(getattr(phased_array, \"__version__\", \"unknown\"))\n364\t    except ImportError:  # pragma: no cover\n365\t        return \"analytical\"\n366\t\n367\t\n368\tdef evaluate_case_with_report(\n369\t    arch: Architecture,\n370\t    scenario: Scenario,\n371\t    requirements: RequirementSet,\n372\t    case_id: str | None = None,\n373\t) -> tuple[MetricsDict, VerificationReport]:\n374\t    \"\"\"Evaluate a case and return both metrics and full verification report.\n375\t\n376\t    Args:\n377\t        arch: Architecture configuration\n378\t        scenario: Scenario configuration\n379\t        requirements: Requirement set for verification\n380\t        case_id: Optional case identifier\n381\t\n382\t    Returns:\n383\t        Tuple of (metrics dict, VerificationReport)\n384\t    \"\"\"\n385\t    metrics = evaluate_case(arch, scenario, requirements, case_id)\n386\t    report = requirements.verify(metrics)\n387\t    return metrics, report\n388\t\n389\t\n390\tdef evaluate_config(config: StudyConfig) -> MetricsDict:\n391\t    \"\"\"Evaluate a case from a StudyConfig object.\n392\t\n393\t    Convenience function for config-driven evaluation.\n394\t\n395\t    Args:\n396\t        config: StudyConfig object with architecture, scenario, requirements\n397\t\n398\t    Returns:\n399\t        Metrics dictionary\n400\t    \"\"\"\n401\t\n402\t    arch = config.get_architecture()\n403\t    scenario = config.get_scenario()\n404\t    requirements = config.get_requirement_set()\n405\t\n406\t    if scenario is None:\n407\t        raise ValueError(\"StudyConfig must have a scenario defined\")\n408\t\n409\t    return evaluate_case(arch, scenario, requirements, case_id=config.name)\n410\t"}]},"parent_tool_use_id":null,"session_id":"d1e7bba5-0d68-428f-b37c-4aacd82fd2c6","uuid":"4e3a7d2e-3226-4149-8623-07e79948986a","timestamp":"2026-08-12T21:24:36.243Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/johnhodge/Documents/code/phased-array-systems/src/phased_array_systems/evaluate.py","content":"\"\"\"Single-case evaluation orchestrator.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport time\nfrom typing import TYPE_CHECKING, Any\n\nfrom phased_array_systems.__about__ import __version__\nfrom phased_array_systems.architecture import Architecture\nfrom phased_array_systems.models.antenna import PhasedArrayAdapter\nfrom phased_array_systems.models.comms import CommsLinkModel\nfrom phased_array_systems.models.radar import RadarModel\nfrom phased_array_systems.models.swapc import CostModel, PowerModel\nfrom phased_array_systems.requirements import RequirementSet, VerificationReport\nfrom phased_array_systems.scenarios import CommsLinkScenario, RadarDetectionScenario\nfrom phased_array_systems.types import MetricsDict, Scenario\n\nif TYPE_CHECKING:\n    from phased_array_systems.io.schema import StudyConfig\n\n\ndef evaluate_case(\n    arch: Architecture,\n    scenario: Scenario,\n    requirements: RequirementSet | None = None,\n    case_id: str | None = None,\n    seed: int | None = None,\n) -> MetricsDict:\n    \"\"\"Evaluate a single architecture/scenario case.\n\n    Runs all applicable models and returns merged metrics dictionary.\n    Optionally verifies against requirements and includes verification results.\n\n    Args:\n        arch: Architecture configuration\n        scenario: Scenario configuration (CommsLinkScenario or RadarDetectionScenario)\n        requirements: Optional requirement set for verification\n        case_id: Optional case identifier for tracking\n        seed: Optional RNG seed threaded to stochastic sub-models (element\n            failure simulation); recorded as meta.seed\n\n    Returns:\n        Dictionary containing all computed metrics plus metadata:\n            - All antenna metrics (g_peak_db, beamwidth_*, sll_db, etc.)\n            - All link/radar metrics (eirp_dbw, snr_*, margin_*, etc.)\n            - All SWaP-C metrics (power_*, cost_*)\n            - Verification results if requirements provided\n            - Metadata (case_id, runtime_s, seed, versions)\n    \"\"\"\n    start_time = time.perf_counter()\n    metrics: MetricsDict = {}\n\n    # Add case ID if provided\n    if case_id is not None:\n        metrics[\"meta.case_id\"] = case_id\n\n    # Initialize models\n    antenna_model = PhasedArrayAdapter(use_analytical_fallback=True)\n    power_model = PowerModel()\n    cost_model = CostModel()\n\n    # Evaluate antenna model first (provides gain for link budget)\n    antenna_context: dict[str, Any] = {}\n    if seed is not None:\n        antenna_context[\"meta.seed\"] = seed\n    antenna_metrics = antenna_model.evaluate(arch, scenario, antenna_context)\n    metrics.update(antenna_metrics)\n\n    # Create context with antenna results for downstream models\n    context: dict[str, Any] = dict(antenna_metrics)\n\n    # Evaluate SWaP-C models\n    power_metrics = power_model.evaluate(arch, scenario, context)\n    metrics.update(power_metrics)\n\n    cost_metrics = cost_model.evaluate(arch, scenario, context)\n    metrics.update(cost_metrics)\n\n    # RF cascade analysis (if rx_stages configured)\n    if arch.rf.rx_stages:\n        from phased_array_systems.models.rf.cascade import RFStage, cascade_analysis\n\n        stages = [\n            RFStage(\n                name=str(s.get(\"name\", f\"stage_{i}\")),\n                gain_db=float(s[\"gain_db\"]),\n                noise_figure_db=float(s[\"nf_db\"]),\n                iip3_dbm=float(s.get(\"iip3_dbm\", 100.0)),\n                p1db_dbm=float(s.get(\"p1db_dbm\", 100.0)),\n            )\n            for i, s in enumerate(arch.rf.rx_stages)\n        ]\n        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n        cascade_metrics: dict[str, Any] = cascade_analysis(stages, bandwidth_hz=bw)\n        metrics.update(\n            {\n                \"cascade_nf_db\": float(cascade_metrics[\"total_nf_db\"]),\n                \"cascade_gain_db\": float(cascade_metrics[\"total_gain_db\"]),\n                \"cascade_iip3_dbm\": float(cascade_metrics[\"iip3_dbm\"]),\n                \"cascade_oip3_dbm\": float(cascade_metrics[\"oip3_dbm\"]),\n                \"cascade_mds_dbm\": float(cascade_metrics[\"mds_dbm\"]),\n                \"cascade_sfdr_db\": float(cascade_metrics[\"sfdr_db\"]),\n            }\n        )\n        # Override NF in context so link budget uses cascaded value\n        context[\"cascade_nf_db\"] = cascade_metrics[\"total_nf_db\"]\n        # Expose IIP3 so the link budget can fold IM3 into an SNDR when the\n        # scenario enables nonlinear impairments\n        context[\"cascade_iip3_dbm\"] = float(cascade_metrics[\"iip3_dbm\"])\n\n    # TX cascade analysis (if tx_stages configured): gain, composite P1dB, and\n    # a per-stage compression check at the commanded per-element drive level\n    if arch.rf.tx_stages:\n        from phased_array_systems.models.rf.cascade import (\n            RFStage,\n            cascade_analysis,\n            compression_check,\n        )\n\n        tx_rf_stages = [\n            RFStage(\n                name=str(s.get(\"name\", f\"tx_stage_{i}\")),\n                gain_db=float(s[\"gain_db\"]),\n                noise_figure_db=float(s[\"nf_db\"]),\n                iip3_dbm=float(s.get(\"iip3_dbm\", 100.0)),\n                p1db_dbm=float(s.get(\"p1db_dbm\", 100.0)),\n            )\n            for i, s in enumerate(arch.rf.tx_stages)\n        ]\n        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n        tx_cascade: dict[str, Any] = cascade_analysis(tx_rf_stages, bandwidth_hz=bw)\n        # Drive level into the TX chain: the commanded per-element power\n        # referred to the chain input (subtract the cascade gain), minus any\n        # scenario backoff\n        tx_out_dbm = 10.0 * math.log10(arch.rf.tx_power_w_per_elem * 1e3)\n        tx_out_dbm -= getattr(scenario, \"tx_backoff_db\", 0.0)\n        tx_in_dbm = tx_out_dbm - float(tx_cascade[\"total_gain_db\"])\n        tx_comp = compression_check(tx_rf_stages, tx_in_dbm)\n        tx_min_headroom = tx_comp[\"min_headroom_db\"]\n        assert isinstance(tx_min_headroom, float)\n        metrics.update(\n            {\n                \"tx_cascade_gain_db\": float(tx_cascade[\"total_gain_db\"]),\n                \"tx_cascade_op1db_dbm\": float(tx_cascade[\"op1db_dbm\"]),\n                \"tx_cascade_ip1db_dbm\": float(tx_cascade[\"ip1db_dbm\"]),\n                \"tx_min_p1db_headroom_db\": tx_min_headroom,\n                \"tx_p1db_binding_stage\": str(tx_comp[\"binding_stage\"]),\n                \"tx_compressed\": bool(tx_comp[\"compressed\"]),\n            }\n        )\n\n    # Reliability analysis (if configured)\n    if arch.reliability is not None:\n        from phased_array_systems.models.rf.reliability import (\n            TRMReliabilitySpec,\n            analyze_array_reliability,\n        )\n\n        # Feed-forward thermal coupling: when a thermal resistance is\n        # given, estimate the TRM junction temperature from the dissipated\n        # heat the power model already computed (heat = DC in - RF out),\n        # so array size, TX power, and duty cycle drive Arrhenius derating\n        operating_temp_c = arch.reliability.operating_temp_c\n        if arch.reliability.thermal_resistance_c_per_w is not None:\n            dc_w = metrics.get(\"dc_power_w\", 0.0)\n            rf_avg_w = metrics.get(\"rf_avg_power_w\", 0.0)\n            dc_w = float(dc_w) if isinstance(dc_w, (int, float)) else 0.0\n            rf_avg_w = float(rf_avg_w) if isinstance(rf_avg_w, (int, float)) else 0.0\n            heat_per_elem_w = max(0.0, dc_w - rf_avg_w) / arch.array.n_elements\n            operating_temp_c = (\n                arch.reliability.ambient_temp_c\n                + arch.reliability.thermal_resistance_c_per_w * heat_per_elem_w\n            )\n            metrics[\"junction_temp_c\"] = operating_temp_c\n\n        spec = TRMReliabilitySpec(\n            component_mtbfs=arch.reliability.component_mtbfs,\n            operating_temp_c=operating_temp_c,\n            mttr_hours=arch.reliability.mttr_hours,\n            mission_hours=arch.reliability.mission_hours,\n        )\n        sll_val = metrics.get(\"sll_db\", -30.0)\n        original_sll = float(sll_val) if isinstance(sll_val, (int, float)) else -30.0\n        result = analyze_array_reliability(\n            arch.array.n_elements,\n            spec,\n            original_sll_db=original_sll,\n        )\n        metrics.update(\n            {\n                \"trm_mtbf_hours\": result.trm_mtbf_hours,\n                \"array_mtbf_hours\": result.array_mtbf_hours,\n                \"expected_failed_elements\": result.expected_failures,\n                \"array_availability\": result.availability,\n                \"max_failures_for_spec\": float(result.max_failures_for_spec),\n                \"prob_meeting_spec\": result.prob_meeting_spec,\n            }\n        )\n\n    # Digital beamformer analysis (if configured)\n    if arch.digital is not None:\n        from phased_array_systems.models.digital.bandwidth import (\n            beamformer_operations,\n            digital_beamformer_data_rate,\n            processing_margin,\n        )\n        from phased_array_systems.models.digital.converters import adc_effective_snr\n\n        bw = getattr(scenario, \"bandwidth_hz\", 1e6)\n        sample_rate = bw * arch.digital.oversampling_ratio\n        # Physical bit width sizes the data stream, not ENOB (a 12-bit\n        # converter with 10.5 effective bits still moves 12-bit words)\n        bits_per_sample = arch.digital.adc_bits_physical * 2  # I + Q\n\n        # Digitized channel count follows the digitization level\n        # (element / subarray / analog), not the raw element count\n        n_channels = arch.n_digital_channels\n\n        # ADC metrics (quantization + aperture jitter)\n        jitter_s = (\n            arch.digital.adc_jitter_ps_rms * 1e-12\n            if arch.digital.adc_jitter_ps_rms is not None\n            else None\n        )\n        adc = adc_effective_snr(\n            arch.digital.adc_enob,\n            sample_rate,\n            input_freq_hz=arch.digital.adc_input_freq_hz,\n            jitter_s_rms=jitter_s,\n        )\n        metrics[\"adc_enob\"] = arch.digital.adc_enob\n        metrics[\"adc_enob_effective\"] = adc[\"enob_effective\"]\n        metrics[\"adc_snr_db\"] = adc[\"snr_total_db\"]\n        metrics[\"adc_sample_rate_hz\"] = sample_rate\n        metrics[\"n_digital_channels\"] = float(n_channels)\n\n        # Combining N digitized channels adds 10*log10(N) processing gain\n        # to the system dynamic range\n        metrics[\"dynamic_range_system_db\"] = adc[\"snr_total_db\"] + 10 * math.log10(n_channels)\n\n        # Beamformer data rate\n        bf_rate = digital_beamformer_data_rate(\n            n_channels,\n            sample_rate,\n            bits_per_sample,\n        )\n        metrics[\"bf_data_rate_gbps\"] = bf_rate[\"with_overhead_gbps\"]\n\n        # Beamformer compute\n        bf_ops = beamformer_operations(\n            n_channels,\n            arch.digital.n_beams,\n            sample_rate,\n        )\n        metrics[\"bf_compute_gops\"] = bf_ops[\"total_gops\"]\n\n        # Processing margin (if FPGA throughput specified)\n        if arch.digital.fpga_throughput_gops is not None:\n            pm = processing_margin(arch.digital.fpga_throughput_gops, bf_ops[\"total_gops\"])\n            metrics[\"processing_margin_db\"] = pm[\"margin_db\"]\n            metrics[\"fpga_utilization_pct\"] = pm[\"utilization_percent\"]\n\n        # TX digital path (if a DAC is configured)\n        if arch.digital.dac_enob is not None:\n            from phased_array_systems.models.digital.converters import dac_output_power\n\n            dac = dac_output_power(\n                arch.digital.dac_enob,\n                arch.digital.dac_full_scale_dbm,\n                backoff_db=arch.digital.dac_backoff_db,\n            )\n            metrics[\"dac_operating_power_dbm\"] = dac[\"operating_power_dbm\"]\n            metrics[\"dac_snr_db\"] = dac[\"snr_db\"]\n            metrics[\"dac_sfdr_db\"] = dac[\"sfdr_db\"]\n            # TX stream mirrors the RX one at the same digitization level\n            dac_bits = arch.digital.dac_bits_physical\n            assert dac_bits is not None\n            tx_rate = digital_beamformer_data_rate(\n                n_channels,\n                sample_rate,\n                dac_bits * 2,  # I + Q\n            )\n            metrics[\"tx_bf_data_rate_gbps\"] = tx_rate[\"with_overhead_gbps\"]\n\n    # Evaluate scenario-specific models\n    if isinstance(scenario, CommsLinkScenario):\n        comms_model = CommsLinkModel()\n        comms_metrics = comms_model.evaluate(arch, scenario, context)\n        metrics.update(comms_metrics)\n    elif isinstance(scenario, RadarDetectionScenario):\n        radar_model = RadarModel()\n        radar_metrics = radar_model.evaluate(arch, scenario, context)\n        metrics.update(radar_metrics)\n\n        # Search timeline (if PRF and search extents configured): connects\n        # the antenna beamwidths and dwell time to volume revisit rate\n        if (\n            scenario.prf_hz is not None\n            and scenario.search_az_extent_deg is not None\n            and scenario.search_el_extent_deg is not None\n        ):\n            from phased_array_systems.models.digital.scheduling import max_update_rate\n\n            dwell_time_s = scenario.n_pulses / scenario.prf_hz\n\n            bw_az = metrics.get(\"beamwidth_az_deg\", 5.0)\n            bw_el = metrics.get(\"beamwidth_el_deg\", 5.0)\n            bw_az = float(bw_az) if isinstance(bw_az, (int, float)) else 5.0\n            bw_el = float(bw_el) if isinstance(bw_el, (int, float)) else 5.0\n            beam_solid_angle_sr = math.radians(bw_az) * math.radians(bw_el)\n            scan_volume_sr = math.radians(scenario.search_az_extent_deg) * math.radians(\n                scenario.search_el_extent_deg\n            )\n\n            timeline = max_update_rate(\n                scan_volume_sr=scan_volume_sr,\n                beam_solid_angle_sr=beam_solid_angle_sr,\n                dwell_time_us=dwell_time_s * 1e6,\n                overhead_us=scenario.beam_overhead_us,\n            )\n            metrics[\"dwell_time_ms\"] = dwell_time_s * 1e3\n            metrics[\"n_beam_positions\"] = timeline[\"n_beam_positions\"]\n            metrics[\"search_frame_time_s\"] = timeline[\"scan_time_s\"]\n            metrics[\"search_update_rate_hz\"] = timeline[\"update_rate_hz\"]\n            # Occupancy vs an allotted frame budget: > 1 means the search\n            # task is oversubscribed (natural must-requirement metric)\n            if scenario.search_frame_time_ms is not None:\n                metrics[\"timeline_occupancy\"] = timeline[\"frame_time_ms\"] / (\n                    scenario.search_frame_time_ms\n                )\n\n    # Verify requirements if provided\n    if requirements is not None and len(requirements) > 0:\n        report = requirements.verify(metrics)\n        metrics[\"verification.passes\"] = 1.0 if report.passes else 0.0\n        metrics[\"verification.must_pass_count\"] = float(report.must_pass_count)\n        metrics[\"verification.must_total_count\"] = float(report.must_total_count)\n        metrics[\"verification.failed_ids\"] = (\n            \",\".join(report.failed_ids) if report.failed_ids else \"\"\n        )\n\n    # Add timing and provenance metadata\n    elapsed = time.perf_counter() - start_time\n    metrics[\"meta.runtime_s\"] = elapsed\n    if seed is not None:\n        metrics[\"meta.seed\"] = seed\n    metrics[\"meta.package_version\"] = __version__\n    metrics[\"meta.pam_version\"] = _pam_version()\n\n    return metrics\n\n\ndef _pam_version() -> str:\n    \"\"\"Version of the phased_array backend, or 'analytical' if absent.\"\"\"\n    from phased_array_systems.models.antenna.adapter import HAS_PAM\n\n    if not HAS_PAM:\n        return \"analytical\"\n    try:\n        import phased_array\n\n        return str(getattr(phased_array, \"__version__\", \"unknown\"))\n    except ImportError:  # pragma: no cover\n        return \"analytical\"\n\n\ndef evaluate_case_with_report(\n    arch: Architecture,\n    scenario: Scenario,\n    requirements: RequirementSet,\n    case_id: str | None = None,\n) -> tuple[MetricsDict, VerificationReport]:\n    \"\"\"Evaluate a case and return both metrics and full verification report.\n\n    Args:\n        arch: Architecture configuration\n        scenario: Scenario configuration\n        requirements: Requirement set for verification\n        case_id: Optional case identifier\n\n    Returns:\n        Tuple of (metrics dict, VerificationReport)\n    \"\"\"\n    metrics = evaluate_case(arch, scenario, requirements, case_id)\n    report = requirements.verify(metrics)\n    return metrics, report\n\n\ndef evaluate_config(config: StudyConfig) -> MetricsDict:\n    \"\"\"Evaluate a case from a StudyConfig object.\n\n    Convenience function for config-driven evaluation.\n\n    Args:\n        config: StudyConfig object with architecture, scenario, requirements\n\n    Returns:\n        Metrics dictionary\n    \"\"\"\n\n    arch = config.get_architecture()\n    scenario = config.get_scenario()\n    requirements = config.get_requirement_set()\n\n    if scenario is None:\n        raise ValueError(\"StudyConfig must have a scenario defined\")\n\n    return evaluate_case(arch, scenario, requirements, case_id=config.name)\n","numLines":410,"startLine":1,"totalLines":410}}}
