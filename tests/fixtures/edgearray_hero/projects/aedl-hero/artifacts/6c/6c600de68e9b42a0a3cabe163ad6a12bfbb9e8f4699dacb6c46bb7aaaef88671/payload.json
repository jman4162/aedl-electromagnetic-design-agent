  "rules": [
    {
      "rule": "R1-band",
      "formula": "f0 = frequency; B = bandwidth; theta_max = maxScanAngle (model attributes)",
      "inputs": {
        "frequency_hz": "SatcomTerminal28GHz::terminal::array::frequency",
        "bandwidth_hz": "SatcomTerminal28GHz::terminal::array::bandwidth",
        "max_scan_deg": "SatcomTerminal28GHz::terminal::array::maxScanAngle"
      },
      "outputs": {
        "frequency_hz": 28000000000.0,
        "bandwidth_hz": 50000000.0,
        "max_scan_deg": 60.0
      }
    },
    {
      "rule": "R2-lattice",
      "formula": "dx = dy = 0.5 * lambda0",
      "inputs": {
        "wavelength_m": 0.0107068735
      },
      "outputs": {
        "dx_lambda": 0.5,
        "dy_lambda": 0.5
      }
    },
    {
      "rule": "R3-taper",
      "formula": "Taylor taper, design SLL -25 dB",
      "inputs": {},
      "outputs": {
        "taper": "taylor",
        "taper_sll_db": -25.0
      }
    },
    {
      "rule": "R4-geometry",
      "formula": "el = 90 - theta_max; R = sqrt((Re + h)^2 - (Re cos el)^2) - Re sin el",
      "inputs": {
        "max_scan_deg": 60.0,
        "orbit_altitude_m": 815000.0
      },
      "outputs": {
        "elevation_deg": 30.0,
        "range_m": 1418451.0477414937
      }
    },
    {
      "rule": "R5-element-count",
      "formula": "smallest n: margin(n^2) >= M_req + allowance and EIRP(n^2) >= EIRP_req; G = 10log10(N) + 10log10(4 pi dx dy / lambda^2) + 10log10(eta_taper) + q 10log10(cos theta_max); EIRP = 10log10(N P_elem) + G; margin = EIRP - 20log10(4 pi R / lambda) + G_rx - 10log10(k T_sys B) - SNR_req",
      "inputs": {
        "link_margin_target_db": 0.0,
        "eirp_target_dbw": null,
        "link_allowance_db": 3.0
      },
      "outputs": {
        "n_side": 9,
        "predicted_link_margin_db": 4.090845984285565,
        "predicted_eirp_dbw": 32.53258973063986,
        "taper_efficiency": 0.8195261226312259
      }
    },
    {
      "rule": "R6-tile",
      "formula": "n <= 8: n = 2^ceil(log2 n); n > 8: n = 8 * ceil(n / 8)",
      "inputs": {
        "n_side": 9,
        "subarray_n": 8
      },
      "outputs": {
        "nx": 16,
        "ny": 16
      }
    }
